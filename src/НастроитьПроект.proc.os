// Заводит проект сверки или меняет его параметры репозитория (для вызова без интерфейса).
Процедура Выполнить() Экспорт

	ИмяПроекта = СокрЛП(НастройкиПроекта.ТекстЗначения(Параметры.ИмяПроекта));
	Если Не ЗначениеЗаполнено(ИмяПроекта) Тогда
		ВызватьИсключение "Не задан проект сверки";
	КонецЕсли;
	СекретТокена = СокрЛП(НастройкиПроекта.ТекстЗначения(Параметры.СекретТокена));
	Если ЗначениеЗаполнено(СекретТокена) И Не СтрНачинаетсяС(СекретТокена, "file:") Тогда
		ВызватьИсключение "Токен задается ссылкой на секрет file:<путь>, а не значением";
	КонецЕсли;

	Проект = Справочники.ПроектыСверки.НайтиПоНаименованию(ИмяПроекта);
	Если Проект = Неопределено Тогда
		ПроектОбъект = Справочники.ПроектыСверки.Создать();
		ПроектОбъект.Наименование = ИмяПроекта;
	Иначе
		ПроектОбъект = Проект.ПолучитьОбъект();
	КонецЕсли;
	ПроектОбъект.АдресРепозитория = СокрЛП(НастройкиПроекта.ТекстЗначения(Параметры.АдресРепозитория));
	ПроектОбъект.Ветка = СокрЛП(НастройкиПроекта.ТекстЗначения(Параметры.Ветка));
	ПроектОбъект.КаталогВРепозитории = СокрЛП(НастройкиПроекта.ТекстЗначения(Параметры.КаталогВРепозитории));
	ПроектОбъект.СекретТокена = СекретТокена;
	ПроектОбъект.Синхронизировать = (Параметры.Синхронизировать = Истина);
	ПроектОбъект.Записать();
	Сообщить("Проект " + ИмяПроекта + " записан");

КонецПроцедуры
