// Сравнение с признаком «все ключи», разбор пояснений, подстановка периода и фрагмент запроса SQL.
// Сеть не нужна: выборки собираются здесь же, фрагмент SQL только строится.
Процедура Выполнить()

	ПроверитьВсеКлючи();
	ПроверитьПояснения();
	ПроверитьПакет();
	ПроверитьПериодSQL();
	ПроверитьФрагментSQL();

КонецПроцедуры

Функция СтрокаВыборки(Счет, Сумма)

	Результат = Новый Соответствие;
	Результат.Вставить("Счет", Счет);
	Результат.Вставить("Сумма", Сумма);

	Возврат Результат;

КонецФункции

Процедура ПроверитьВсеКлючи()

	СтрокиА = Новый Массив;
	СтрокиА.Добавить(СтрокаВыборки("01.01", 100));
	СтрокиА.Добавить(СтрокаВыборки("41.01", 50));
	СтрокиА.Добавить(СтрокаВыборки("41.01", 10));
	СтрокиА.Добавить(СтрокаВыборки("50.01", 7));
	СтрокиБ = Новый Массив;
	СтрокиБ.Добавить(СтрокаВыборки("01.1", 100));
	СтрокиБ.Добавить(СтрокаВыборки("41.1", 58));
	СтрокиБ.Добавить(СтрокаВыборки("60.1", -3));
	СтрокиБ.Добавить(СтрокаВыборки("60.2", 1));

	Соответствие = Новый Массив;
	Для Каждого Пара Из СтрРазделить("01.1=01.01;41.1=41.01;60.1=60.01;60.2=60.01", ";") Цикл
		Части = СтрРазделить(Пара, "=");
		СтрокаСоответствия = Новый Соответствие;
		СтрокаСоответствия.Вставить("КлючБ", Части[0]);
		СтрокаСоответствия.Вставить("КлючА", Части[1]);
		Соответствие.Добавить(СтрокаСоответствия);
	КонецЦикла;
	СверкаДанных.ПрименитьСоответствиеКлючей(СтрокиБ, "Счет", Соответствие);

	КлючевыеПоля = СверкаДанных.РазобратьСписокПолей("Счет");
	ПоляЗначений = СверкаДанных.РазобратьСписокПолей("Сумма");
	Таблица = СверкаДанных.НоваяТаблицаСверки();
	СверкаДанных.ДобавитьСтрокиСтороны(Таблица, СтрокиА, "А", КлючевыеПоля, ПоляЗначений);
	СверкаДанных.ДобавитьСтрокиСтороны(Таблица, СтрокиБ, "Б", КлючевыеПоля, ПоляЗначений);
	Сравнение = СверкаДанных.СравнитьВыборки(Таблица, КлючевыеПоля, ПоляЗначений, 0, Новый Массив, Истина);

	Утверждать.Равно(Сравнение.Ключи.Количество(), 4, "все ключи: 01.01, 41.01, 50.01, 60.01");
	ПоКлючам = Новый Соответствие;
	Для Каждого ЗначениеКлюча Из Сравнение.Ключи Цикл
		ПоКлючам.Вставить(ЗначениеКлюча.Ключ, ЗначениеКлюча);
	КонецЦикла;
	Утверждать.Равно(ПоКлючам.Получить("01.01").Разница, 0, "совпавший ключ тоже в списке, разница 0");
	Утверждать.Равно(ПоКлючам.Получить("41.01").ЗначениеА, 60, "строки одного ключа А сложены");
	Утверждать.Равно(ПоКлючам.Получить("41.01").Разница, 2, "41.01: 60 - 58");
	Утверждать.Истина(ПоКлючам.Получить("50.01").НетВБ, "50.01 нет в Б");
	Утверждать.Равно(ПоКлючам.Получить("60.01").ЗначениеБ, -2, "60.1 и 60.2 соответствием свернуты в 60.01");
	Утверждать.Истина(ПоКлючам.Получить("60.01").НетВА, "60.01 нет в А");
	Утверждать.Равно(Сравнение.Совпало, 1, "совпал один ключ");

	// Числоподобные ключи «68.1» и «68.10» - разные счета и при сортировке не склеиваются.
	СтрокиА = Новый Массив;
	СтрокиА.Добавить(СтрокаВыборки("68.01", 5));
	СтрокиА.Добавить(СтрокаВыборки("68.10", 7));
	СтрокиБ = Новый Массив;
	СтрокиБ.Добавить(СтрокаВыборки("68.10", 7));
	СтрокиБ.Добавить(СтрокаВыборки("68.1", 5));
	Соответствие68 = Новый Массив;
	Для Каждого Пара Из СтрРазделить("68.10=68.10;68.1=68.01", ";") Цикл
		Части = СтрРазделить(Пара, "=");
		СтрокаСоответствия = Новый Соответствие;
		СтрокаСоответствия.Вставить("КлючБ", Части[0]);
		СтрокаСоответствия.Вставить("КлючА", Части[1]);
		Соответствие68.Добавить(СтрокаСоответствия);
	КонецЦикла;
	СверкаДанных.ПрименитьСоответствиеКлючей(СтрокиБ, "Счет", Соответствие68);
	Утверждать.Равно(СтрокиБ.Получить(1).Получить("Счет"), "68.01", "68.1 сопоставлен с 68.01, а не с 68.10");
	Таблица68 = СверкаДанных.НоваяТаблицаСверки();
	СверкаДанных.ДобавитьСтрокиСтороны(Таблица68, СтрокиА, "А", КлючевыеПоля, ПоляЗначений);
	СверкаДанных.ДобавитьСтрокиСтороны(Таблица68, СтрокиБ, "Б", КлючевыеПоля, ПоляЗначений);
	Сравнение68 = СверкаДанных.СравнитьВыборки(Таблица68, КлючевыеПоля, ПоляЗначений, 0, Новый Массив, Истина);
	Утверждать.Равно(Сравнение68.Совпало, 2, "68.01 и 68.10 совпали каждый со своим");

	СравнениеБезКлючей = СверкаДанных.СравнитьВыборки(Таблица, КлючевыеПоля, ПоляЗначений, 0, Новый Массив);
	Утверждать.Равно(СравнениеБезКлючей.Ключи.Количество(), 0, "без признака ключи не собираются");

КонецПроцедуры

Процедура ПроверитьПояснения()

	Пояснения = СверкаДанных.РазобратьПояснения("41.01 :: trade :: дрейф себестоимости" + Символы.ПС
		+ "  " + Символы.ПС + "66.03 ::  :: документ ПТ-0001 :: ждет" + Символы.ПС + "01.01 :: 7.7");
	Утверждать.Равно(Пояснения.Количество(), 3, "пустая строка пропущена");
	Утверждать.Равно(Пояснения.Получить("41.01").Эталон, "trade", "эталон");
	Утверждать.Равно(Пояснения.Получить("41.01").Причина, "дрейф себестоимости", "причина");
	Утверждать.Равно(Пояснения.Получить("66.03").Эталон, "", "пустой эталон");
	Утверждать.Равно(Пояснения.Получить("66.03").Причина, "документ ПТ-0001 :: ждет", "разделитель внутри причины сохраняется");
	Утверждать.Равно(Пояснения.Получить("01.01").Причина, "", "без причины");

КонецПроцедуры

Процедура ПроверитьПериодSQL()

	Текст = ФастексКлиент.ПодставитьПериодSQL("WHERE d >= &НачалоПериода AND d <= &КонецПериода",
		Дата(2026, 9, 1), Дата(2026, 9, 30, 23, 59, 59));
	Утверждать.Равно(Текст, "WHERE d >= '20260901 00:00:00' AND d <= '20260930 23:59:59'", "литералы даты SQL");

КонецПроцедуры

Процедура ПроверитьФрагментSQL()

	Маркер = "маркер-пароля-Q9";
	ТекстЗапроса = "SELECT 'a""b' AS Текст, -- комментарий" + Символы.ВК + Символы.ПС + "1 AS Число";
	Фрагмент = ФастексКлиент.ТекстФрагментаSQL(ТекстЗапроса, "Provider=SQLOLEDB;Data Source=db.example", Маркер);
	Строки = СтрРазделить(Фрагмент, Символы.ПС);
	Утверждать.Истина(СтрНайти(Строки.Получить(0), Маркер) > 0, "пароль - в первой строке");
	ВхожденийДальше = 0;
	Для Индекс = 1 По Строки.ВГраница() Цикл
		Если СтрНайти(Строки.Получить(Индекс), Маркер) > 0 Тогда
			ВхожденийДальше = ВхожденийДальше + 1;
		КонецЕсли;
	КонецЦикла;
	Утверждать.Равно(ВхожденийДальше, 0, "дальше первой строки пароля нет");
	Утверждать.Истина(СтрНайти(Фрагмент, """SELECT 'a""""b' AS Текст, -- комментарий"" + Символы.ПС + ""1 AS Число""") > 0,
		"запрос перенесен построчно, кавычки удвоены, возврата каретки нет");
	Утверждать.Истина(СтрНайти(Фрагмент, "СтрокаСоединенияСУБД = """";") > 0, "строка соединения затирается");

КонецПроцедуры


Процедура ПроверитьПакет()

	Запросы = СверкаДанных.ЗапросыПакета("ВЫБРАТЬ 1" + Символы.ВК + Символы.ПС + "  ;  " + Символы.ПС + "ВЫБРАТЬ 2;" + Символы.ПС + ";" + Символы.ПС + "  ");
	Утверждать.Равно(Запросы.Количество(), 2, "два запроса, пустой хвост пропущен");
	Утверждать.Равно(Запросы.Получить(0), "ВЫБРАТЬ 1", "первый запрос без возврата каретки");
	Утверждать.Равно(Запросы.Получить(1), "ВЫБРАТЬ 2;", "«;» в конце строки запроса - не разделитель");
	Утверждать.Равно(СверкаДанных.ЗапросыПакета("ВЫБРАТЬ 3").Количество(), 1, "без разделителя - один запрос");

КонецПроцедуры
