// Заводит или обновляет источники и настройки сверки из файла JSON (по наименованию).
// Формат: {"источники": [{"наименование", "тип", "адрес", "пользователь", "секрет",
//  "пользователь77", "секрет77"}],
//  "настройки": [{"наименование", "источникА", "запросА", "источникБ", "запросБ", "запросСоответствияБ", "порцииЗапроса",
//  "ключевыеПоля", "поляЗначений", "погрешность", "поляБезУчетаФормата"}]}
Процедура Выполнить() Экспорт

	ЧтениеФайла = Новый ЧтениеТекста(Параметры.ПутьКФайлу);
	ЧтениеФайла.Открыть();
	Данные = ПрочитатьJSON(ЧтениеФайла.Прочитать());
	ЧтениеФайла.Закрыть();

	ОписанияИсточников = Данные.Получить("источники");
	Если ОписанияИсточников <> Неопределено Тогда
		Для Каждого Описание Из ОписанияИсточников Цикл
			ЗаписатьИсточник(Описание);
		КонецЦикла;
	КонецЕсли;

	ОписанияНастроек = Данные.Получить("настройки");
	Если ОписанияНастроек <> Неопределено Тогда
		Для Каждого Описание Из ОписанияНастроек Цикл
			ЗаписатьНастройку(Описание);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьИсточник(Описание)

	Наименование = Описание.Получить("наименование");
	Ссылка = Справочники.Источники.НайтиПоНаименованию(Наименование);
	Если Ссылка = Неопределено Тогда
		Объект = Справочники.Источники.Создать();
	Иначе
		Объект = Ссылка.ПолучитьОбъект();
	КонецЕсли;

	Объект.Наименование = Наименование;
	Если Описание.Получить("тип") = "Fastex77ЧерезБазу1С8" Тогда
		Объект.Тип = Перечисления.ТипыИсточников.Fastex77ЧерезБазу1С8;
	Иначе
		Объект.Тип = Перечисления.ТипыИсточников.Fastex1С8;
	КонецЕсли;
	Объект.АдресПубликации = Описание.Получить("адрес");
	Объект.Пользователь = Описание.Получить("пользователь");
	Объект.СекретПароля = Описание.Получить("секрет");
	Объект.Пользователь77 = Описание.Получить("пользователь77");
	Объект.СекретПароля77 = Описание.Получить("секрет77");
	Объект.Записать();
	Сообщить("Источник записан: " + Наименование);

КонецПроцедуры

Процедура ЗаписатьНастройку(Описание)

	Наименование = Описание.Получить("наименование");
	Ссылка = Справочники.НастройкиСверки.НайтиПоНаименованию(Наименование);
	Если Ссылка = Неопределено Тогда
		Объект = Справочники.НастройкиСверки.Создать();
	Иначе
		Объект = Ссылка.ПолучитьОбъект();
	КонецЕсли;

	Объект.Наименование = Наименование;
	Объект.ИсточникА = НайтиИсточник(Описание.Получить("источникА"));
	Объект.ЗапросА = Описание.Получить("запросА");
	Объект.ИсточникБ = НайтиИсточник(Описание.Получить("источникБ"));
	Объект.ЗапросБ = Описание.Получить("запросБ");
	Объект.ЗапросСоответствияБ = Описание.Получить("запросСоответствияБ");
	Объект.ПорцииЗапроса = Описание.Получить("порцииЗапроса");
	Объект.КлючевыеПоля = Описание.Получить("ключевыеПоля");
	Объект.ПоляЗначений = Описание.Получить("поляЗначений");
	Объект.Погрешность = Описание.Получить("погрешность");
	Объект.ПоляБезУчетаФормата = Описание.Получить("поляБезУчетаФормата");
	Объект.Записать();
	Сообщить("Настройка записана: " + Наименование);

КонецПроцедуры

Функция НайтиИсточник(Наименование)

	Ссылка = Справочники.Источники.НайтиПоНаименованию(Наименование);
	Если Ссылка = Неопределено Тогда
		ВызватьИсключение "Не найден источник " + Наименование;
	КонецЕсли;

	Возврат Ссылка;

КонецФункции
