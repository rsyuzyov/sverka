// Заводит или обновляет источники и настройки сверки из JSON по наименованию в пределах проекта.
// Понимает оба формата (см. модуль НастройкиПроекта):
// - снимок {"источники": [{"наименование", "тип", "адрес", "пользователь", "секрет", "пользователь77", "секрет77"}],
//   "настройки": [{"наименование", "источникА", "запросА", "источникБ", "запросБ", "запросСоответствияБ",
//   "порцииЗапроса", "ключевыеПоля", "поляЗначений", "погрешность", "поляБезУчетаФормата"}]};
// - файл одного объекта из репозитория настроек (sources/<имя>.json, settings/<имя>.json);
//   путь к каталогу рабочей копии такого репозитория загружает сначала sources, потом settings.
Процедура Выполнить() Экспорт

	Проект = НастройкиПроекта.НайтиПроект(Параметры.ИмяПроекта);
	Путь = СокрЛП(Параметры.ПутьКФайлу);
	Если СтрЗаканчиваетсяНа(НРег(Путь), ".json") Тогда
		ЧислоОбъектов = НастройкиПроекта.ЗагрузитьФайл(Путь, Проект);
	Иначе
		ЧислоОбъектов = НастройкиПроекта.ЗагрузитьКаталог(Путь, Проект);
	КонецЕсли;
	Сообщить("Загружено объектов: " + Строка(ЧислоОбъектов) + ", проект " + НастройкиПроекта.ПредставлениеПроекта(Проект));

КонецПроцедуры
