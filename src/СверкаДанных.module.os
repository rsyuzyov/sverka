// Движок сверки: две выборки, свертка по ключу, сравнение с погрешностью.

// Сколько дней должно пройти после конца периода, чтобы выборку можно было брать из кэша.
Функция ДнейДоЗаморозкиПериода() Экспорт
	Возврат 90;
КонецФункции

// Выполняет сверку по наименованию настройки. Возвращает записанный документ ЗапускСверки.
Функция ВыполнитьСверкуПоИмени(ИмяНастройки, НачалоПериода, КонецПериода, Перечитать) Экспорт

	Настройка = Справочники.НастройкиСверки.НайтиПоНаименованию(ИмяНастройки);
	Если Настройка = Неопределено Тогда
		ВызватьИсключение "Не найдена настройка сверки " + ИмяНастройки;
	КонецЕсли;

	Возврат ВыполнитьСверку(Настройка, НачалоПериода, КонецПериода, Перечитать);

КонецФункции

// Выполняет сверку по настройке и записывает результат в новый документ ЗапускСверки.
Функция ВыполнитьСверку(Настройка, НачалоПериода, КонецПериода, Перечитать) Экспорт

	НастройкаОбъект = Настройка.ПолучитьОбъект();

	ЗапускОбъект = Документы.ЗапускСверки.Создать();
	ЗапускОбъект.Дата = ТекущаяДатаВремя();
	ЗапускОбъект.Настройка = Настройка;
	ЗапускОбъект.НачалоПериода = НачалоПериода;
	ЗапускОбъект.КонецПериода = КонецПериода;
	ЗапускОбъект.Перечитать = (Перечитать = Истина);
	ЗапускОбъект.Состояние = "Выполняется";

	Попытка

		КлючевыеПоля = РазобратьСписокПолей(НастройкаОбъект.КлючевыеПоля);
		ПоляЗначений = РазобратьСписокПолей(НастройкаОбъект.ПоляЗначений);
		Если КлючевыеПоля.Количество() = 0 Тогда
			ВызватьИсключение "В настройке не заданы ключевые поля";
		КонецЕсли;

		ВыборкаА = ПолучитьВыборку(НастройкаОбъект.ИсточникА, НастройкаОбъект.ЗапросА,
			НачалоПериода, КонецПериода, ЗапускОбъект.Перечитать);
		ЗапускОбъект.ВремяВыборкиА = ВыборкаА.Секунд;
		ЗапускОбъект.ИзКэшаА = ВыборкаА.ИзКэша;
		ЗапускОбъект.СтрокА = ВыборкаА.Строки.Количество();

		ВыборкаБ = ПолучитьВыборку(НастройкаОбъект.ИсточникБ, НастройкаОбъект.ЗапросБ,
			НачалоПериода, КонецПериода, ЗапускОбъект.Перечитать);
		ЗапускОбъект.ВремяВыборкиБ = ВыборкаБ.Секунд;
		ЗапускОбъект.ИзКэшаБ = ВыборкаБ.ИзКэша;
		ЗапускОбъект.СтрокБ = ВыборкаБ.Строки.Количество();

		// Соответствие ключей применяется к первому ключевому полю стороны Б.
		Если ЗначениеЗаполнено(НастройкаОбъект.ЗапросСоответствияБ) Тогда
			ВыборкаСоответствия = ПолучитьВыборку(НастройкаОбъект.ИсточникБ, НастройкаОбъект.ЗапросСоответствияБ,
				НачалоПериода, КонецПериода, ЗапускОбъект.Перечитать);
			ПрименитьСоответствиеКлючей(ВыборкаБ.Строки, КлючевыеПоля.Получить(0), ВыборкаСоответствия.Строки);
			ЗапускОбъект.СтрокСоответствия = ВыборкаСоответствия.Строки.Количество();
		КонецЕсли;

		ТаблицаСверки = НоваяТаблицаСверки();
		ДобавитьСтрокиСтороны(ТаблицаСверки, ВыборкаА.Строки, "А", КлючевыеПоля, ПоляЗначений);
		ДобавитьСтрокиСтороны(ТаблицаСверки, ВыборкаБ.Строки, "Б", КлючевыеПоля, ПоляЗначений);
		Сравнение = СравнитьВыборки(ТаблицаСверки, ПоляЗначений, НастройкаОбъект.Погрешность);

		Для Каждого Расхождение Из Сравнение.Расхождения Цикл
			СтрокаРасхождения = ЗапускОбъект.Расхождения.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаРасхождения, Расхождение);
		КонецЦикла;
		ЗапускОбъект.ЧислоРасхождений = Сравнение.Расхождения.Количество();
		ЗапускОбъект.КлючейСовпало = Сравнение.Совпало;
		ЗапускОбъект.КлючейРасходится = Сравнение.Расходится;
		ЗапускОбъект.КлючейНетВА = Сравнение.НетВА;
		ЗапускОбъект.КлючейНетВБ = Сравнение.НетВБ;
		ЗапускОбъект.Состояние = "Выполнено";

	Исключение
		ЗапускОбъект.Состояние = "Ошибка";
		ЗапускОбъект.ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	ЗапускОбъект.Записать();

	Возврат ЗапускОбъект;

КонецФункции

// Итог запуска для внешнего вызова: шапка и первые Лимит расхождений.
// Соответствие, а не структура: ЗаписатьJSON переводит ключи структуры в нижний регистр.
Функция ИтогЗапуска(ЗапускОбъект, Лимит) Экспорт

	Итог = Новый Соответствие;
	Итог.Вставить("номер", ЗапускОбъект.Номер);
	Итог.Вставить("настройка", Строка(ЗапускОбъект.Настройка));
	Итог.Вставить("началоПериода", ЗапускОбъект.НачалоПериода);
	Итог.Вставить("конецПериода", ЗапускОбъект.КонецПериода);
	Итог.Вставить("состояние", ЗапускОбъект.Состояние);
	Итог.Вставить("ошибка", ЗапускОбъект.ТекстОшибки);
	Итог.Вставить("строкА", ЗапускОбъект.СтрокА);
	Итог.Вставить("строкБ", ЗапускОбъект.СтрокБ);
	Итог.Вставить("секундА", ЗапускОбъект.ВремяВыборкиА);
	Итог.Вставить("секундБ", ЗапускОбъект.ВремяВыборкиБ);
	Итог.Вставить("изКэшаА", ЗапускОбъект.ИзКэшаА = Истина);
	Итог.Вставить("изКэшаБ", ЗапускОбъект.ИзКэшаБ = Истина);
	Итог.Вставить("строкСоответствия", ЗапускОбъект.СтрокСоответствия);
	Итог.Вставить("ключейСовпало", ЗапускОбъект.КлючейСовпало);
	Итог.Вставить("ключейРасходится", ЗапускОбъект.КлючейРасходится);
	Итог.Вставить("ключейНетВА", ЗапускОбъект.КлючейНетВА);
	Итог.Вставить("ключейНетВБ", ЗапускОбъект.КлючейНетВБ);
	Итог.Вставить("расхождений", ЗапускОбъект.ЧислоРасхождений);

	Список = Новый Массив;
	Для Каждого СтрокаРасхождения Из ЗапускОбъект.Расхождения Цикл
		Если Список.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;
		ЗначенияТекстом = ЗначениеЗаполнено(СтрокаРасхождения.ТекстА) Или ЗначениеЗаполнено(СтрокаРасхождения.ТекстБ);
		Элемент = Новый Соответствие;
		Элемент.Вставить("ключ", СтрокаРасхождения.Ключ);
		Элемент.Вставить("представление", СтрокаРасхождения.ПредставлениеКлюча);
		Элемент.Вставить("поле", СтрокаРасхождения.Поле);
		Если ЗначенияТекстом Тогда
			Элемент.Вставить("значениеА", СтрокаРасхождения.ТекстА);
			Элемент.Вставить("значениеБ", СтрокаРасхождения.ТекстБ);
		Иначе
			Элемент.Вставить("значениеА", СтрокаРасхождения.ЗначениеА);
			Элемент.Вставить("значениеБ", СтрокаРасхождения.ЗначениеБ);
			Элемент.Вставить("разница", СтрокаРасхождения.Разница);
		КонецЕсли;
		Элемент.Вставить("нетВА", СтрокаРасхождения.НетВА = Истина);
		Элемент.Вставить("нетВБ", СтрокаРасхождения.НетВБ = Истина);
		Список.Добавить(Элемент);
	КонецЦикла;
	Итог.Вставить("расхождения", Список);

	Возврат Итог;

КонецФункции

// Выборка стороны сверки: из кэша, если период заморожен и кэш есть, иначе из источника.
Функция ПолучитьВыборку(Источник, ТекстЗапроса, НачалоПериода, КонецПериода, Перечитать) Экспорт

	ТекстСПериодом = ПодставитьПериод(ТекстЗапроса, НачалоПериода, КонецПериода);
	ХешЗапроса = ХешСтроки(ТекстСПериодом);
	ПериодЗаморожен = ПериодЗаморожен(КонецПериода);
	Начало = ТекущаяДатаВремя();

	Результат = Новый Структура;
	Результат.Вставить("ИзКэша", Ложь);

	Если ПериодЗаморожен И Перечитать <> Истина Тогда
		Кэш = ПрочитатьКэш(Источник, ХешЗапроса, ТекстСПериодом, НачалоПериода, КонецПериода);
		Если Кэш <> Неопределено Тогда
			Результат.Вставить("ИзКэша", Истина);
			Результат.Вставить("Строки", Кэш);
			Результат.Вставить("Секунд", ТекущаяДатаВремя() - Начало);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Строки = ФастексКлиент.ВыполнитьВыборку(Источник, ТекстСПериодом, НачалоПериода, КонецПериода);
	Если ПериодЗаморожен Тогда
		ЗаписатьКэш(Источник, ХешЗапроса, ТекстСПериодом, НачалоПериода, КонецПериода, Строки);
	КонецЕсли;

	Результат.Вставить("Строки", Строки);
	Результат.Вставить("Секунд", ТекущаяДатаВремя() - Начало);

	Возврат Результат;

КонецФункции

Функция ПериодЗаморожен(КонецПериода) Экспорт

	Если Не ЗначениеЗаполнено(КонецПериода) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат КонецПериода < ДобавитьДень(ТекущаяДата(), -ДнейДоЗаморозкиПериода());

КонецФункции

// Заменяет &НачалоПериода и &КонецПериода литералами ДАТАВРЕМЯ языка запросов 1С.
Функция ПодставитьПериод(ТекстЗапроса, НачалоПериода, КонецПериода) Экспорт

	Результат = СтрЗаменить(ТекстЗапроса, "&НачалоПериода", ЛитералДаты(НачалоПериода));
	Результат = СтрЗаменить(Результат, "&КонецПериода", ЛитералДаты(КонецПериода));

	Возврат Результат;

КонецФункции

Функция ЛитералДаты(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "ДАТАВРЕМЯ(1, 1, 1)";
	КонецЕсли;

	Возврат "ДАТАВРЕМЯ(" + Строка(Год(Значение)) + ", " + Строка(Месяц(Значение)) + ", "
		+ Строка(День(Значение)) + ", " + Строка(Час(Значение)) + ", "
		+ Строка(Минута(Значение)) + ", " + Строка(Секунда(Значение)) + ")";

КонецФункции

// Хеш текста для ключа кэша: длина и два полиномиальных хеша по разным модулям.
// Совпадение хеша перепроверяется сравнением сохраненного текста запроса.
Функция ХешСтроки(Текст) Экспорт

	ХешПервый = 0;
	ХешВторой = 0;
	Длина = СтрДлина(Текст);
	Для Позиция = 1 По Длина Цикл
		КодТекущий = КодСимвола(Текст, Позиция);
		ХешПервый = ОстатокОтДеления(ХешПервый * 131 + КодТекущий, 1000003);
		ХешВторой = ОстатокОтДеления(ХешВторой * 257 + КодТекущий, 999983);
	КонецЦикла;

	Возврат Строка(Длина) + "-" + Строка(ХешПервый) + "-" + Строка(ХешВторой);

КонецФункции

Функция ОстатокОтДеления(Делимое, Делитель)
	Возврат Делимое - Цел(Делимое / Делитель) * Делитель;
КонецФункции

Функция ПрочитатьКэш(Источник, ХешЗапроса, ТекстЗапроса, НачалоПериода, КонецПериода)

	// Даты сверяются в модуле: на SQLite равенство дат в условии запроса не срабатывает.
	ЗапросКэша = Новый Запрос;
	ЗапросКэша.Текст = "ВЫБРАТЬ НачалоПериода, КонецПериода, ТекстЗапроса, Данные
		|ИЗ РегистрСведений.КэшВыборок
		|ГДЕ Источник = &Источник
		|	И ХешЗапроса = &ХешЗапроса";
	ЗапросКэша.УстановитьПараметр("Источник", Источник);
	ЗапросКэша.УстановитьПараметр("ХешЗапроса", ХешЗапроса);

	Для Каждого Запись Из ЗапросКэша.Выполнить() Цикл
		Если Запись.НачалоПериода = НачалоПериода
			И Запись.КонецПериода = КонецПериода
			И Запись.ТекстЗапроса = ТекстЗапроса Тогда
			Возврат ПрочитатьJSON(Запись.Данные);
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Процедура ЗаписатьКэш(Источник, ХешЗапроса, ТекстЗапроса, НачалоПериода, КонецПериода, Строки)

	МенеджерЗаписи = РегистрыСведений.КэшВыборок.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Источник = Источник;
	МенеджерЗаписи.ХешЗапроса = ХешЗапроса;
	МенеджерЗаписи.НачалоПериода = НачалоПериода;
	МенеджерЗаписи.КонецПериода = КонецПериода;
	МенеджерЗаписи.ТекстЗапроса = ТекстЗапроса;
	МенеджерЗаписи.Данные = ЗаписатьJSON(Строки);
	МенеджерЗаписи.ДатаСнятия = ТекущаяДатаВремя();
	МенеджерЗаписи.ЧислоСтрок = Строки.Количество();
	МенеджерЗаписи.Записать();

КонецПроцедуры

// Свертка и сравнение построены на сортировке таблицы значений, а не на Соответствии:
// в DSL поиск и вставка в Соответствие линейные, и на десятках тысяч ключей сверка шла минутами.

// Заменяет значение первого ключевого поля строк стороны Б на ключ стороны А по строкам
// соответствия с колонками КлючА и КлючБ. Строки без соответствия остаются как есть.
Процедура ПрименитьСоответствиеКлючей(Строки, ИмяПоля, СтрокиСоответствия) Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Значение");
	Таблица.Колонки.Добавить("Индекс");
	Таблица.Колонки.Добавить("Замена");

	Для Каждого СтрокаСоответствия Из СтрокиСоответствия Цикл
		КлючА = СтрокаКлюча(СтрокаСоответствия.Получить("КлючА"));
		КлючБ = СтрокаКлюча(СтрокаСоответствия.Получить("КлючБ"));
		Если ЗначениеЗаполнено(КлючА) И ЗначениеЗаполнено(КлючБ) Тогда
			НоваяСтрока = Таблица.Добавить();
			НоваяСтрока.Значение = КлючБ;
			НоваяСтрока.Индекс = -1;
			НоваяСтрока.Замена = КлючА;
		КонецЕсли;
	КонецЦикла;

	Индекс = 0;
	Для Каждого СтрокаВыборки Из Строки Цикл
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Значение = СтрокаКлюча(СтрокаВыборки.Получить(ИмяПоля));
		НоваяСтрока.Индекс = Индекс;
		Индекс = Индекс + 1;
	КонецЦикла;

	Таблица.Сортировать("Значение, Индекс");

	ТекущееЗначение = Неопределено;
	Замена = Неопределено;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если ТипЗнч(ТекущееЗначение) = Тип("Неопределено") Или СтрокаТаблицы.Значение <> ТекущееЗначение Тогда
			ТекущееЗначение = СтрокаТаблицы.Значение;
			Замена = Неопределено;
		КонецЕсли;
		Если СтрокаТаблицы.Индекс < 0 Тогда
			Замена = СтрокаТаблицы.Замена;
		ИначеЕсли ТипЗнч(Замена) = Тип("Строка") Тогда
			Строки.Получить(СтрокаТаблицы.Индекс).Вставить(ИмяПоля, Замена);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Таблица строк обеих сторон с вычисленным ключом: Ключ, Сторона (А или Б), Представление,
// Значения и Тексты (массивы в порядке полей значений).
Функция НоваяТаблицаСверки() Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Ключ");
	Таблица.Колонки.Добавить("Сторона");
	Таблица.Колонки.Добавить("Представление");
	Таблица.Колонки.Добавить("Значения");
	Таблица.Колонки.Добавить("Тексты");

	Возврат Таблица;

КонецФункции

Процедура ДобавитьСтрокиСтороны(Таблица, Строки, Сторона, КлючевыеПоля, ПоляЗначений) Экспорт

	Для Каждого СтрокаВыборки Из Строки Цикл

		ЧастиКлюча = Новый Массив;
		ЧастиПредставления = Новый Массив;
		Для Каждого ИмяПоля Из КлючевыеПоля Цикл
			ЗначениеКлюча = СтрокаКлюча(СтрокаВыборки.Получить(ИмяПоля));
			ЧастиКлюча.Добавить(ЗначениеКлюча);
			ЧастиПредставления.Добавить(ПредставлениеПоля(СтрокаВыборки, ИмяПоля, ЗначениеКлюча));
		КонецЦикла;

		Значения = Новый Массив;
		Тексты = Новый Массив;
		Для Каждого ИмяПоля Из ПоляЗначений Цикл
			Значение = ЗначениеДляСравнения(СтрокаВыборки.Получить(ИмяПоля));
			Значения.Добавить(Значение);
			Тексты.Добавить(ПредставлениеПоля(СтрокаВыборки, ИмяПоля, СтрокаСравнения(Значение)));
		КонецЦикла;

		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Ключ = СтрСоединить(ЧастиКлюча, "|");
		НоваяСтрока.Сторона = Сторона;
		НоваяСтрока.Представление = СтрСоединить(ЧастиПредставления, " | ");
		НоваяСтрока.Значения = Значения;
		НоваяСтрока.Тексты = Тексты;

	КонецЦикла;

КонецПроцедуры

// Сравнивает стороны таблицы сверки. Возвращает структуру: Расхождения (массив структур с полями
// строки табличной части Расхождения) и счетчики ключей Совпало, Расходится, НетВА, НетВБ.
Функция СравнитьВыборки(Таблица, ПоляЗначений, Погрешность) Экспорт

	Итог = Новый Структура;
	Итог.Вставить("Расхождения", Новый Массив);
	Итог.Вставить("Совпало", 0);
	Итог.Вставить("Расходится", 0);
	Итог.Вставить("НетВА", 0);
	Итог.Вставить("НетВБ", 0);
	Допуск = ЧислоЗначения(Погрешность);

	Таблица.Сортировать("Ключ, Сторона");

	ТекущийКлюч = Неопределено;
	ДанныеА = Неопределено;
	ДанныеБ = Неопределено;
	Для Каждого СтрокаТаблицы Из Таблица Цикл

		Если ТипЗнч(ТекущийКлюч) = Тип("Неопределено") Или СтрокаТаблицы.Ключ <> ТекущийКлюч Тогда
			Если ТипЗнч(ТекущийКлюч) <> Тип("Неопределено") Тогда
				СравнитьКлюч(Итог, ТекущийКлюч, ДанныеА, ДанныеБ, ПоляЗначений, Допуск);
			КонецЕсли;
			ТекущийКлюч = СтрокаТаблицы.Ключ;
			ДанныеА = Неопределено;
			ДанныеБ = Неопределено;
		КонецЕсли;

		Если СтрокаТаблицы.Сторона = "А" Тогда
			ДанныеА = НакопитьСтроку(ДанныеА, СтрокаТаблицы, ПоляЗначений);
		Иначе
			ДанныеБ = НакопитьСтроку(ДанныеБ, СтрокаТаблицы, ПоляЗначений);
		КонецЕсли;

	КонецЦикла;

	Если ТипЗнч(ТекущийКлюч) <> Тип("Неопределено") Тогда
		СравнитьКлюч(Итог, ТекущийКлюч, ДанныеА, ДанныеБ, ПоляЗначений, Допуск);
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Числа по одинаковому ключу суммируются, прочие значения берутся из первой строки.
Функция НакопитьСтроку(Данные, СтрокаТаблицы, ПоляЗначений)

	Если Данные = Неопределено Тогда
		Данные = Новый Структура;
		Данные.Вставить("Представление", СтрокаТаблицы.Представление);
		Данные.Вставить("Значения", Новый Соответствие);
		Данные.Вставить("Тексты", Новый Соответствие);
		Для Индекс = 0 По ПоляЗначений.Количество() - 1 Цикл
			Данные.Значения.Вставить(ПоляЗначений.Получить(Индекс), СтрокаТаблицы.Значения.Получить(Индекс));
			Данные.Тексты.Вставить(ПоляЗначений.Получить(Индекс), СтрокаТаблицы.Тексты.Получить(Индекс));
		КонецЦикла;
		Возврат Данные;
	КонецЕсли;

	Для Индекс = 0 По ПоляЗначений.Количество() - 1 Цикл
		ИмяПоля = ПоляЗначений.Получить(Индекс);
		Накоплено = Данные.Значения.Получить(ИмяПоля);
		Значение = СтрокаТаблицы.Значения.Получить(Индекс);
		Если ТипЗнч(Накоплено) = Тип("Число") И ТипЗнч(Значение) = Тип("Число") Тогда
			Данные.Значения.Вставить(ИмяПоля, Накоплено + Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Данные;

КонецФункции

// Ключ, которого нет на одной стороне: при числовых полях сравнивается с нулем по каждому полю,
// при нечисловых дает одну строку «нет в А» или «нет в Б».
Процедура СравнитьКлюч(Итог, Ключ, ДанныеА, ДанныеБ, ПоляЗначений, Допуск)

	НетВА = (ДанныеА = Неопределено);
	НетВБ = (ДанныеБ = Неопределено);
	ДанныеСтороны = ?(НетВА, ДанныеБ, ДанныеА);
	Представление = ДанныеСтороны.Представление;
	Расхождения = Итог.Расхождения;

	Если НетВА Тогда
		Итог.НетВА = Итог.НетВА + 1;
	ИначеЕсли НетВБ Тогда
		Итог.НетВБ = Итог.НетВБ + 1;
	КонецЕсли;

	Если НетВА Или НетВБ Тогда
		Если ПоляЗначений.Количество() = 0 Или Не ВсеЗначенияЧисловые(ДанныеСтороны) Тогда
			Расхождение = НовоеРасхождение(Ключ, Представление, "", НетВА, НетВБ);
			Расхождение.ТекстА = ?(НетВА, "", Представление);
			Расхождение.ТекстБ = ?(НетВБ, "", Представление);
			Расхождения.Добавить(Расхождение);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ЕстьРасхождение = Ложь;
	Для Каждого ИмяПоля Из ПоляЗначений Цикл

		ЗначениеА = ?(НетВА, 0, ДанныеА.Значения.Получить(ИмяПоля));
		ЗначениеБ = ?(НетВБ, 0, ДанныеБ.Значения.Получить(ИмяПоля));

		Если ТипЗнч(ЗначениеА) = Тип("Число") И ТипЗнч(ЗначениеБ) = Тип("Число") Тогда
			Если Абс(ЗначениеА - ЗначениеБ) > Допуск Тогда
				Расхождение = НовоеРасхождение(Ключ, Представление, ИмяПоля, НетВА, НетВБ);
				Расхождение.ЗначениеА = ЗначениеА;
				Расхождение.ЗначениеБ = ЗначениеБ;
				Расхождение.Разница = ЗначениеА - ЗначениеБ;
				Расхождения.Добавить(Расхождение);
				ЕстьРасхождение = Истина;
			КонецЕсли;
		ИначеЕсли СтрокаСравнения(ЗначениеА) <> СтрокаСравнения(ЗначениеБ) Тогда
			Расхождение = НовоеРасхождение(Ключ, Представление, ИмяПоля, НетВА, НетВБ);
			Расхождение.ТекстА = ?(НетВА, "", ДанныеА.Тексты.Получить(ИмяПоля));
			Расхождение.ТекстБ = ?(НетВБ, "", ДанныеБ.Тексты.Получить(ИмяПоля));
			Расхождения.Добавить(Расхождение);
			ЕстьРасхождение = Истина;
		КонецЕсли;

	КонецЦикла;

	Если Не НетВА И Не НетВБ Тогда
		Если ЕстьРасхождение Тогда
			Итог.Расходится = Итог.Расходится + 1;
		Иначе
			Итог.Совпало = Итог.Совпало + 1;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ВсеЗначенияЧисловые(ДанныеСтороны)

	Для Каждого ЗначениеПоля Из ДанныеСтороны.Значения Цикл
		Если ТипЗнч(ЗначениеПоля.Значение) <> Тип("Число") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция НовоеРасхождение(Ключ, Представление, ИмяПоля, НетВА, НетВБ)

	Расхождение = Новый Структура;
	Расхождение.Вставить("Ключ", Ключ);
	Расхождение.Вставить("ПредставлениеКлюча", Представление);
	Расхождение.Вставить("Поле", ИмяПоля);
	Расхождение.Вставить("ЗначениеА", 0);
	Расхождение.Вставить("ЗначениеБ", 0);
	Расхождение.Вставить("Разница", 0);
	Расхождение.Вставить("ТекстА", "");
	Расхождение.Вставить("ТекстБ", "");
	Расхождение.Вставить("НетВА", НетВА);
	Расхождение.Вставить("НетВБ", НетВБ);

	Возврат Расхождение;

КонецФункции

Функция РазобратьСписокПолей(СписокПолей) Экспорт

	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(СписокПолей) Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ИмяПоля Из СтрРазделить(СписокПолей, ",") Цикл
		ИмяБезПробелов = СокрЛП(ИмяПоля);
		Если ЗначениеЗаполнено(ИмяБезПробелов) Тогда
			Результат.Добавить(ИмяБезПробелов);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Значение ключевого поля строкой. Дата-время из fastex (ГГГГ-ММ-ДДTчч:мм:сс) сводится к дню.
Функция СтрокаКлюча(Значение) Экспорт

	Текст = СтрокаСравнения(Значение);
	Если ЭтоДатаВремя(Текст) Тогда
		Возврат Лев(Текст, 10);
	КонецЕсли;

	Возврат Текст;

КонецФункции

Функция ЭтоДатаВремя(Текст)

	Возврат СтрДлина(Текст) = 19
		И Сред(Текст, 5, 1) = "-"
		И Сред(Текст, 8, 1) = "-"
		И Сред(Текст, 11, 1) = "T"
		И Сред(Текст, 14, 1) = ":";

КонецФункции

// Представление поля: колонка <Поле>Представление от fastex, иначе запасное значение.
Функция ПредставлениеПоля(СтрокаВыборки, ИмяПоля, ЗапасноеЗначение)

	Представление = СтрокаВыборки.Получить(ИмяПоля + "Представление");
	Если ТипЗнч(Представление) = Тип("Неопределено") Тогда
		Возврат ЗапасноеЗначение;
	КонецЕсли;

	Возврат Строка(Представление);

КонецФункции

Функция ЗначениеДляСравнения(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Или ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Неопределено") Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрП(Строка(Значение));

КонецФункции

Функция СтрокаСравнения(Значение)

	Если ТипЗнч(Значение) = Тип("Неопределено") Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "Да", "Нет");
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

Функция ЧислоЗначения(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Неопределено") Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Число(Строка(Значение));

КонецФункции

// Дата из строки вида 2024-01-01 или 2024-01-01T23:59:59; пустое значение - Неопределено.
Функция ДатаИзТекста(Значение) Экспорт

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Текст = Строка(Значение);
	Результат = Дата(Лев(Текст, 10));
	Если СтрДлина(Текст) >= 19 Тогда
		Результат = Дата(Год(Результат), Месяц(Результат), День(Результат),
			Число(Сред(Текст, 12, 2)), Число(Сред(Текст, 15, 2)), Число(Сред(Текст, 18, 2)));
	КонецЕсли;

	Возврат Результат;

КонецФункции
