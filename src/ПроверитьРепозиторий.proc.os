// Проверка доступа к репозиторию проекта только чтением: коммит ветки, файлы sources/ и settings/,
// по желанию - пробное чтение одного файла (печатаются размер и ключи, не содержимое).
Процедура Выполнить() Экспорт

	Проект = НастройкиПроекта.НайтиПроект(Параметры.ИмяПроекта);
	ПараметрыРепозитория = РепозиторийНастроек.ПараметрыРепозитория(Проект);
	Коммит = РепозиторийНастроек.КоммитВетки(ПараметрыРепозитория);
	Сообщить("Ветка " + ПараметрыРепозитория.Ветка + ", коммит " + Коммит);

	Для Каждого Вид Из СтрРазделить(НастройкиПроекта.ВидИсточник() + "," + НастройкиПроекта.ВидНастройка(), ",") Цикл
		КаталогВида = РепозиторийНастроек.ПутьКаталогаВида(ПараметрыРепозитория, Вид);
		ФайлыРепозитория = РепозиторийНастроек.СписокФайлов(ПараметрыРепозитория, КаталогВида, Коммит);
		Сообщить(КаталогВида + ": файлов " + Строка(ФайлыРепозитория.Количество()));
	КонецЦикла;

	ПутьФайла = НастройкиПроекта.ТекстЗначения(Параметры.ПутьФайла);
	Если ЗначениеЗаполнено(ПутьФайла) Тогда
		Текст = РепозиторийНастроек.ПрочитатьФайлРепозитория(ПараметрыРепозитория, ПутьФайла, Коммит);
		Данные = ПрочитатьJSON(Текст);
		Ключи = Новый Массив;
		Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
			Для Каждого Элемент Из Данные Цикл
				Ключи.Добавить(Элемент.Ключ);
			КонецЦикла;
		КонецЕсли;
		Сообщить(ПутьФайла + ": символов " + Строка(СтрДлина(Текст)) + ", ключи JSON: " + СтрСоединить(Ключи, ", "));
	КонецЕсли;

КонецПроцедуры
