// Клиент HTTP API fastex к базам 1С:Предприятие 8.

// Выполняет запрос языка 1С в базе источника (fastex doquery).
// Возвращает массив соответствий. Колонка-ссылка Х приходит от fastex тройкой
// ХИдентификатор, ХТип, ХПредставление; в строке результата Х получает УИД объекта.
Функция ВыполнитьЗапрос(Источник, ТекстЗапроса) Экспорт

	НастройкиИсточника = НастройкиИсточника(Источник);
	Если НастройкиИсточника.Тип <> "Fastex1С8" Тогда
		ВызватьИсключение "Тип источника " + НастройкиИсточника.Тип + " пока не поддерживается";
	КонецЕсли;

	Адрес = РазобратьАдрес(НастройкиИсточника.АдресПубликации);
	Пароль = ЗначениеСекрета(НастройкиИсточника.СекретПароля);

	Соединение = Новый HTTPСоединение(Адрес.Хост, Адрес.Порт, Адрес.Защищенное, 600);
	ЗапросHTTP = Новый HTTPЗапрос(Адрес.Путь + "/hs/fastex/service/doquery");
	ЗапросHTTP.УстановитьЗаголовок("Authorization",
		"Basic " + Base64Строка(НастройкиИсточника.Пользователь + ":" + Пароль));
	ЗапросHTTP.УстановитьЗаголовок("Content-Type", "application/json; charset=utf-8");

	ТелоЗапроса = Новый Соответствие;
	ТелоЗапроса.Вставить("query", ТекстЗапроса);
	ЗапросHTTP.УстановитьТелоИзСтроки(ЗаписатьJSON(ТелоЗапроса));

	Ответ = Соединение.ОтправитьДля(ЗапросHTTP, "POST");
	ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "fastex ответил " + Строка(Ответ.КодСостояния) + ": " + Лев(ТекстОтвета, 1000);
	КонецЕсли;

	Данные = РазвернутьОтвет(ПрочитатьJSON(ТекстОтвета));
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		ВызватьИсключение "fastex вернул не массив строк: " + Лев(ТекстОтвета, 1000);
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого СтрокаОтвета Из Данные Цикл
		Результат.Добавить(ПривестиСсылки(СтрокаОтвета));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Значение пароля по ссылке на секрет. Поддержана ссылка file:<путь к файлу>.
Функция ЗначениеСекрета(СсылкаНаСекрет) Экспорт

	Ссылка = СокрЛП(СсылкаНаСекрет);
	Если СтрНачинаетсяС(Ссылка, "file:") Тогда
		ЧтениеФайла = Новый ЧтениеТекста(Сред(Ссылка, 6));
		ЧтениеФайла.Открыть();
		Значение = ЧтениеФайла.Прочитать();
		ЧтениеФайла.Закрыть();
		Возврат СокрЛП(Значение);
	КонецЕсли;

	ВызватьИсключение "Неподдерживаемая ссылка на секрет. Ожидается file:<путь к файлу>";

КонецФункции

Функция НастройкиИсточника(Источник)

	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст = "ВЫБРАТЬ Тип, АдресПубликации, Пользователь, СекретПароля
		|ИЗ Справочник.Источники
		|ГДЕ Ссылка = &Источник";
	ЗапросДанных.УстановитьПараметр("Источник", Источник);
	Выборка = ЗапросДанных.Выполнить();
	Если Выборка.Количество() = 0 Тогда
		ВызватьИсключение "Не найден источник " + Строка(Источник);
	КонецЕсли;

	Запись = Выборка.Получить(0);
	Результат = Новый Структура;
	Результат.Вставить("Тип", СтрокаЗначения(Запись.Тип));
	Результат.Вставить("АдресПубликации", СтрокаЗначения(Запись.АдресПубликации));
	Результат.Вставить("Пользователь", СтрокаЗначения(Запись.Пользователь));
	Результат.Вставить("СекретПароля", СтрокаЗначения(Запись.СекретПароля));

	Возврат Результат;

КонецФункции

// Разбирает адрес вида http://хост[:порт]/публикация.
Функция РазобратьАдрес(АдресПубликации)

	Адрес = СокрЛП(АдресПубликации);
	Защищенное = Ложь;
	Если СтрНачинаетсяС(НРег(Адрес), "https://") Тогда
		Защищенное = Истина;
		Адрес = Сред(Адрес, 9);
	ИначеЕсли СтрНачинаетсяС(НРег(Адрес), "http://") Тогда
		Адрес = Сред(Адрес, 8);
	КонецЕсли;
	Пока СтрЗаканчиваетсяНа(Адрес, "/") Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;

	ПозицияПути = СтрНайти(Адрес, "/");
	Если ПозицияПути = 0 Тогда
		ХостИПорт = Адрес;
		Путь = "";
	Иначе
		ХостИПорт = Лев(Адрес, ПозицияПути - 1);
		Путь = Сред(Адрес, ПозицияПути);
	КонецЕсли;

	Порт = ?(Защищенное, 443, 80);
	ПозицияПорта = СтрНайти(ХостИПорт, ":");
	Хост = ХостИПорт;
	Если ПозицияПорта > 0 Тогда
		Хост = Лев(ХостИПорт, ПозицияПорта - 1);
		Порт = Число(Сред(ХостИПорт, ПозицияПорта + 1));
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Хост", Хост);
	Результат.Вставить("Порт", Порт);
	Результат.Вставить("Защищенное", Защищенное);
	Результат.Вставить("Путь", Путь);

	Возврат Результат;

КонецФункции

// Снимает обертку {"#type": ..., "#value": ...}, в которую 1С заворачивает строки.
Функция РазвернутьОтвет(Данные)

	Значение = Данные;
	Для Проход = 1 По 3 Цикл
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			Значение = ПрочитатьJSON(Значение);
		ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") И Значение.Получить("#value") <> Неопределено Тогда
			Значение = Значение.Получить("#value");
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Значение;

КонецФункции

Функция ПривестиСсылки(СтрокаОтвета)

	Результат = Новый Соответствие;
	Для Каждого Колонка Из СтрокаОтвета Цикл
		Результат.Вставить(Колонка.Ключ, Колонка.Значение);
	КонецЦикла;

	Для Каждого Колонка Из СтрокаОтвета Цикл
		Если СтрЗаканчиваетсяНа(Колонка.Ключ, "Идентификатор") Тогда
			ИмяКолонки = Лев(Колонка.Ключ, СтрДлина(Колонка.Ключ) - СтрДлина("Идентификатор"));
			Если ЗначениеЗаполнено(ИмяКолонки) И СтрокаОтвета.Получить(ИмяКолонки + "Тип") <> Неопределено Тогда
				Результат.Вставить(ИмяКолонки, Колонка.Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СтрокаЗначения(Значение)

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции
