// Клиент HTTP API fastex к базам 1С:Предприятие 8.

// Выборка стороны сверки по типу источника. Для 1С 8 ТекстЗапроса - запрос языка 1С,
// для 7.7 - описание оборотно-сальдовой ведомости (см. ОписаниеВыборки77).
Функция ВыполнитьВыборку(Источник, ТекстЗапроса, НачалоПериода, КонецПериода) Экспорт

	НастройкиИсточника = НастройкиИсточника(Источник);
	Если НастройкиИсточника.Тип = "Fastex77ЧерезБазу1С8" Тогда
		Возврат ВыполнитьВыборку77(НастройкиИсточника, ТекстЗапроса, НачалоПериода, КонецПериода);
	КонецЕсли;

	Возврат ВыполнитьЗапрос(Источник, ТекстЗапроса);

КонецФункции

// Выполняет запрос языка 1С в базе источника (fastex doquery).
// Возвращает массив соответствий. Колонка-ссылка Х приходит от fastex тройкой
// ХИдентификатор, ХТип, ХПредставление; в строке результата Х получает УИД объекта.
Функция ВыполнитьЗапрос(Источник, ТекстЗапроса) Экспорт

	НастройкиИсточника = НастройкиИсточника(Источник);
	ТелоЗапроса = Новый Соответствие;
	ТелоЗапроса.Вставить("query", ТекстЗапроса);
	Ответ = ОтправитьЗапрос(НастройкиИсточника, "POST", "/hs/fastex/service/doquery", ЗаписатьJSON(ТелоЗапроса), 600);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "fastex doquery ответил " + Строка(Ответ.КодСостояния) + ": " + Лев(Ответ.Текст, 1000);
	КонецЕсли;

	Возврат СтрокиИзОтвета(Ответ.Текст);

КонецФункции

// Выполняет фрагмент кода 1С в фоне через fastex doasync и ждет результат опросом status.
// Фрагмент кладет итог в переменную Результат, как у service/do. Возвращает развернутое значение.
Функция ВыполнитьКодАсинхронно(НастройкиИсточника, Код, Наименование, МаксимумСекунд) Экспорт

	ТелоЗапроса = Новый Соответствие;
	ТелоЗапроса.Вставить("code", Код);
	ТелоЗапроса.Вставить("name", Наименование);
	ТелоЗапроса.Вставить("keephours", 2);
	Ответ = ОтправитьЗапрос(НастройкиИсточника, "POST", "/hs/fastex/service/doasync", ЗаписатьJSON(ТелоЗапроса), 60);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "fastex doasync ответил " + Строка(Ответ.КодСостояния) + ": " + Лев(Ответ.Текст, 1000);
	КонецЕсли;
	ИдЗадания = РазвернутьОтвет(ПрочитатьJSON(Ответ.Текст)).Получить("id");
	Если Не ЗначениеЗаполнено(ИдЗадания) Тогда
		ВызватьИсключение "fastex doasync не вернул id задания: " + Лев(Ответ.Текст, 1000);
	КонецЕсли;

	Начало = ТекущаяДатаВремя();
	Пауза = 1;
	Пока Истина Цикл
		Ответ = ОтправитьЗапрос(НастройкиИсточника, "GET", "/hs/fastex/service/status?id=" + ИдЗадания, "", 60);
		Если Ответ.КодСостояния <> 200 Тогда
			ВызватьИсключение "fastex status ответил " + Строка(Ответ.КодСостояния) + ": " + Лев(Ответ.Текст, 1000);
		КонецЕсли;
		Состояние = РазвернутьОтвет(ПрочитатьJSON(Ответ.Текст));
		Если Состояние.Получить("done") = Истина Тогда
			Прервать;
		КонецЕсли;
		Если ТекущаяДатаВремя() - Начало > МаксимумСекунд Тогда
			ОтправитьЗапрос(НастройкиИсточника, "POST", "/hs/fastex/service/cancel?id=" + ИдЗадания, "", 60);
			ВызватьИсключение "Задание fastex " + ИдЗадания + " не завершилось за " + Строка(МаксимумСекунд) + " с";
		КонецЕсли;
		Приостановить(Пауза);
		Пауза = Мин(Пауза * 2, 15);
	КонецЦикла;

	Ответ = ОтправитьЗапрос(НастройкиИсточника, "GET", "/hs/fastex/service/result?id=" + ИдЗадания + "&drop=true", "", 600);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "Задание fastex " + ИдЗадания + " завершилось с ошибкой ("
			+ Строка(Ответ.КодСостояния) + "): " + Лев(Ответ.Текст, 2000);
	КонецЕсли;

	Возврат РазвернутьОтвет(ПрочитатьJSON(Ответ.Текст));

КонецФункции

// Безвредная проверка механики doasync, status и result: фрагмент без обращения к данным.
Функция ПроверитьФоновыйВызов(Источник) Экспорт

	Код = "Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку();" + Символы.ПС
		+ "Строки = Новый Массив; Строки.Добавить(Новый Структура(""Ключ, Сумма"", ""проверка"", 1.5));" + Символы.ПС
		+ "ЗаписатьJSON(Запись, Строки); Результат = Запись.Закрыть();";

	Возврат ВыполнитьКодАсинхронно(НастройкиИсточника(Источник), Код, "sverka: проверка фонового вызова", 120);

КонецФункции

// Оборотно-сальдовая ведомость 7.7 через COM на сервере базы 1С 8 источника.
// Учетка 7.7 читается фрагментом из хранилища общих настроек базы 8 (КлючУчетки77),
// поэтому пароль не попадает ни в текст кода, ни в описание задания fastex.
Функция ВыполнитьВыборку77(НастройкиИсточника, ТекстОписания, НачалоПериода, КонецПериода) Экспорт

	Описание = ОписаниеВыборки77(ТекстОписания);
	Код = ТекстФрагмента77(Описание, НачалоПериода, КонецПериода);
	Данные = ВыполнитьКодАсинхронно(НастройкиИсточника, Код, "sverka: ОСВ 7.7 по счету " + Описание.Получить("Счет"), 3600);
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		ВызватьИсключение "Выборка 7.7 вернула не массив строк";
	КонецЕсли;

	Возврат Данные;

КонецФункции

// Описание выборки 7.7 - строки «Имя = Значение»: Счет (код счета 7.7), ВидСубконто
// (идентификатор вида субконто 7.7). Пример: Счет = 60 / ВидСубконто = Контрагенты.
Функция ОписаниеВыборки77(ТекстОписания) Экспорт

	Описание = Новый Соответствие;
	Для НомерСтроки = 1 По СтрЧислоСтрок(ТекстОписания) Цикл
		СтрокаОписания = СтрПолучитьСтроку(ТекстОписания, НомерСтроки);
		ПозицияРавно = СтрНайти(СтрокаОписания, "=");
		Если ПозицияРавно > 0 Тогда
			Описание.Вставить(СокрЛП(Лев(СтрокаОписания, ПозицияРавно - 1)), СокрЛП(Сред(СтрокаОписания, ПозицияРавно + 1)));
		КонецЕсли;
	КонецЦикла;

	Для Каждого ИмяПараметра Из СтрРазделить("Счет,ВидСубконто", ",") Цикл
		Если Не ЗначениеЗаполнено(Описание.Получить(ИмяПараметра)) Тогда
			ВызватьИсключение "В описании выборки 7.7 не задан параметр " + ИмяПараметра;
		КонецЕсли;
	КонецЦикла;

	Возврат Описание;

КонецФункции

// Ключ хранилища общих настроек базы 8, где лежит учетка 7.7: структура Логин, Пароль,
// сохраненная для пользователя, под которым движок ходит в fastex.
Функция КлючУчетки77() Экспорт
	Возврат "sverka.Учетка77";
КонецФункции

// Текст фрагмента кода 1С 8 для fastex doasync. Колонки строк: Субконто (УИД объекта 8, либо
// IDD:<код 7.7>, если объект не найден), СубконтоПредставление, СНД, СНК, ДО, КО, СКД, СКК,
// СальдоНачальное (СНД - СНК), СальдоКонечное (СКД - СКК).
Функция ТекстФрагмента77(Описание, НачалоПериода, КонецПериода) Экспорт

	Строки = Новый Массив;
	Строки.Добавить("СоединениеСемь = Неопределено; Итоги = Неопределено; ТекстОшибки = """"; Строки = Новый Массив;");
	Строки.Добавить("Попытка");
	Строки.Добавить("Учетка = ХранилищеОбщихНастроек.Загрузить(""" + КлючУчетки77() + """, ""Учетка"");");
	Строки.Добавить("Если ТипЗнч(Учетка) <> Тип(""Структура"") Тогда ВызватьИсключение ""Нет учетки 7.7 в хранилище общих настроек (" + КлючУчетки77() + ")""; КонецЕсли;");
	Строки.Добавить("КаталогБазы = СокрЛП(Справочники.КонстантыУчета.УзелОбменаПоУмолчанию.Значение.КаталогБазы77);");
	Строки.Добавить("Кавычка = Символ(34);");
	Строки.Добавить("СтрокаЗапуска = "" /d"" + Кавычка + КаталогБазы + Кавычка + "" /N"" + Кавычка + Учетка.Логин + Кавычка + "" /P"" + Кавычка + Учетка.Пароль + Кавычка;");
	Строки.Добавить("Учетка = Неопределено;");
	Строки.Добавить("СоединениеСемь = Новый COMОбъект(""V77.Application"");");
	Строки.Добавить("Если НЕ СоединениеСемь.Initialize(СоединениеСемь.RMTrade, СтрокаЗапуска, ""NO_SPLASH_SHOW"") Тогда ВызватьИсключение ""Не удалось подключиться к базе 7.7""; КонецЕсли;");
	Строки.Добавить("СтрокаЗапуска = """";");
	Строки.Добавить("Итоги = СоединениеСемь.CreateObject(""БухгалтерскиеИтоги"");");
	Строки.Добавить("Итоги.ИспользоватьПланСчетов(СоединениеСемь.ПланыСчетов.ЗначениеПоНомеру(1));");
	Строки.Добавить("Итоги.ИспользоватьСубконто(СоединениеСемь.ВидыСубконто.ЗначениеПоИдентификатору("""
		+ ЛитералСтроки(Описание.Получить("ВидСубконто")) + """), """", 1);");
	Строки.Добавить("Итоги.ВыполнитьЗапрос(""" + ДатаСемь(НачалоПериода) + """, """ + ДатаСемь(КонецПериода) + """, """
		+ ЛитералСтроки(Описание.Получить("Счет")) + """, """", """", 1, 0, ""СК"");");
	Строки.Добавить("Итоги.ВыбратьСубконто(1);");
	Строки.Добавить("Пока Итоги.ПолучитьСубконто(1) = 1 Цикл");
	Строки.Добавить("ЗначениеСубконто = Итоги.Субконто(1);");
	Строки.Добавить("ИДД = СокрЛП(ЗначениеСубконто.IDD);");
	Строки.Добавить("СсылкаВосемь = ПереходС77.ПолучитьСсылкуПоИдентификатору(ИДД, , Ложь);");
	Строки.Добавить("СтрокаИтогов = Новый Структура;");
	Строки.Добавить("СтрокаИтогов.Вставить(""Субконто"", ?(ЗначениеЗаполнено(СсылкаВосемь), Строка(СсылкаВосемь.УникальныйИдентификатор()), ""IDD:"" + ИДД));");
	Строки.Добавить("СтрокаИтогов.Вставить(""СубконтоПредставление"", СокрЛП(ЗначениеСубконто.Наименование));");
	Строки.Добавить("СНД = Итоги.СНД(""С""); СНК = Итоги.СНК(""С""); СКД = Итоги.СКД(""С""); СКК = Итоги.СКК(""С"");");
	Строки.Добавить("СтрокаИтогов.Вставить(""СНД"", СНД); СтрокаИтогов.Вставить(""СНК"", СНК);");
	Строки.Добавить("СтрокаИтогов.Вставить(""ДО"", Итоги.ДО(""С"")); СтрокаИтогов.Вставить(""КО"", Итоги.КО(""С""));");
	Строки.Добавить("СтрокаИтогов.Вставить(""СКД"", СКД); СтрокаИтогов.Вставить(""СКК"", СКК);");
	Строки.Добавить("СтрокаИтогов.Вставить(""СальдоНачальное"", СНД - СНК); СтрокаИтогов.Вставить(""СальдоКонечное"", СКД - СКК);");
	Строки.Добавить("Строки.Добавить(СтрокаИтогов);");
	Строки.Добавить("КонецЦикла;");
	Строки.Добавить("Исключение");
	Строки.Добавить("ТекстОшибки = ОписаниеОшибки();");
	Строки.Добавить("КонецПопытки;");
	Строки.Добавить("ЗначениеСубконто = Неопределено; Итоги = Неопределено; СоединениеСемь = Неопределено;");
	Строки.Добавить("Если ТекстОшибки <> """" Тогда ВызватьИсключение ТекстОшибки; КонецЕсли;");
	Строки.Добавить("Запись = Новый ЗаписьJSON; Запись.УстановитьСтроку(); ЗаписатьJSON(Запись, Строки); Результат = Запись.Закрыть();");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Дата для БухгалтерскиеИтоги 7.7: строка дд.мм.гггг.
Функция ДатаСемь(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		ВызватьИсключение "Для выборки 7.7 нужны обе даты периода";
	КонецЕсли;

	Возврат Прав("0" + Строка(День(Значение)), 2) + "." + Прав("0" + Строка(Месяц(Значение)), 2) + "." + Строка(Год(Значение));

КонецФункции

Функция ЛитералСтроки(Значение)
	Возврат СтрЗаменить(СтрЗаменить(Строка(Значение), """", """"""), Символы.ПС, " ");
КонецФункции

// Отправляет запрос к публикации источника. Возвращает структуру КодСостояния, Текст.
Функция ОтправитьЗапрос(НастройкиИсточника, Метод, Ресурс, Тело, ТаймаутСекунд)

	Адрес = РазобратьАдрес(НастройкиИсточника.АдресПубликации);
	Пароль = ЗначениеСекрета(НастройкиИсточника.СекретПароля);

	Соединение = Новый HTTPСоединение(Адрес.Хост, Адрес.Порт, Адрес.Защищенное, ТаймаутСекунд);
	ЗапросHTTP = Новый HTTPЗапрос(Адрес.Путь + Ресурс);
	ЗапросHTTP.УстановитьЗаголовок("Authorization",
		"Basic " + Base64Строка(НастройкиИсточника.Пользователь + ":" + Пароль));
	Если ЗначениеЗаполнено(Тело) Тогда
		ЗапросHTTP.УстановитьЗаголовок("Content-Type", "application/json; charset=utf-8");
		ЗапросHTTP.УстановитьТелоИзСтроки(Тело);
	КонецЕсли;

	Ответ = Соединение.ОтправитьДля(ЗапросHTTP, Метод);

	Результат = Новый Структура;
	Результат.Вставить("КодСостояния", Ответ.КодСостояния);
	Результат.Вставить("Текст", Ответ.ПолучитьТелоКакСтроку());

	Возврат Результат;

КонецФункции

Функция СтрокиИзОтвета(ТекстОтвета)

	Данные = РазвернутьОтвет(ПрочитатьJSON(ТекстОтвета));
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		ВызватьИсключение "fastex вернул не массив строк: " + Лев(ТекстОтвета, 1000);
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого СтрокаОтвета Из Данные Цикл
		Результат.Добавить(ПривестиСсылки(СтрокаОтвета));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Значение пароля по ссылке на секрет. Поддержана ссылка file:<путь к файлу>.
// На стенде файл лежит вне каталога проекта: Linux /etc/sverka/secrets/<источник>.secret,
// владелец root, группа службы onebase, права 0640, каталог 0750; Windows
// C:\ProgramData\sverka\secrets, чтение только учетной записи службы и Administrators.
Функция ЗначениеСекрета(СсылкаНаСекрет) Экспорт

	Ссылка = СокрЛП(СсылкаНаСекрет);
	Если СтрНачинаетсяС(Ссылка, "file:") Тогда
		ЧтениеФайла = Новый ЧтениеТекста(Сред(Ссылка, 6));
		ЧтениеФайла.Открыть();
		Значение = ЧтениеФайла.Прочитать();
		ЧтениеФайла.Закрыть();
		Возврат СокрЛП(Значение);
	КонецЕсли;

	ВызватьИсключение "Неподдерживаемая ссылка на секрет. Ожидается file:<путь к файлу>";

КонецФункции

Функция НастройкиИсточника(Источник) Экспорт

	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст = "ВЫБРАТЬ Тип, АдресПубликации, Пользователь, СекретПароля
		|ИЗ Справочник.Источники
		|ГДЕ Ссылка = &Источник";
	ЗапросДанных.УстановитьПараметр("Источник", Источник);
	Выборка = ЗапросДанных.Выполнить();
	Если Выборка.Количество() = 0 Тогда
		ВызватьИсключение "Не найден источник " + Строка(Источник);
	КонецЕсли;

	Запись = Выборка.Получить(0);
	Результат = Новый Структура;
	Результат.Вставить("Тип", СтрокаЗначения(Запись.Тип));
	Результат.Вставить("АдресПубликации", СтрокаЗначения(Запись.АдресПубликации));
	Результат.Вставить("Пользователь", СтрокаЗначения(Запись.Пользователь));
	Результат.Вставить("СекретПароля", СтрокаЗначения(Запись.СекретПароля));

	Возврат Результат;

КонецФункции

// Разбирает адрес вида http://хост[:порт]/публикация.
Функция РазобратьАдрес(АдресПубликации)

	Адрес = СокрЛП(АдресПубликации);
	Защищенное = Ложь;
	Если СтрНачинаетсяС(НРег(Адрес), "https://") Тогда
		Защищенное = Истина;
		Адрес = Сред(Адрес, 9);
	ИначеЕсли СтрНачинаетсяС(НРег(Адрес), "http://") Тогда
		Адрес = Сред(Адрес, 8);
	КонецЕсли;
	Пока СтрЗаканчиваетсяНа(Адрес, "/") Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;

	ПозицияПути = СтрНайти(Адрес, "/");
	Если ПозицияПути = 0 Тогда
		ХостИПорт = Адрес;
		Путь = "";
	Иначе
		ХостИПорт = Лев(Адрес, ПозицияПути - 1);
		Путь = Сред(Адрес, ПозицияПути);
	КонецЕсли;

	Порт = ?(Защищенное, 443, 80);
	ПозицияПорта = СтрНайти(ХостИПорт, ":");
	Хост = ХостИПорт;
	Если ПозицияПорта > 0 Тогда
		Хост = Лев(ХостИПорт, ПозицияПорта - 1);
		Порт = Число(Сред(ХостИПорт, ПозицияПорта + 1));
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Хост", Хост);
	Результат.Вставить("Порт", Порт);
	Результат.Вставить("Защищенное", Защищенное);
	Результат.Вставить("Путь", Путь);

	Возврат Результат;

КонецФункции

// Снимает обертку {"#type": ..., "#value": ...}, в которую 1С заворачивает строки.
Функция РазвернутьОтвет(Данные)

	Значение = Данные;
	Для Проход = 1 По 3 Цикл
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			Значение = ПрочитатьJSON(Значение);
		ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") И Значение.Получить("#value") <> Неопределено Тогда
			Значение = Значение.Получить("#value");
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Значение;

КонецФункции

Функция ПривестиСсылки(СтрокаОтвета)

	Результат = Новый Соответствие;
	Для Каждого Колонка Из СтрокаОтвета Цикл
		Результат.Вставить(Колонка.Ключ, Колонка.Значение);
	КонецЦикла;

	Для Каждого Колонка Из СтрокаОтвета Цикл
		Если СтрЗаканчиваетсяНа(Колонка.Ключ, "Идентификатор") Тогда
			ИмяКолонки = Лев(Колонка.Ключ, СтрДлина(Колонка.Ключ) - СтрДлина("Идентификатор"));
			Если ЗначениеЗаполнено(ИмяКолонки) И СтрокаОтвета.Получить(ИмяКолонки + "Тип") <> Неопределено Тогда
				Результат.Вставить(ИмяКолонки, Колонка.Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СтрокаЗначения(Значение)

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции
