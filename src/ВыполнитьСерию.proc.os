// Серия сверок из интерфейса, командой onebase procrun или задачей очереди (параметр НомерСерии).
// Печатает сводку текстом и JSON.
Процедура Выполнить() Экспорт

	Если ЗначениеЗаполнено(Параметры.НомерСерии) Тогда
		СерияОбъект = СерииСверок.НайтиСерию(Параметры.НомерСерии);
		Если СерияОбъект = Неопределено Тогда
			ВызватьИсключение "Не найдена серия сверок " + Параметры.НомерСерии;
		КонецЕсли;
	Иначе
		СерияОбъект = СерииСверок.СоздатьСерию(Параметры.ИмяПроекта, Параметры.ИменаНастроек,
			Параметры.НачалоПериода, Параметры.КонецПериода, Параметры.Шаг, Параметры.Перечитать = Истина);
		Если Параметры.Фоном = Истина Тогда
			Попытка
				ИдЗадачи = СерииСверок.ПоставитьВОчередь(СерияОбъект);
			Исключение
				ТекстОшибки = ОписаниеОшибки();
				СерияОбъект.Состояние = "Ошибка";
				СерияОбъект.ТекстОшибки = ТекстОшибки;
				СерииСверок.ОбновитьСводку(СерияОбъект);
				СерияОбъект.Записать();
				ВызватьИсключение ТекстОшибки;
			КонецПопытки;
			Сообщить("Серия " + СерияОбъект.Номер + " поставлена в очередь, задача " + ИдЗадачи);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	СерииСверок.ВыполнитьСерию(СерияОбъект);
	Сообщить(СерияОбъект.ТекстСводки);
	Сообщить(ЗаписатьJSON(СерииСверок.ИтогСерии(СерияОбъект)));

КонецПроцедуры
