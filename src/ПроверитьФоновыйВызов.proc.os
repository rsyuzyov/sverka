// Проверка механики fastex doasync, status и result на безвредном фрагменте.
// Флаг ПроверитьУтечкуПароля - проверка, что пароль из фрагмента 7.7 не попадает в текст ошибки.
// С описанием выборки 7.7 дополнительно компилирует фрагмент 7.7 в базе 1С 8, не выполняя его.
Процедура Выполнить() Экспорт

	Источник = Справочники.Источники.НайтиПоНаименованию(Параметры.ИмяИсточника);
	Если Источник = Неопределено Тогда
		ВызватьИсключение "Не найден источник " + Параметры.ИмяИсточника;
	КонецЕсли;

	Начало = ТекущаяДатаВремя();
	Результат = ФастексКлиент.ПроверитьФоновыйВызов(Источник);
	Сообщить("Секунд: " + Строка(ТекущаяДатаВремя() - Начало) + "; результат: " + ЗаписатьJSON(Результат));

	Если Параметры.ПроверитьУтечкуПароля = Истина Тогда
		Сообщить(ФастексКлиент.ПроверитьУтечкуПароля(Источник));
	КонецЕсли;

	Если ЗначениеЗаполнено(Параметры.ОписаниеВыборки77) Тогда
		ТекстОписания = СтрЗаменить(Параметры.ОписаниеВыборки77, ";", Символы.ПС);
		Сообщить(ФастексКлиент.ПроверитьСинтаксисФрагмента77(Источник, ТекстОписания));
	КонецЕсли;

КонецПроцедуры
