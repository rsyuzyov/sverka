// Запуск сверки из интерфейса или командой onebase procrun. Печатает итог в JSON.
Процедура Выполнить() Экспорт

	ЗапускОбъект = СверкаДанных.ВыполнитьСверкуПоИмени(Параметры.ИмяНастройки,
		Параметры.НачалоПериода, Параметры.КонецПериода, Параметры.Перечитать = Истина,
		НастройкиПроекта.ТекстЗначения(Параметры.ИмяПроекта));
	Сообщить(ЗаписатьJSON(СверкаДанных.ИтогЗапуска(ЗапускОбъект, 100)));

КонецПроцедуры
