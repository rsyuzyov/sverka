// Синхронизация настроек проекта сверки с git-репозиторием на Forgejo через HTTP API (contents API);
// git на сервере не нужен. Файлы и их формат - модуль НастройкиПроекта.
//
// Получение: снимок ветки на ее текущем коммите; файл, чей sha не менялся с прошлой синхронизации,
// не читается. Объект базы, измененный после прошлой синхронизации, не затирается - конфликт.
// Отправка: одним коммитом (POST /contents); файл, измененный в репозитории после прошлого
// получения (sha не совпал с запомненным), не перезаписывается - конфликт. Тот же sha передается
// в API, и Forgejo сам отклоняет обновление, если файл успели поменять между проверкой и записью.
// Удаление объектов не синхронизируется: расхождения попадают в заметки итога.
// Состояние файлов (sha и содержимое на момент синхронизации) - регистр СостояниеСинхронизации.

Функция ДействиеПолучить() Экспорт
	Возврат "получить";
КонецФункции

Функция ДействиеОтправить() Экспорт
	Возврат "отправить";
КонецФункции

// --- Точки входа ---

// Синхронизация проекта по имени: Действие - «получить» или «отправить». Возвращает итог (Соответствие).
Функция Синхронизировать(ИмяПроекта, Действие, ЗаменятьЛокальные = Ложь) Экспорт

	Если Не ЗначениеЗаполнено(ИмяПроекта) Тогда
		ВызватьИсключение "Не задан проект сверки";
	КонецЕсли;
	Проект = НастройкиПроекта.НайтиПроект(ИмяПроекта);
	Если Действие = ДействиеПолучить() Тогда
		Возврат ПолучитьИзРепозитория(Проект, ЗаменятьЛокальные = Истина);
	ИначеЕсли Действие = ДействиеОтправить() Тогда
		Возврат ОтправитьВРепозиторий(Проект);
	КонецЕсли;

	ВызватьИсключение "Неизвестное действие синхронизации «" + Строка(Действие) + "»: ожидается «получить» или «отправить»";

КонецФункции

// Получает источники и настройки проекта из репозитория и заводит или обновляет их в базе по наименованию.
// ЗаменятьЛокальные - при конфликте брать версию репозитория (локальные правки теряются).
Функция ПолучитьИзРепозитория(Проект, ЗаменятьЛокальные = Ложь) Экспорт

	Параметры = ПараметрыРепозитория(Проект);
	Коммит = КоммитВетки(Параметры);
	Состояния = ПрочитатьСостояния(Проект);
	Итог = НовыйИтог(Параметры, ДействиеПолучить());
	Итог.Вставить("коммит", Коммит);

	// Источники раньше настроек: настройка ссылается на источник по наименованию.
	Для Каждого Вид Из СтрРазделить(НастройкиПроекта.ВидИсточник() + "," + НастройкиПроекта.ВидНастройка(), ",") Цикл
		КаталогВида = ПутьКаталогаВида(Параметры, Вид);
		ФайлыРепозитория = СписокФайлов(Параметры, КаталогВида, Коммит);
		Для Каждого ФайлРепозитория Из ФайлыРепозитория Цикл
			Попытка
				ПолучитьФайл(Параметры, Проект, Вид, ФайлРепозитория.Ключ, ФайлРепозитория.Значение, Коммит,
					Состояния.Получить(ФайлРепозитория.Ключ), ЗаменятьЛокальные, Итог);
			Исключение
				ДобавитьКонфликт(Итог, ФайлРепозитория.Ключ, ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
		ОтметитьОбъектыТолькоВБазе(Параметры, Проект, Вид, ФайлыРепозитория, Состояния, Итог);
	КонецЦикла;

	ЗавершитьСинхронизацию(Проект, Коммит, Итог);

	Возврат Итог;

КонецФункции

// Отправляет источники и настройки проекта в репозиторий одним коммитом.
Функция ОтправитьВРепозиторий(Проект) Экспорт

	Параметры = ПараметрыРепозитория(Проект);
	Коммит = КоммитВетки(Параметры);
	Состояния = ПрочитатьСостояния(Проект);
	Итог = НовыйИтог(Параметры, ДействиеОтправить());
	Итог.Вставить("коммит", Коммит);

	Операции = Новый Массив;
	ОтправляемыеТексты = Новый Соответствие;
	ПутиОбъектов = Новый Соответствие;

	Для Каждого Вид Из СтрРазделить(НастройкиПроекта.ВидИсточник() + "," + НастройкиПроекта.ВидНастройка(), ",") Цикл
		КаталогВида = ПутьКаталогаВида(Параметры, Вид);
		ФайлыРепозитория = СписокФайлов(Параметры, КаталогВида, Коммит);

		Для Каждого Наименование Из НастройкиПроекта.НаименованияОбъектов(Вид, Проект) Цикл
			Попытка
				ПутьФайла = КаталогВида + "/" + НастройкиПроекта.ИмяФайла(Наименование);
				Если ПутиОбъектов.Получить(ПутьФайла) <> Неопределено Тогда
					ВызватьИсключение "то же имя файла у «" + ПутиОбъектов.Получить(ПутьФайла) + "» и «" + Наименование
						+ "» - переименуйте один из объектов";
				КонецЕсли;
				ПутиОбъектов.Вставить(ПутьФайла, Наименование);

				ТекстЛокальный = НастройкиПроекта.ТекстФайлаОбъекта(Вид, Наименование, Проект);
				Состояние = Состояния.Получить(ПутьФайла);
				ShaВРепозитории = ФайлыРепозитория.Получить(ПутьФайла);
				Действие = ДействиеОтправки(Состояние, ShaВРепозитории, ТекстЛокальный);

				Если Действие = "создать" Или Действие = "обновить" Тогда
					Операция = Новый Соответствие;
					Операция.Вставить("operation", ?(Действие = "создать", "create", "update"));
					Операция.Вставить("path", ПутьФайла);
					Операция.Вставить("content", Base64Строка(ТекстЛокальный));
					Если Действие = "обновить" Тогда
						Операция.Вставить("sha", ShaВРепозитории);
					КонецЕсли;
					Операции.Добавить(Операция);
					ОтправляемыеТексты.Вставить(ПутьФайла, ТекстЛокальный);
				ИначеЕсли Действие = "без изменений" Тогда
					Итог.Вставить("безИзменений", Итог.Получить("безИзменений") + 1);
				ИначеЕсли Действие = "удален в репозитории" Тогда
					ДобавитьЗаметку(Итог, ПутьФайла + ": удален в репозитории после прошлой синхронизации - не отправляю"
						+ " (удаление пока не синхронизируется; удалите объект в базе или восстановите файл)");
				Иначе
					ДобавитьКонфликт(Итог, ПутьФайла, Действие);
				КонецЕсли;
			Исключение
				ДобавитьКонфликт(Итог, КаталогВида + "/" + Наименование, ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;

		Для Каждого ФайлРепозитория Из ФайлыРепозитория Цикл
			Если ПутиОбъектов.Получить(ФайлРепозитория.Ключ) = Неопределено Тогда
				ДобавитьЗаметку(Итог, ФайлРепозитория.Ключ + ": есть только в репозитории - получите или удалите файл");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если Операции.Количество() > 0 Тогда
		Попытка
			НовыйКоммит = ЗаписатьФайлы(Параметры, Операции, СообщениеКоммита(Параметры, Операции.Количество()));
		Исключение
			// Коммит атомарный: не принят - не записан ни один файл, состояние не трогаем.
			Для Каждого Операция Из Операции Цикл
				ДобавитьКонфликт(Итог, Операция.Получить("path"), "не отправлен: " + ОписаниеОшибки());
			КонецЦикла;
			ЗавершитьСинхронизацию(Проект, Коммит, Итог);
			Возврат Итог;
		КонецПопытки;
		Итог.Вставить("коммит", НовыйКоммит);
		Коммит = НовыйКоммит;
		// Новые sha файлов - из списка каталога на новом коммите: ответ API на изменение файлов
		// между версиями Forgejo различается, а список - нет.
		НовыеSha = Новый Соответствие;
		Для Каждого Вид Из СтрРазделить(НастройкиПроекта.ВидИсточник() + "," + НастройкиПроекта.ВидНастройка(), ",") Цикл
			Для Каждого ФайлРепозитория Из СписокФайлов(Параметры, ПутьКаталогаВида(Параметры, Вид), НовыйКоммит) Цикл
				НовыеSha.Вставить(ФайлРепозитория.Ключ, ФайлРепозитория.Значение);
			КонецЦикла;
		КонецЦикла;
		Для Каждого Операция Из Операции Цикл
			ПутьФайла = Операция.Получить("path");
			ЗаписатьСостояние(Проект, ПутьФайла, НовыеSha.Получить(ПутьФайла), ОтправляемыеТексты.Получить(ПутьФайла));
			Если Операция.Получить("operation") = "create" Тогда
				Итог.Получить("создано").Добавить(ПутьФайла);
			Иначе
				Итог.Получить("обновлено").Добавить(ПутьФайла);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ЗавершитьСинхронизацию(Проект, Коммит, Итог);

	Возврат Итог;

КонецФункции

// --- Решения по файлу (чистые функции, покрыты тестом ТестСинхронизацииНастроек) ---

// Что делать с объектом базы при отправке. Состояние - Структура(Sha, Содержимое) прошлой
// синхронизации или Неопределено; ShaВРепозитории - sha файла сейчас или Неопределено, если файла нет.
// Ответ: «создать», «обновить», «без изменений», «удален в репозитории» или текст конфликта.
Функция ДействиеОтправки(Состояние, ShaВРепозитории, ТекстЛокальный) Экспорт

	ФайлЕсть = ЗначениеЗаполнено(ShaВРепозитории);
	Если Состояние = Неопределено Тогда
		Если ФайлЕсть Тогда
			Возврат "конфликт: файл есть в репозитории, а получения не было - сначала получите";
		КонецЕсли;
		Возврат "создать";
	КонецЕсли;

	Если Не ФайлЕсть Тогда
		Возврат "удален в репозитории";
	КонецЕсли;

	ЛокальныйИзменен = (ТекстЛокальный <> Состояние.Содержимое);
	Если ShaВРепозитории <> Состояние.Sha Тогда
		Если ЛокальныйИзменен Тогда
			Возврат "конфликт: файл изменен в репозитории после прошлого получения - сначала получите";
		КонецЕсли;
		Возврат "конфликт: в репозитории новее - получите";
	КонецЕсли;

	Если ЛокальныйИзменен Тогда
		Возврат "обновить";
	КонецЕсли;

	Возврат "без изменений";

КонецФункции

// Что делать с файлом репозитория при получении (файл уже прочитан: его sha отличается от
// запомненного или состояния нет). ТекстЛокальный - Неопределено, если объекта в базе нет.
// Ответ: «создать», «совпадает», «обновить», «заменить» или текст конфликта.
Функция ДействиеПолучения(Состояние, ТекстЛокальный, ТекстРепозитория, ЗаменятьЛокальные) Экспорт

	Если ТекстЛокальный = Неопределено Тогда
		Возврат "создать";
	КонецЕсли;
	Если ТекстЛокальный = ТекстРепозитория Тогда
		Возврат "совпадает";
	КонецЕсли;
	Если Состояние <> Неопределено И ТекстЛокальный = Состояние.Содержимое Тогда
		Возврат "обновить";
	КонецЕсли;
	Если ЗаменятьЛокальные = Истина Тогда
		Возврат "заменить";
	КонецЕсли;
	Если Состояние = Неопределено Тогда
		Возврат "конфликт: объект есть в базе и отличается от репозитория, синхронизации еще не было"
			+ " (получите с заменой локальных или отправьте после сверки вручную)";
	КонецЕсли;

	Возврат "конфликт: изменен и в базе, и в репозитории после прошлой синхронизации";

КонецФункции

// --- Получение одного файла ---

Процедура ПолучитьФайл(Параметры, Проект, Вид, ПутьФайла, ShaВРепозитории, Коммит, Состояние, ЗаменятьЛокальные, Итог)

	Если Состояние <> Неопределено И Состояние.Sha = ShaВРепозитории Тогда
		Итог.Вставить("безИзменений", Итог.Получить("безИзменений") + 1);
		Возврат;
	КонецЕсли;

	Прочитанное = ПрочитатьJSON(ПрочитатьФайлРепозитория(Параметры, ПутьФайла, Коммит));
	Если ТипЗнч(Прочитанное) <> Тип("Соответствие") Тогда
		ВызватьИсключение "не JSON-объект";
	КонецЕсли;
	Наименование = НастройкиПроекта.ТекстЗначения(Прочитанное.Получить("наименование"));
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		ВызватьИсключение "в файле нет наименования";
	КонецЕсли;
	ОжидаемыйПуть = ПутьКаталогаВида(Параметры, Вид) + "/" + НастройкиПроекта.ИмяФайла(Наименование);
	Если ОжидаемыйПуть <> ПутьФайла Тогда
		ВызватьИсключение "имя файла не соответствует наименованию «" + Наименование + "» (ожидается " + ОжидаемыйПуть
			+ ") - переименуйте файл, иначе отправка создаст второй";
	КонецЕсли;

	ТекстРепозитория = НастройкиПроекта.ТекстФайла(НастройкиПроекта.КаноническоеОписание(Прочитанное, Вид));
	ТекстЛокальный = Неопределено;
	Если НастройкиПроекта.НайтиОбъект(Вид, Наименование, Проект) <> Неопределено Тогда
		ТекстЛокальный = НастройкиПроекта.ТекстФайлаОбъекта(Вид, Наименование, Проект);
	КонецЕсли;

	Действие = ДействиеПолучения(Состояние, ТекстЛокальный, ТекстРепозитория, ЗаменятьЛокальные);
	Если Действие = "совпадает" Тогда
		ЗаписатьСостояние(Проект, ПутьФайла, ShaВРепозитории, ТекстЛокальный);
		Итог.Вставить("безИзменений", Итог.Получить("безИзменений") + 1);
		Возврат;
	ИначеЕсли Действие <> "создать" И Действие <> "обновить" И Действие <> "заменить" Тогда
		ДобавитьКонфликт(Итог, ПутьФайла, Действие);
		Возврат;
	КонецЕсли;

	НастройкиПроекта.ЗаписатьОбъект(Вид, Прочитанное, Проект);
	// В состояние - текст объекта после записи: по нему отправка поймет, правили ли объект в базе.
	ЗаписатьСостояние(Проект, ПутьФайла, ShaВРепозитории, НастройкиПроекта.ТекстФайлаОбъекта(Вид, Наименование, Проект));
	Если Действие = "создать" Тогда
		Итог.Получить("создано").Добавить(ПутьФайла);
	Иначе
		Итог.Получить("обновлено").Добавить(ПутьФайла);
		Если Действие = "заменить" Тогда
			ДобавитьЗаметку(Итог, ПутьФайла + ": локальные правки заменены версией репозитория");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Объекты проекта, которых нет в репозитории: удаление не синхронизируется, только заметка.
Процедура ОтметитьОбъектыТолькоВБазе(Параметры, Проект, Вид, ФайлыРепозитория, Состояния, Итог)

	КаталогВида = ПутьКаталогаВида(Параметры, Вид);
	Для Каждого Наименование Из НастройкиПроекта.НаименованияОбъектов(Вид, Проект) Цикл
		ПутьФайла = КаталогВида + "/" + НастройкиПроекта.ИмяФайла(Наименование);
		Если ФайлыРепозитория.Получить(ПутьФайла) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Состояния.Получить(ПутьФайла) <> Неопределено Тогда
			ДобавитьЗаметку(Итог, ПутьФайла + ": удален в репозитории - объект «" + Наименование
				+ "» в базе оставлен (удаление пока не синхронизируется)");
		Иначе
			ДобавитьЗаметку(Итог, ПутьФайла + ": есть только в базе - отправьте");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// --- Итог ---

Функция НовыйИтог(Параметры, Действие)

	Итог = Новый Соответствие;
	Итог.Вставить("проект", Параметры.Наименование);
	Итог.Вставить("действие", Действие);
	Итог.Вставить("репозиторий", Параметры.Адрес);
	Итог.Вставить("ветка", Параметры.Ветка);
	Итог.Вставить("коммит", "");
	Итог.Вставить("создано", Новый Массив);
	Итог.Вставить("обновлено", Новый Массив);
	Итог.Вставить("безИзменений", 0);
	Итог.Вставить("конфликты", Новый Массив);
	Итог.Вставить("заметки", Новый Массив);

	Возврат Итог;

КонецФункции

Процедура ДобавитьКонфликт(Итог, ПутьФайла, Причина)

	Конфликт = Новый Соответствие;
	Конфликт.Вставить("путь", ПутьФайла);
	Конфликт.Вставить("причина", Причина);
	Итог.Получить("конфликты").Добавить(Конфликт);

КонецПроцедуры

Процедура ДобавитьЗаметку(Итог, Текст)
	Итог.Получить("заметки").Добавить(Текст);
КонецПроцедуры

// Краткий итог строкой - для реквизита проекта и вывода обработок.
Функция ТекстИтога(Итог) Экспорт

	Текст = Итог.Получить("действие") + ": создано " + Строка(Итог.Получить("создано").Количество())
		+ ", обновлено " + Строка(Итог.Получить("обновлено").Количество())
		+ ", без изменений " + Строка(Итог.Получить("безИзменений"))
		+ ", конфликтов " + Строка(Итог.Получить("конфликты").Количество())
		+ "; коммит " + Строка(Итог.Получить("коммит"));
	Для Каждого Конфликт Из Итог.Получить("конфликты") Цикл
		Текст = Текст + Символы.ПС + "конфликт " + Конфликт.Получить("путь") + ": " + Конфликт.Получить("причина");
	КонецЦикла;
	Для Каждого Заметка Из Итог.Получить("заметки") Цикл
		Текст = Текст + Символы.ПС + "заметка " + Заметка;
	КонецЦикла;

	Возврат Текст;

КонецФункции

Процедура ЗавершитьСинхронизацию(Проект, Коммит, Итог)

	ПроектОбъект = Проект.ПолучитьОбъект();
	ПроектОбъект.ДатаСинхронизации = ТекущаяДатаВремя();
	ПроектОбъект.КоммитСинхронизации = Коммит;
	ПроектОбъект.ИтогСинхронизации = ТекстИтога(Итог);
	ПроектОбъект.Записать();

КонецПроцедуры

// --- Состояние синхронизации ---

// Соответствие ПутьФайла -> Структура(Sha, Содержимое).
Функция ПрочитатьСостояния(Проект) Экспорт

	ЗапросСостояний = Новый Запрос;
	ЗапросСостояний.Текст = "ВЫБРАТЬ ПутьФайла, ShaФайла, Содержимое
		|ИЗ РегистрСведений.СостояниеСинхронизации
		|ГДЕ Проект = &Проект";
	ЗапросСостояний.УстановитьПараметр("Проект", Проект);

	Состояния = Новый Соответствие;
	Для Каждого Запись Из ЗапросСостояний.Выполнить() Цикл
		Состояния.Вставить(Запись.ПутьФайла, Новый Структура("Sha, Содержимое",
			НастройкиПроекта.ТекстЗначения(Запись.ShaФайла), НастройкиПроекта.ТекстЗначения(Запись.Содержимое)));
	КонецЦикла;

	Возврат Состояния;

КонецФункции

Процедура ЗаписатьСостояние(Проект, ПутьФайла, ShaФайла, Содержимое) Экспорт

	МенеджерЗаписи = РегистрыСведений.СостояниеСинхронизации.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Проект = Проект;
	МенеджерЗаписи.ПутьФайла = ПутьФайла;
	МенеджерЗаписи.ShaФайла = НастройкиПроекта.ТекстЗначения(ShaФайла);
	МенеджерЗаписи.Содержимое = Содержимое;
	МенеджерЗаписи.ДатаСинхронизации = ТекущаяДатаВремя();
	МенеджерЗаписи.Записать();

КонецПроцедуры

// --- Параметры репозитория проекта ---

// Структура: Наименование, Адрес, Ветка, Каталог, СекретТокена, Хост, Порт, Защищенное, ПутьAPI.
// Адрес - веб-адрес репозитория на Forgejo: https://хост[:порт][/префикс]/владелец/репозиторий[.git].
Функция ПараметрыРепозитория(Проект) Экспорт

	ЗапросПроекта = Новый Запрос;
	ЗапросПроекта.Текст = "ВЫБРАТЬ Наименование, АдресРепозитория, Ветка, КаталогВРепозитории, Синхронизировать, СекретТокена
		|ИЗ Справочник.ПроектыСверки
		|ГДЕ Ссылка = &Проект";
	ЗапросПроекта.УстановитьПараметр("Проект", Проект);
	Выборка = ЗапросПроекта.Выполнить();
	Если Выборка.Количество() = 0 Тогда
		ВызватьИсключение "Не найден проект сверки";
	КонецЕсли;
	Запись = Выборка.Получить(0);

	Параметры = Новый Структура;
	Параметры.Вставить("Наименование", Запись.Наименование);
	Если Запись.Синхронизировать <> Истина Тогда
		ВызватьИсключение "У проекта «" + Запись.Наименование + "» синхронизация с репозиторием выключена";
	КонецЕсли;
	Адрес = СокрЛП(НастройкиПроекта.ТекстЗначения(Запись.АдресРепозитория));
	Если Не ЗначениеЗаполнено(Адрес) Тогда
		ВызватьИсключение "У проекта «" + Запись.Наименование + "» не указан адрес репозитория";
	КонецЕсли;
	Параметры.Вставить("Адрес", Адрес);
	Ветка = СокрЛП(НастройкиПроекта.ТекстЗначения(Запись.Ветка));
	Параметры.Вставить("Ветка", ?(ЗначениеЗаполнено(Ветка), Ветка, "main"));
	Параметры.Вставить("Каталог", КаталогБезКрайнихРазделителей(НастройкиПроекта.ТекстЗначения(Запись.КаталогВРепозитории)));
	Параметры.Вставить("СекретТокена", НастройкиПроекта.ТекстЗначения(Запись.СекретТокена));
	Если Не ЗначениеЗаполнено(Параметры.СекретТокена) Тогда
		ВызватьИсключение "У проекта «" + Запись.Наименование + "» не указана ссылка на секрет с токеном API";
	КонецЕсли;

	// Поля переносятся по именам: «Для Каждого» по Структуре в onebase v0.12.0 не делает ни одного прохода.
	АдресРепозитория = РазобратьАдресРепозитория(Адрес);
	Параметры.Вставить("Хост", АдресРепозитория.Хост);
	Параметры.Вставить("Порт", АдресРепозитория.Порт);
	Параметры.Вставить("Защищенное", АдресРепозитория.Защищенное);
	Параметры.Вставить("ПутьAPI", АдресРепозитория.ПутьAPI);

	Возврат Параметры;

КонецФункции

// Разбирает веб-адрес репозитория Forgejo. Возвращает Структура(Хост, Порт, Защищенное, ПутьAPI).
Функция РазобратьАдресРепозитория(АдресРепозитория) Экспорт

	Адрес = СокрЛП(АдресРепозитория);
	Защищенное = Ложь;
	Если СтрНачинаетсяС(НРег(Адрес), "https://") Тогда
		Защищенное = Истина;
		Адрес = Сред(Адрес, 9);
	ИначеЕсли СтрНачинаетсяС(НРег(Адрес), "http://") Тогда
		Адрес = Сред(Адрес, 8);
	Иначе
		ВызватьИсключение "Адрес репозитория должен быть веб-адресом https://хост/владелец/репозиторий (адрес ssh для API не годится): "
			+ АдресРепозитория;
	КонецЕсли;
	Пока СтрЗаканчиваетсяНа(Адрес, "/") Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	Если СтрЗаканчиваетсяНа(НРег(Адрес), ".git") Тогда
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 4);
	КонецЕсли;

	ЧастиАдреса = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Адрес, "/") Цикл
		Если ЗначениеЗаполнено(Часть) Тогда
			ЧастиАдреса.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;
	Если ЧастиАдреса.Количество() < 3 Тогда
		ВызватьИсключение "В адресе репозитория нет владельца и имени репозитория: " + АдресРепозитория;
	КонецЕсли;

	ХостИПорт = ЧастиАдреса.Получить(0);
	Порт = ?(Защищенное, 443, 80);
	Хост = ХостИПорт;
	ПозицияПорта = СтрНайти(ХостИПорт, ":");
	Если ПозицияПорта > 0 Тогда
		Хост = Лев(ХостИПорт, ПозицияПорта - 1);
		Порт = Число(Сред(ХостИПорт, ПозицияПорта + 1));
	КонецЕсли;

	// Все между хостом и «владелец/репозиторий» - префикс, под которым опубликован Forgejo.
	ЧислоЧастей = ЧастиАдреса.Количество();
	Префикс = "";
	Для НомерЧасти = 1 По ЧислоЧастей - 3 Цикл
		Префикс = Префикс + "/" + ЧастиАдреса.Получить(НомерЧасти);
	КонецЦикла;
	Владелец = ЧастиАдреса.Получить(ЧислоЧастей - 2);
	Репозиторий = ЧастиАдреса.Получить(ЧислоЧастей - 1);

	Результат = Новый Структура;
	Результат.Вставить("Хост", Хост);
	Результат.Вставить("Порт", Порт);
	Результат.Вставить("Защищенное", Защищенное);
	Результат.Вставить("ПутьAPI", Префикс + "/api/v1/repos/" + КодироватьСтроку(Владелец) + "/" + КодироватьСтроку(Репозиторий));

	Возврат Результат;

КонецФункции

Функция КаталогБезКрайнихРазделителей(Каталог)

	Результат = СтрЗаменить(СокрЛП(Каталог), "\", "/");
	Пока СтрНачинаетсяС(Результат, "/") Цикл
		Результат = Сред(Результат, 2);
	КонецЦикла;
	Пока СтрЗаканчиваетсяНа(Результат, "/") Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Путь каталога вида в репозитории: [каталог проекта/]sources или settings.
Функция ПутьКаталогаВида(Параметры, Вид) Экспорт

	КаталогВида = НастройкиПроекта.КаталогВида(Вид);
	Если ЗначениеЗаполнено(Параметры.Каталог) Тогда
		Возврат Параметры.Каталог + "/" + КаталогВида;
	КонецЕсли;

	Возврат КаталогВида;

КонецФункции

Функция СообщениеКоммита(Параметры, ЧислоФайлов)

	Пользователь = ИмяПользователя();
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		Пользователь = "не определен (фоновый вызов)";
	КонецЕсли;

	Возврат "Сверка: настройки проекта «" + Параметры.Наименование + "», файлов " + Строка(ЧислоФайлов)
		+ Символы.ПС + Символы.ПС + "Отправил из базы сверки пользователь: " + Пользователь;

КонецФункции

// --- HTTP API Forgejo ---

// Запрос к API репозитория. Ресурс - хвост после /api/v1/repos/<владелец>/<репозиторий>.
// Возвращает Структура(КодСостояния, Текст).
Функция ЗапросAPI(Параметры, Метод, Ресурс, Тело = "") Экспорт

	Токен = ФастексКлиент.ЗначениеСекрета(Параметры.СекретТокена);
	Соединение = Новый HTTPСоединение(Параметры.Хост, Параметры.Порт, Параметры.Защищенное, 60);
	ЗапросHTTP = Новый HTTPЗапрос(Параметры.ПутьAPI + Ресурс);
	ЗапросHTTP.УстановитьЗаголовок("Authorization", "token " + Токен);
	ЗапросHTTP.УстановитьЗаголовок("Accept", "application/json");
	Если ЗначениеЗаполнено(Тело) Тогда
		ЗапросHTTP.УстановитьЗаголовок("Content-Type", "application/json; charset=utf-8");
		ЗапросHTTP.УстановитьТелоИзСтроки(Тело);
	КонецЕсли;

	// Повтор только при неустановленном соединении («dial tcp»): запрос до сервера не дошел,
	// поэтому повтор безопасен и для записи. Прочие ошибки не повторяются.
	НомерПопытки = 1;
	Пока Истина Цикл
		Попытка
			Ответ = Соединение.ОтправитьДля(ЗапросHTTP, Метод);
			Прервать;
		Исключение
			ТекстОшибки = ОписаниеОшибки();
			Если НомерПопытки >= 3 Или СтрНайти(ТекстОшибки, "dial tcp") = 0 Тогда
				ВызватьИсключение ТекстОшибки;
			КонецЕсли;
		КонецПопытки;
		НомерПопытки = НомерПопытки + 1;
		Приостановить(НомерПопытки);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("КодСостояния", Ответ.КодСостояния);
	Результат.Вставить("Текст", Ответ.ПолучитьТелоКакСтроку());

	Возврат Результат;

КонецФункции

Функция ОшибкаAPI(Действие, Ответ)
	Возврат "Forgejo: " + Действие + " - ответ " + Строка(Ответ.КодСостояния) + ": " + Лев(Ответ.Текст, 500);
КонецФункции

Функция КодироватьПуть(ПутьФайла)
	Возврат КодироватьСтроку(ПутьФайла, "URLВКодировкеURL");
КонецФункции

// Sha последнего коммита ветки проекта.
Функция КоммитВетки(Параметры) Экспорт

	Ответ = ЗапросAPI(Параметры, "GET", "/branches/" + КодироватьСтроку(Параметры.Ветка));
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение ОшибкаAPI("ветка " + Параметры.Ветка, Ответ);
	КонецЕсли;
	Коммит = ПрочитатьJSON(Ответ.Текст).Получить("commit");
	Если ТипЗнч(Коммит) <> Тип("Соответствие") Или Не ЗначениеЗаполнено(Коммит.Получить("id")) Тогда
		ВызватьИсключение "Forgejo: в ответе о ветке " + Параметры.Ветка + " нет коммита";
	КонецЕсли;

	Возврат Коммит.Получить("id");

КонецФункции

// Файлы *.json каталога на ref: Соответствие путь -> sha. Каталога нет - пустое соответствие.
Функция СписокФайлов(Параметры, Каталог, Ref) Экспорт

	Ответ = ЗапросAPI(Параметры, "GET", "/contents/" + КодироватьПуть(Каталог) + "?ref=" + КодироватьСтроку(Ref));
	Файлы = Новый Соответствие;
	Если Ответ.КодСостояния = 404 Тогда
		Возврат Файлы;
	ИначеЕсли Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение ОшибкаAPI("список файлов " + Каталог, Ответ);
	КонецЕсли;

	Элементы = ПрочитатьJSON(Ответ.Текст);
	Если ТипЗнч(Элементы) <> Тип("Массив") Тогда
		ВызватьИсключение "Forgejo: " + Каталог + " в репозитории - не каталог";
	КонецЕсли;
	Для Каждого Элемент Из Элементы Цикл
		Если Элемент.Получить("type") = "file" И СтрЗаканчиваетсяНа(НРег(Элемент.Получить("name")), ".json") Тогда
			Файлы.Вставить(Элемент.Получить("path"), Элемент.Получить("sha"));
		КонецЕсли;
	КонецЦикла;

	Возврат Файлы;

КонецФункции

// Текст файла репозитория на ref (содержимое приходит в base64).
Функция ПрочитатьФайлРепозитория(Параметры, ПутьФайла, Ref) Экспорт

	Ответ = ЗапросAPI(Параметры, "GET", "/contents/" + КодироватьПуть(ПутьФайла) + "?ref=" + КодироватьСтроку(Ref));
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение ОшибкаAPI("чтение " + ПутьФайла, Ответ);
	КонецЕсли;
	Содержимое = ПрочитатьJSON(Ответ.Текст);
	Если ТипЗнч(Содержимое) <> Тип("Соответствие") Или Содержимое.Получить("encoding") <> "base64" Тогда
		ВызватьИсключение "Forgejo: " + ПутьФайла + " пришел не файлом в base64";
	КонецЕсли;

	Возврат Base64Значение(СтрЗаменить(СтрЗаменить(Содержимое.Получить("content"), Символы.ПС, ""), Символы.ВК, ""));

КонецФункции

// Создает и обновляет файлы одним коммитом в ветке проекта. Возвращает sha коммита.
// Для обновления в операции передан sha файла: если файл успели изменить, Forgejo отклонит весь коммит.
Функция ЗаписатьФайлы(Параметры, Операции, Сообщение) Экспорт

	Тело = Новый Соответствие;
	Тело.Вставить("branch", Параметры.Ветка);
	Тело.Вставить("message", Сообщение);
	Тело.Вставить("files", Операции);

	Ответ = ЗапросAPI(Параметры, "POST", "/contents", ЗаписатьJSON(Тело));
	Если Ответ.КодСостояния <> 201 И Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение ОшибкаAPI("коммит не принят (если файл изменили после проверки - получите и повторите)", Ответ);
	КонецЕсли;
	Коммит = ПрочитатьJSON(Ответ.Текст).Получить("commit");
	Если ТипЗнч(Коммит) <> Тип("Соответствие") Или Не ЗначениеЗаполнено(Коммит.Получить("sha")) Тогда
		ВызватьИсключение "Forgejo: в ответе на коммит нет его sha";
	КонецЕсли;

	Возврат Коммит.Получить("sha");

КонецФункции
