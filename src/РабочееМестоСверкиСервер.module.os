// Логика рабочего места «Сверка данных» (обработка РабочееМестоСверки, форма forms/рабочееместосверки).
// Объект - объект обработки: параметры (проект, период, текущая настройка и поля ее правки с префиксом Н)
// и табличные части Настройки, Результат, Источники.

// Ссылочные параметры обработки в событиях формы приходят строкой с УИД - приводим к ссылкам.
Процедура ПривестиСсылки(Объект) Экспорт

	Объект.Проект = Ссылка(Объект.Проект, "ПроектыСверки", Ложь);
	Объект.Настройка = Ссылка(Объект.Настройка, "НастройкиСверки", Ложь);
	Объект.Запуск = Ссылка(Объект.Запуск, "ЗапускСверки", Истина);
	Объект.НИсточникА = Ссылка(Объект.НИсточникА, "Источники", Ложь);
	Объект.НИсточникБ = Ссылка(Объект.НИсточникБ, "Источники", Ложь);

КонецПроцедуры

// Ссылка справочника или документа по значению параметра формы: ссылка как есть, строка с УИД - поиском.
Функция Ссылка(Значение, ИмяСущности, ЭтоДокумент = Ложь) Экспорт

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	Идентификатор = СокрЛП(Значение);
	Если Не ЗначениеЗаполнено(Идентификатор) Или Идентификатор = "00000000-0000-0000-0000-000000000000" Тогда
		Возврат Неопределено;
	КонецЕсли;
	// Менеджер по имени (Справочники[Имя]) onebase не отдает - ветки по сущностям.
	Если ИмяСущности = "ЗапускСверки" Тогда
		Возврат Документы.ЗапускСверки.НайтиПоИдентификатору(Идентификатор);
	ИначеЕсли ИмяСущности = "ПроектыСверки" Тогда
		Возврат Справочники.ПроектыСверки.НайтиПоИдентификатору(Идентификатор);
	ИначеЕсли ИмяСущности = "Источники" Тогда
		Возврат Справочники.Источники.НайтиПоИдентификатору(Идентификатор);
	КонецЕсли;

	Возврат Справочники.НастройкиСверки.НайтиПоИдентификатору(Идентификатор);

КонецФункции

Функция ПроектПоУмолчанию() Экспорт

	ЗапросПроекта = Новый Запрос;
	ЗапросПроекта.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Наименование ИЗ Справочник.ПроектыСверки УПОРЯДОЧИТЬ ПО Наименование";
	Для Каждого Запись Из ЗапросПроекта.Выполнить() Цикл
		Возврат Справочники.ПроектыСверки.НайтиПоНаименованию(Запись.Наименование);
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Настройки и источники проекта (без проекта - объекты без проекта), по наименованию.
Процедура ЗаполнитьСписки(Объект) Экспорт

	Объект.Настройки.Очистить();
	Для Каждого Наименование Из НастройкиПроекта.НаименованияОбъектов(НастройкиПроекта.ВидНастройка(), Объект.Проект) Цикл
		СтрокаНастройки = Объект.Настройки.Добавить();
		СтрокаНастройки.Наименование = Наименование;
		СтрокаНастройки.Настройка = НастройкиПроекта.НайтиОбъект(НастройкиПроекта.ВидНастройка(), Наименование, Объект.Проект);
	КонецЦикла;

	Объект.Источники.Очистить();
	Для Каждого Наименование Из НастройкиПроекта.НаименованияОбъектов(НастройкиПроекта.ВидИсточник(), Объект.Проект) Цикл
		Источник = НастройкиПроекта.НайтиОбъект(НастройкиПроекта.ВидИсточник(), Наименование, Объект.Проект);
		НастройкиИсточника = ФастексКлиент.НастройкиИсточника(Источник);
		СтрокаИсточника = Объект.Источники.Добавить();
		СтрокаИсточника.Источник = Источник;
		СтрокаИсточника.Тип = НастройкиИсточника.Тип;
		СтрокаИсточника.Адрес = НастройкиИсточника.АдресПубликации;
		СтрокаИсточника.Пользователь = НастройкиИсточника.Пользователь;
	КонецЦикла;

КонецПроцедуры

// Делает настройку текущей: поля вкладки «Настройка», погрешность, последний запуск за период.
Процедура ВыбратьНастройку(Объект, Настройка) Экспорт

	Если НастройкиПроекта.ИдСсылки(Настройка) = НастройкиПроекта.ИдСсылки(Объект.Настройка) Тогда
		Возврат;
	КонецЕсли;
	Объект.Настройка = Настройка;
	Объект.ОтборКлюча = "";
	ЗагрузитьНастройку(Объект);
	ПоказатьПоследнийЗапуск(Объект);

КонецПроцедуры

Процедура ЗагрузитьНастройку(Объект) Экспорт

	Если Не ЗначениеЗаполнено(Объект.Настройка) Тогда
		Для Каждого ИмяПоля Из СтрРазделить("ННаименование,НКлючевыеПоля,НПоляЗначений,НПоляБезУчетаФормата,НРасшифровка,"
			+ "НПорцииЗапроса,НЗапросА,НЗапросБ,НЗапросСоответствияБ,НПояснения", ",") Цикл
			Объект[ИмяПоля] = "";
		КонецЦикла;
		Объект.НИсточникА = Неопределено;
		Объект.НИсточникБ = Неопределено;
		Объект.НПогрешность = 0;
		Объект.НСоответствиеНаА = Ложь;
		Объект.НВсеКлючи = Ложь;
		Возврат;
	КонецЕсли;

	НастройкаОбъект = Объект.Настройка.ПолучитьОбъект();
	Объект.ННаименование = НастройкаОбъект.Наименование;
	Объект.НИсточникА = НастройкаОбъект.ИсточникА;
	Объект.НИсточникБ = НастройкаОбъект.ИсточникБ;
	Объект.НКлючевыеПоля = НастройкиПроекта.ТекстЗначения(НастройкаОбъект.КлючевыеПоля);
	Объект.НПоляЗначений = НастройкиПроекта.ТекстЗначения(НастройкаОбъект.ПоляЗначений);
	Объект.НПогрешность = НастройкиПроекта.ЧислоЗначения(НастройкаОбъект.Погрешность);
	Объект.НПоляБезУчетаФормата = НастройкиПроекта.ТекстЗначения(НастройкаОбъект.ПоляБезУчетаФормата);
	Объект.НСоответствиеНаА = НастройкиПроекта.ЗначениеПризнака(НастройкаОбъект.СоответствиеНаИсточникеА);
	Объект.НВсеКлючи = НастройкиПроекта.ЗначениеПризнака(НастройкаОбъект.ВсеКлючиВРезультате);
	Объект.НРасшифровка = НастройкиПроекта.ТекстЗначения(НастройкаОбъект.НастройкаРасшифровки);
	Объект.НПорцииЗапроса = НастройкиПроекта.ТекстЗначения(НастройкаОбъект.ПорцииЗапроса);
	Объект.НЗапросА = НастройкиПроекта.ТекстЗначения(НастройкаОбъект.ЗапросА);
	Объект.НЗапросБ = НастройкиПроекта.ТекстЗначения(НастройкаОбъект.ЗапросБ);
	Объект.НЗапросСоответствияБ = НастройкиПроекта.ТекстЗначения(НастройкаОбъект.ЗапросСоответствияБ);
	Объект.НПояснения = НастройкиПроекта.ТекстЗначения(НастройкаОбъект.Пояснения);
	Объект.Погрешность = Объект.НПогрешность;

КонецПроцедуры

// Последний выполненный запуск текущей настройки ровно за период формы - в таблицу; нет - таблица пуста.
Процедура ПоказатьПоследнийЗапуск(Объект) Экспорт

	Объект.Запуск = Неопределено;
	Если ЗначениеЗаполнено(Объект.Настройка) И ЗначениеЗаполнено(Объект.НачалоПериода) И ЗначениеЗаполнено(Объект.КонецПериода) Тогда
		ЗапросЗапуска = Новый Запрос;
		ЗапросЗапуска.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Номер ИЗ Документ.ЗапускСверки
			|ГДЕ Настройка = &Настройка И НачалоПериода = &НачалоПериода И КонецПериода = &КонецПериода
			|УПОРЯДОЧИТЬ ПО Дата УБЫВ";
		ЗапросЗапуска.УстановитьПараметр("Настройка", Объект.Настройка);
		ЗапросЗапуска.УстановитьПараметр("НачалоПериода", НачалоДня(Объект.НачалоПериода));
		ЗапросЗапуска.УстановитьПараметр("КонецПериода", КонецДня(Объект.КонецПериода));
		Для Каждого Запись Из ЗапросЗапуска.Выполнить() Цикл
			Объект.Запуск = Документы.ЗапускСверки.НайтиПоНомеру(Запись.Номер);
		КонецЦикла;
	КонецЕсли;
	ЗаполнитьРезультат(Объект);

КонецПроцедуры

// Выбранный в поле «Запуск» запуск (в т.ч. прошлый): его настройка и период становятся текущими.
Процедура ПоказатьЗапуск(Объект) Экспорт

	Если ЗначениеЗаполнено(Объект.Запуск) Тогда
		ЗапускОбъект = Объект.Запуск.ПолучитьОбъект();
		Если НастройкиПроекта.ИдСсылки(ЗапускОбъект.Настройка) <> НастройкиПроекта.ИдСсылки(Объект.Настройка) Тогда
			Объект.Настройка = ЗапускОбъект.Настройка;
			ЗагрузитьНастройку(Объект);
		КонецЕсли;
		Объект.НачалоПериода = ЗапускОбъект.НачалоПериода;
		Объект.КонецПериода = ЗапускОбъект.КонецПериода;
	КонецЕсли;
	ЗаполнитьРезультат(Объект);

КонецПроцедуры

Процедура Сравнить(Объект) Экспорт

	Если Не ЗначениеЗаполнено(Объект.Настройка) Тогда
		ВызватьИсключение "Выберите настройку в списке слева (или запишите новую на вкладке «Настройка»)";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.НачалоПериода) Или Не ЗначениеЗаполнено(Объект.КонецПериода) Тогда
		ВызватьИсключение "Укажите период";
	КонецЕсли;

	ЗапускОбъект = СверкаДанных.ВыполнитьСверку(Объект.Настройка, НачалоДня(Объект.НачалоПериода), КонецДня(Объект.КонецПериода),
		Объект.Перечитать = Истина);
	Объект.Запуск = Документы.ЗапускСверки.НайтиПоНомеру(ЗапускОбъект.Номер);
	Если ЗапускОбъект.Состояние <> "Выполнено" Тогда
		Сообщить("Сверка не выполнена: " + НастройкиПроекта.ТекстЗначения(ЗапускОбъект.ТекстОшибки));
	КонецЕсли;
	ЗаполнитьРезультат(Объект);

КонецПроцедуры

// Таблица результата из запуска: все ключи (ТЧ Ключи) или расхождения; отбор расшифровки по первой части ключа,
// «только отличия» с погрешностью формы, эталон и пояснение из настройки.
Процедура ЗаполнитьРезультат(Объект) Экспорт

	Объект.Результат.Очистить();
	Объект.Итог = "";
	Если Не ЗначениеЗаполнено(Объект.Запуск) Тогда
		Возврат;
	КонецЕсли;

	ЗапускОбъект = Объект.Запуск.ПолучитьОбъект();
	Если ЗапускОбъект.Состояние <> "Выполнено" Тогда
		Объект.Итог = "Запуск " + ЗапускОбъект.Номер + ": " + ЗапускОбъект.Состояние + " - "
			+ Лев(НастройкиПроекта.ТекстЗначения(ЗапускОбъект.ТекстОшибки), 300);
		Возврат;
	КонецЕсли;

	Пояснения = СверкаДанных.РазобратьПояснения(Объект.НПояснения);
	Допуск = НастройкиПроекта.ЧислоЗначения(Объект.Погрешность);
	Строки = СтрокиЗапуска(ЗапускОбъект);
	Показано = 0;
	Расходится = 0;
	Пояснено = 0;
	Для Каждого СтрокаЗапуска Из Строки Цикл
		Если ЗначениеЗаполнено(Объект.ОтборКлюча) И Не СтрНачинаетсяС(СтрокаЗапуска.Ключ, Объект.ОтборКлюча + "|") Тогда
			Продолжить;
		КонецЕсли;
		ЕстьРазница = СтрокаЗапуска.Текстовое Или Абс(СтрокаЗапуска.Разница) > Допуск;
		Пояснение = Пояснения.Получить(СтрокаЗапуска.Ключ);
		Если ЕстьРазница Тогда
			Расходится = Расходится + 1;
			Если Пояснение <> Неопределено И ЗначениеЗаполнено(Пояснение.Причина) Тогда
				Пояснено = Пояснено + 1;
			КонецЕсли;
		ИначеЕсли Объект.ТолькоОтличия = Истина Тогда
			Продолжить;
		КонецЕсли;
		Показано = Показано + 1;
		СтрокаРезультата = Объект.Результат.Добавить();
		СтрокаРезультата.Ключ = СтрокаЗапуска.Ключ;
		СтрокаРезультата.Поле = СтрокаЗапуска.Поле;
		СтрокаРезультата.ЗначениеА = СтрокаЗапуска.ЗначениеА;
		СтрокаРезультата.ЗначениеБ = СтрокаЗапуска.ЗначениеБ;
		СтрокаРезультата.Разница = СтрокаЗапуска.Разница;
		СтрокаРезультата.НетВА = СтрокаЗапуска.НетВА;
		СтрокаРезультата.НетВБ = СтрокаЗапуска.НетВБ;
		СтрокаРезультата.Представление = ПредставлениеСтроки(СтрокаЗапуска, Объект.ОтборКлюча);
		СтрокаРезультата.Расходится = ЕстьРазница;
		Если Пояснение <> Неопределено Тогда
			СтрокаРезультата.Эталон = Пояснение.Эталон;
			СтрокаРезультата.Пояснение = Пояснение.Причина;
		КонецЕсли;
	КонецЦикла;

	Объект.Итог = "Запуск " + ЗапускОбъект.Номер + " от " + ТекстДатыВремени(ЗапускОбъект.Дата) + ": расходится " + Строка(Расходится)
		+ " (с пояснением " + Строка(Пояснено) + ", без пояснения " + Строка(Расходится - Пояснено) + "), показано строк "
		+ Строка(Показано) + "; ключей А " + Строка(НастройкиПроекта.ЧислоЗначения(ЗапускОбъект.КлючейА)) + ", Б "
		+ Строка(НастройкиПроекта.ЧислоЗначения(ЗапускОбъект.КлючейБ)) + ".";

КонецПроцедуры

// Строки запуска: ТЧ Ключи (все ключи) или ТЧ Расхождения; колонки Ключ, ПредставлениеКлюча, Поле, ЗначениеА,
// ЗначениеБ, Разница, НетВА, НетВБ, Текстовое (расхождение нечисловых значений - тексты в поле «Поле»).
// Порядок - по ключу как строке (числоподобные ключи onebase иначе сортирует как числа).
Функция СтрокиЗапуска(ЗапускОбъект)

	Строки = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить("Сортировка,Ключ,ПредставлениеКлюча,Поле,ЗначениеА,ЗначениеБ,Разница,НетВА,НетВБ,Текстовое", ",") Цикл
		Строки.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;

	ЕстьКлючи = ЗапускОбъект.Ключи.Количество() > 0;
	Для Каждого СтрокаИсточника Из ?(ЕстьКлючи, ЗапускОбъект.Ключи, ЗапускОбъект.Расхождения) Цикл
		НоваяСтрока = Строки.Добавить();
		НоваяСтрока.Ключ = НастройкиПроекта.ТекстЗначения(СтрокаИсточника.Ключ);
		НоваяСтрока.Сортировка = СверкаДанных.КлючСортировки(НоваяСтрока.Ключ);
		НоваяСтрока.ПредставлениеКлюча = НастройкиПроекта.ТекстЗначения(СтрокаИсточника.ПредставлениеКлюча);
		НоваяСтрока.Поле = НастройкиПроекта.ТекстЗначения(СтрокаИсточника.Поле);
		НоваяСтрока.ЗначениеА = НастройкиПроекта.ЧислоЗначения(СтрокаИсточника.ЗначениеА);
		НоваяСтрока.ЗначениеБ = НастройкиПроекта.ЧислоЗначения(СтрокаИсточника.ЗначениеБ);
		НоваяСтрока.Разница = НастройкиПроекта.ЧислоЗначения(СтрокаИсточника.Разница);
		НоваяСтрока.НетВА = НастройкиПроекта.ЗначениеПризнака(СтрокаИсточника.НетВА);
		НоваяСтрока.НетВБ = НастройкиПроекта.ЗначениеПризнака(СтрокаИсточника.НетВБ);
		НоваяСтрока.Текстовое = Ложь;
		Если Не ЕстьКлючи Тогда
			ТекстА = НастройкиПроекта.ТекстЗначения(СтрокаИсточника.ТекстА);
			ТекстБ = НастройкиПроекта.ТекстЗначения(СтрокаИсточника.ТекстБ);
			Если ЗначениеЗаполнено(ТекстА) Или ЗначениеЗаполнено(ТекстБ) Тогда
				НоваяСтрока.Текстовое = Истина;
				НоваяСтрока.Поле = НоваяСтрока.Поле + " (А: " + ТекстА + "; Б: " + ТекстБ + ")";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Строки.Сортировать("Сортировка, Поле");

	Возврат Строки;

КонецФункции

// Расшифровка текущей строки настройкой расшифровки: она становится текущей с отбором по ключу строки,
// показывается ее последний запуск за период, а если его нет - выполняется сверка.
Процедура Расшифровать(Объект) Экспорт

	Если Не ЗначениеЗаполнено(Объект.ТекущийКлюч) Тогда
		ВызватьИсключение "Выделите строку результата";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.НРасшифровка) Тогда
		ВызватьИсключение "У настройки «" + Объект.ННаименование + "» не задана настройка расшифровки (вкладка «Настройка»)";
	КонецЕсли;
	Отбор = СтрРазделить(Объект.ТекущийКлюч, "|").Получить(0);
	Расшифровка = НастройкиПроекта.НайтиОбъект(НастройкиПроекта.ВидНастройка(), Объект.НРасшифровка, Объект.Проект);
	Если Расшифровка = Неопределено Тогда
		ВызватьИсключение "Не найдена настройка расшифровки «" + Объект.НРасшифровка + "»";
	КонецЕсли;

	Объект.Настройка = Расшифровка;
	ЗагрузитьНастройку(Объект);
	Объект.ОтборКлюча = Отбор;
	ПоказатьПоследнийЗапуск(Объект);
	Если Не ЗначениеЗаполнено(Объект.Запуск) Тогда
		Сравнить(Объект);
	КонецЕсли;

КонецПроцедуры

// Возврат из расшифровки к настройке, у которой текущая указана расшифровкой.
Процедура ВернутьсяКОбщей(Объект) Экспорт

	Если Не ЗначениеЗаполнено(Объект.ОтборКлюча) Тогда
		Возврат;
	КонецЕсли;
	ЗапросВерхней = Новый Запрос;
	ЗапросВерхней.Текст = "ВЫБРАТЬ Наименование ИЗ Справочник.НастройкиСверки ГДЕ НастройкаРасшифровки = &ИмяРасшифровки";
	ЗапросВерхней.УстановитьПараметр("ИмяРасшифровки", Объект.ННаименование);
	Для Каждого Запись Из ЗапросВерхней.Выполнить() Цикл
		Верхняя = НастройкиПроекта.НайтиОбъект(НастройкиПроекта.ВидНастройка(), Запись.Наименование, Объект.Проект);
		Если Верхняя <> Неопределено Тогда
			ТекущийОтбор = Объект.ОтборКлюча;
			Объект.Настройка = Верхняя;
			Объект.ОтборКлюча = "";
			ЗагрузитьНастройку(Объект);
			ПоказатьПоследнийЗапуск(Объект);
			Объект.ТекущийКлюч = ТекущийОтбор;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Объект.ОтборКлюча = "";
	ЗаполнитьРезультат(Объект);

КонецПроцедуры

// Эталон и пояснение строки - в текст пояснений настройки (строка «ключ :: эталон :: причина»; оба пусты - строка
// удаляется) и сразу в базу: пояснения едут в репозиторий проекта вместе с настройкой.
Процедура ЗаписатьПояснение(Объект, Ключ, Эталон, Причина) Экспорт

	Если Не ЗначениеЗаполнено(Объект.Настройка) Или Не ЗначениеЗаполнено(Ключ) Тогда
		Возврат;
	КонецЕсли;
	НастройкаОбъект = Объект.Настройка.ПолучитьОбъект();
	НовыеСтроки = Новый Массив;
	Заменено = Ложь;
	НоваяСтрокаПояснения = ?(ЗначениеЗаполнено(СокрЛП(Эталон)) Или ЗначениеЗаполнено(СокрЛП(Причина)),
		Ключ + " :: " + СокрЛП(Эталон) + " :: " + СокрЛП(Причина), "");
	Для Каждого СтрокаПояснения Из СтрРазделить(СтрЗаменить(НастройкиПроекта.ТекстЗначения(НастройкаОбъект.Пояснения), Символы.ВК, ""), Символы.ПС, Ложь) Цикл
		Если СокрЛП(СтрРазделить(СтрокаПояснения, "::").Получить(0)) = Ключ Тогда
			Если Не Заменено И ЗначениеЗаполнено(НоваяСтрокаПояснения) Тогда
				НовыеСтроки.Добавить(НоваяСтрокаПояснения);
			КонецЕсли;
			Заменено = Истина;
		ИначеЕсли ЗначениеЗаполнено(СокрЛП(СтрокаПояснения)) Тогда
			НовыеСтроки.Добавить(СтрокаПояснения);
		КонецЕсли;
	КонецЦикла;
	Если Не Заменено И ЗначениеЗаполнено(НоваяСтрокаПояснения) Тогда
		НовыеСтроки.Добавить(НоваяСтрокаПояснения);
	КонецЕсли;
	НастройкаОбъект.Пояснения = СтрСоединить(НовыеСтроки, Символы.ПС);
	НастройкаОбъект.Записать();
	Объект.НПояснения = НастройкаОбъект.Пояснения;

КонецПроцедуры

// Таблица результата - в CSV (UTF-8 с BOM, «;» - Excel открывает двойным щелчком) вложением к запуску; уведомление
// со ссылкой на запуск, где лежит вложение. Двоичный xlsx DSL записать не может.
Процедура ВыгрузитьРезультатВExcel(Объект) Экспорт

	Если Не ЗначениеЗаполнено(Объект.Запуск) Тогда
		ВызватьИсключение "Сначала выполните сравнение";
	КонецЕсли;
	ИмяА = ?(ЗначениеЗаполнено(Объект.НИсточникА), Объект.НИсточникА.ПолучитьОбъект().Наименование, "А");
	ИмяБ = ?(ЗначениеЗаполнено(Объект.НИсточникБ), Объект.НИсточникБ.ПолучитьОбъект().Наименование, "Б");
	Строки = Новый Массив;
	Строки.Добавить(СтрокаCSV(СтрРазделить("Ключ;Представление;Поле;" + ИмяА + ";" + ИмяБ + ";Разница;Расходится;Эталон;Пояснение", ";")));
	Для Каждого СтрокаРезультата Из Объект.Результат Цикл
		Значения = Новый Массив;
		Значения.Добавить(СтрокаРезультата.Ключ);
		Значения.Добавить(СтрокаРезультата.Представление);
		Значения.Добавить(СтрокаРезультата.Поле);
		Значения.Добавить(ЧислоCSV(СтрокаРезультата.ЗначениеА));
		Значения.Добавить(ЧислоCSV(СтрокаРезультата.ЗначениеБ));
		Значения.Добавить(ЧислоCSV(СтрокаРезультата.Разница));
		Значения.Добавить(?(НастройкиПроекта.ЗначениеПризнака(СтрокаРезультата.Расходится), "да", ""));
		Значения.Добавить(СтрокаРезультата.Эталон);
		Значения.Добавить(СтрокаРезультата.Пояснение);
		Строки.Добавить(СтрокаCSV(Значения));
	КонецЦикла;

	ЗапускОбъект = Объект.Запуск.ПолучитьОбъект();
	ИмяФайла = "Сверка " + ЗапускОбъект.Номер + ?(ЗначениеЗаполнено(Объект.ОтборКлюча), " " + Объект.ОтборКлюча, "") + ".csv";
	ПутьКФайлу = ПолучитьИмяВременногоФайла("csv");
	ЗаписьФайла = Новый ЗаписьТекста(ПутьКФайлу);
	ЗаписьФайла.Открыть();
	ЗаписьФайла.Записать(Символ(65279) + СтрСоединить(Строки, Символы.ВК + Символы.ПС) + Символы.ВК + Символы.ПС);
	ЗаписьФайла.Закрыть();
	ПрисоединитьФайл(Объект.Запуск, ПутьКФайлу, ИмяФайла);
	УдалитьФайлы(ПутьКФайлу);

	Ссылка = Новый Структура("вид, сущность, id", "document", "ЗапускСверки", НастройкиПроекта.ИдСсылки(Объект.Запуск));
	Получатель = ?(ЗначениеЗаполнено(ИмяПользователя()), ИмяПользователя(), "*");
	ПоказатьОповещениеПользователя(Получатель, "Выгрузка готова", "Файл «" + ИмяФайла + "» во вложениях запуска "
		+ ЗапускОбъект.Номер + " - нажмите, чтобы открыть", Ссылка, "важное");
	Сообщить("Файл «" + ИмяФайла + "» приложен к запуску " + ЗапускОбъект.Номер + " (вложения документа).");

КонецПроцедуры

Процедура ЗаписатьНастройку(Объект) Экспорт

	Если Не ЗначениеЗаполнено(СокрЛП(Объект.ННаименование)) Тогда
		ВызватьИсключение "Укажите наименование настройки";
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Настройка) Тогда
		НастройкаОбъект = Объект.Настройка.ПолучитьОбъект();
	Иначе
		Если НастройкиПроекта.НайтиОбъект(НастройкиПроекта.ВидНастройка(), СокрЛП(Объект.ННаименование), Объект.Проект) <> Неопределено Тогда
			ВызватьИсключение "Настройка «" + СокрЛП(Объект.ННаименование) + "» в проекте уже есть";
		КонецЕсли;
		НастройкаОбъект = Справочники.НастройкиСверки.Создать();
		Если ЗначениеЗаполнено(Объект.Проект) Тогда
			НастройкаОбъект.Проект = Объект.Проект;
		КонецЕсли;
	КонецЕсли;
	НастройкаОбъект.Наименование = СокрЛП(Объект.ННаименование);
	НастройкаОбъект.ИсточникА = Объект.НИсточникА;
	НастройкаОбъект.ИсточникБ = Объект.НИсточникБ;
	НастройкаОбъект.КлючевыеПоля = Объект.НКлючевыеПоля;
	НастройкаОбъект.ПоляЗначений = Объект.НПоляЗначений;
	НастройкаОбъект.Погрешность = НастройкиПроекта.ЧислоЗначения(Объект.НПогрешность);
	НастройкаОбъект.ПоляБезУчетаФормата = Объект.НПоляБезУчетаФормата;
	НастройкаОбъект.СоответствиеНаИсточникеА = (Объект.НСоответствиеНаА = Истина);
	НастройкаОбъект.ВсеКлючиВРезультате = (Объект.НВсеКлючи = Истина);
	НастройкаОбъект.НастройкаРасшифровки = Объект.НРасшифровка;
	НастройкаОбъект.ПорцииЗапроса = Объект.НПорцииЗапроса;
	НастройкаОбъект.ЗапросА = Объект.НЗапросА;
	НастройкаОбъект.ЗапросБ = Объект.НЗапросБ;
	НастройкаОбъект.ЗапросСоответствияБ = Объект.НЗапросСоответствияБ;
	НастройкаОбъект.Пояснения = Объект.НПояснения;
	НастройкаОбъект.Записать();
	Объект.Настройка = НастройкиПроекта.НайтиОбъект(НастройкиПроекта.ВидНастройка(), НастройкаОбъект.Наименование, Объект.Проект);
	ЗаполнитьСписки(Объект);
	Сообщить("Настройка «" + НастройкаОбъект.Наименование + "» записана. В репозиторий проекта - обработкой «Отправить настройки проекта в репозиторий».");

КонецПроцедуры

// Новая настройка: пустая или копия текущей; записывается кнопкой «Записать настройку».
Процедура НоваяНастройка(Объект, Копировать) Экспорт

	Объект.Настройка = Неопределено;
	Объект.Запуск = Неопределено;
	Объект.ОтборКлюча = "";
	Объект.Результат.Очистить();
	Объект.Итог = "";
	Если Копировать Тогда
		Объект.ННаименование = Объект.ННаименование + " (копия)";
	Иначе
		ЗагрузитьНастройку(Объект);
		Объект.ННаименование = "Новая настройка";
	КонецЕсли;

КонецПроцедуры

Функция ПредставлениеСтроки(СтрокаЗапуска, ОтборКлюча)

	Представление = ?(ЗначениеЗаполнено(СтрокаЗапуска.ПредставлениеКлюча), СтрокаЗапуска.ПредставлениеКлюча, СтрокаЗапуска.Ключ);
	Если ЗначениеЗаполнено(ОтборКлюча) И СтрНачинаетсяС(Представление, ОтборКлюча + " | ") Тогда
		Представление = Сред(Представление, СтрДлина(ОтборКлюча) + 4);
	КонецЕсли;

	Возврат Представление;

КонецФункции

Функция СтрокаCSV(Значения)

	Поля = Новый Массив;
	Для Каждого Значение Из Значения Цикл
		Текст = НастройкиПроекта.ТекстЗначения(Значение);
		Если СтрНайти(Текст, ";") > 0 Или СтрНайти(Текст, """") > 0 Или СтрНайти(Текст, Символы.ПС) > 0 Тогда
			Текст = """" + СтрЗаменить(Текст, """", """""") + """";
		КонецЕсли;
		Поля.Добавить(Текст);
	КонецЦикла;

	Возврат СтрСоединить(Поля, ";");

КонецФункции

// Число для русского Excel: без разделителя групп, запятая перед дробной частью (Формат с ЧГ=0 и ЧРД группы
// и разделитель в onebase не меняет).
Функция ЧислоCSV(Значение)
	Текст = Формат(НастройкиПроекта.ЧислоЗначения(Значение), "ЧДЦ=2; ЧН=0");
	Возврат СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, " ", ""), Символ(160), ""), ".", ",");
КонецФункции

Функция ТекстДатыВремени(Значение)
	Возврат Формат(Значение, "ДФ=dd.MM.yyyy") + " " + Прав("0" + Строка(Час(Значение)), 2) + ":" + Прав("0" + Строка(Минута(Значение)), 2);
КонецФункции
