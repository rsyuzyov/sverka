// Замер движка на синтетике без источников и без записи в базу: разбор ответа (JSON), вычисление ключей,
// свертка и сравнение. Строки как у сверки строк документов: ключ «Документ, Номенклатура» (по 5 строк
// на документ), поля Количество и Сумма. В Б каждая 100-я строка отличается суммой на 1, каждой 1000-й нет,
// каждая 50-я разбита на две половины (проверка свертки). Печатает время этапов в секундах.
Процедура Выполнить() Экспорт

	ЧислоСтрок = НастройкиПроекта.ЧислоЗначения(Параметры.ЧислоСтрок);
	Если ЧислоСтрок <= 0 Тогда
		ЧислоСтрок = 10000;
	КонецЕсли;
	КлючевыеПоля = СверкаДанных.РазобратьСписокПолей("Документ, Номенклатура");
	ПоляЗначений = СверкаДанных.РазобратьСписокПолей("Количество, Сумма");

	НачалоЭтапа = ТекущаяДатаВремя();
	СтрокиА = Новый Массив;
	СтрокиБ = Новый Массив;
	Для НомерСтроки = 1 По ЧислоСтрок Цикл
		Документ = УИДИзЧисла(Цел(НомерСтроки / 5));
		Номенклатура = УИДИзЧисла(1000000 + НомерСтроки * 7919 - Цел(НомерСтроки * 7919 / 20000) * 20000);
		Сумма = НомерСтроки + 0.5;
		СтрокиА.Добавить(СтрокаВыборки(Документ, Номенклатура, 2, Сумма));
		Если НомерСтроки - Цел(НомерСтроки / 1000) * 1000 = 0 Тогда
			Продолжить;
		ИначеЕсли НомерСтроки - Цел(НомерСтроки / 100) * 100 = 0 Тогда
			СтрокиБ.Добавить(СтрокаВыборки(Документ, Номенклатура, 2, Сумма + 1));
		ИначеЕсли НомерСтроки - Цел(НомерСтроки / 50) * 50 = 0 Тогда
			СтрокиБ.Добавить(СтрокаВыборки(Документ, Номенклатура, 1, Сумма / 2));
			СтрокиБ.Добавить(СтрокаВыборки(Документ, Номенклатура, 1, Сумма / 2));
		Иначе
			СтрокиБ.Добавить(СтрокаВыборки(Документ, Номенклатура, 2, Сумма));
		КонецЕсли;
	КонецЦикла;
	Сообщить("Генерация: строк А " + Строка(СтрокиА.Количество()) + ", Б " + Строка(СтрокиБ.Количество())
		+ "; " + СекундСНачала(НачалоЭтапа) + " с");

	НачалоЭтапа = ТекущаяДатаВремя();
	ТекстJSON = ЗаписатьJSON(СтрокиА);
	Сообщить("ЗаписатьJSON А (запись кэша): " + Строка(Окр(СтрДлина(ТекстJSON) / 1048576, 1)) + " млн символов; "
		+ СекундСНачала(НачалоЭтапа) + " с");
	НачалоЭтапа = ТекущаяДатаВремя();
	СтрокиА = ПрочитатьJSON(ТекстJSON);
	ТекстJSON = "";
	Сообщить("ПрочитатьJSON А (разбор ответа fastex или кэша): " + СекундСНачала(НачалоЭтапа) + " с");

	НачалоЭтапа = ТекущаяДатаВремя();
	ТаблицаСверки = СверкаДанных.НоваяТаблицаСверки();
	СверкаДанных.ДобавитьСтрокиСтороны(ТаблицаСверки, СтрокиА, "А", КлючевыеПоля, ПоляЗначений);
	СверкаДанных.ДобавитьСтрокиСтороны(ТаблицаСверки, СтрокиБ, "Б", КлючевыеПоля, ПоляЗначений);
	Сообщить("Ключи и таблица сверки: " + Строка(ТаблицаСверки.Количество()) + " строк; "
		+ СекундСНачала(НачалоЭтапа) + " с");

	НачалоЭтапа = ТекущаяДатаВремя();
	Сравнение = СверкаДанных.СравнитьВыборки(ТаблицаСверки, КлючевыеПоля, ПоляЗначений, 0.01, Новый Массив);
	Сообщить("Сортировка, свертка и сравнение: " + СекундСНачала(НачалоЭтапа) + " с");
	Сообщить("Ключей А " + Строка(Сравнение.КлючейА) + ", Б " + Строка(Сравнение.КлючейБ)
		+ ", совпало " + Строка(Сравнение.Совпало) + ", расходится " + Строка(Сравнение.Расходится)
		+ ", нет в Б " + Строка(Сравнение.НетВБ) + ", строк расхождений " + Строка(Сравнение.Расхождения.Количество())
		+ "; сумма А " + Строка(Сравнение.СуммыА.Получить(1)) + ", Б " + Строка(Сравнение.СуммыБ.Получить(1)));

КонецПроцедуры

Функция СтрокаВыборки(Документ, Номенклатура, Количество, Сумма)

	СтрокаВыборки = Новый Соответствие;
	СтрокаВыборки.Вставить("Документ", Документ);
	СтрокаВыборки.Вставить("ДокументПредставление", "Поступление " + Прав(Документ, 6));
	СтрокаВыборки.Вставить("Номенклатура", Номенклатура);
	СтрокаВыборки.Вставить("Количество", Количество);
	СтрокаВыборки.Вставить("Сумма", Сумма);

	Возврат СтрокаВыборки;

КонецФункции

Функция УИДИзЧисла(Значение)
	Возврат "00000000-0000-0000-0000-" + Прав("000000000000" + Строка(Значение), 12);
КонецФункции

Функция СекундСНачала(НачалоЭтапа)
	Возврат Строка(Окр(ТекущаяДатаВремя() - НачалоЭтапа, 1));
КонецФункции
