// Выгрузка расхождений запуска сверки в CSV.
Процедура Выполнить() Экспорт

	Запуск = Документы.ЗапускСверки.НайтиПоНомеру(Параметры.НомерЗапуска);
	Если Запуск = Неопределено Тогда
		ВызватьИсключение "Не найден запуск сверки " + Параметры.НомерЗапуска;
	КонецЕсли;

	ЗапускОбъект = Запуск.ПолучитьОбъект();
	СверкаДанных.ВыгрузитьРасхожденияВCSV(ЗапускОбъект, Параметры.ПутьКФайлу, Параметры.ИмяТипа);
	Сообщить("Выгружено строк: " + Строка(ЗапускОбъект.Расхождения.Количество()) + " в " + Параметры.ПутьКФайлу);

КонецПроцедуры
