// HTTP-сервис сверки для агентов.
// POST /hs/sverka/run, тело JSON:
// {"настройка": "имя", "проект": "имя (необязательно)", "начало": "2024-01-01", "конец": "2024-01-01",
//  "перечитать": false, "лимит": 100}
// POST /hs/sverka/sync, тело JSON: {"проект": "имя", "действие": "получить" | "отправить", "заменитьЛокальные": false}
// Вспомогательные функции - только в общих модулях: функция внутри *.service.os в работе дает unknown function.
Функция ЗапуститьСверку(Запрос) Экспорт

	Попытка
		Тело = Запрос.ТелоJSON();
	Исключение
		Возврат ОтветJSON(400, Новый Структура("ошибка", "Тело запроса должно быть JSON"));
	КонецПопытки;

	Если ТипЗнч(Тело) <> Тип("Соответствие") Тогда
		Возврат ОтветJSON(400, Новый Структура("ошибка", "Тело запроса должно быть JSON-объектом"));
	КонецЕсли;

	ИмяНастройки = Тело.Получить("настройка");
	Если Не ЗначениеЗаполнено(ИмяНастройки) Тогда
		Возврат ОтветJSON(400, Новый Структура("ошибка", "Не задана настройка"));
	КонецЕсли;

	НачалоПериода = СверкаДанных.ДатаИзТекста(Тело.Получить("начало"));
	КонецПериода = СверкаДанных.ДатаИзТекста(Тело.Получить("конец"));
	Перечитать = (Тело.Получить("перечитать") = Истина);
	Лимит = Тело.Получить("лимит");
	Если ТипЗнч(Лимит) <> Тип("Число") Тогда
		Лимит = 100;
	КонецЕсли;

	Попытка
		ЗапускОбъект = СверкаДанных.ВыполнитьСверкуПоИмени(ИмяНастройки, НачалоПериода, КонецПериода, Перечитать,
			НастройкиПроекта.ТекстЗначения(Тело.Получить("проект")));
	Исключение
		Возврат ОтветJSON(404, Новый Структура("ошибка", ОписаниеОшибки()));
	КонецПопытки;

	Итог = СверкаДанных.ИтогЗапуска(ЗапускОбъект, Лимит);
	КодОтвета = ?(ЗапускОбъект.Состояние = "Выполнено", 200, 500);

	Возврат ОтветJSON(КодОтвета, Итог);

КонецФункции

// Синхронизация настроек проекта с его репозиторием. 200 - без конфликтов, 409 - есть конфликты
// (что не конфликтует, сделано), 400 - ошибка в запросе, 404 - нет проекта, 500 - ошибка синхронизации.
Функция СинхронизироватьНастройки(Запрос) Экспорт

	Попытка
		Тело = Запрос.ТелоJSON();
	Исключение
		Возврат ОтветJSON(400, Новый Структура("ошибка", "Тело запроса должно быть JSON"));
	КонецПопытки;
	Если ТипЗнч(Тело) <> Тип("Соответствие") Тогда
		Возврат ОтветJSON(400, Новый Структура("ошибка", "Тело запроса должно быть JSON-объектом"));
	КонецЕсли;

	ИмяПроекта = Тело.Получить("проект");
	Действие = Тело.Получить("действие");
	Если Не ЗначениеЗаполнено(ИмяПроекта) Или (Действие <> "получить" И Действие <> "отправить") Тогда
		Возврат ОтветJSON(400, Новый Структура("ошибка", "Нужны проект и действие: получить или отправить"));
	КонецЕсли;
	Если Справочники.ПроектыСверки.НайтиПоНаименованию(ИмяПроекта) = Неопределено Тогда
		Возврат ОтветJSON(404, Новый Структура("ошибка", "Не найден проект сверки " + ИмяПроекта));
	КонецЕсли;

	Попытка
		Итог = РепозиторийНастроек.Синхронизировать(ИмяПроекта, Действие, Тело.Получить("заменитьЛокальные") = Истина);
	Исключение
		Возврат ОтветJSON(500, Новый Структура("ошибка", ОписаниеОшибки()));
	КонецПопытки;

	Возврат ОтветJSON(?(Итог.Получить("конфликты").Количество() = 0, 200, 409), Итог);

КонецФункции
