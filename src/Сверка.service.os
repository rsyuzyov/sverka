// HTTP-сервис сверки для агентов.
// POST /hs/sverka/run, тело JSON:
// {"настройка": "имя", "начало": "2024-01-01", "конец": "2024-01-01", "перечитать": false, "лимит": 100}
Функция ЗапуститьСверку(Запрос) Экспорт

	Попытка
		Тело = Запрос.ТелоJSON();
	Исключение
		Возврат ОтветJSON(400, Новый Структура("ошибка", "Тело запроса должно быть JSON"));
	КонецПопытки;

	Если ТипЗнч(Тело) <> Тип("Соответствие") Тогда
		Возврат ОтветJSON(400, Новый Структура("ошибка", "Тело запроса должно быть JSON-объектом"));
	КонецЕсли;

	ИмяНастройки = Тело.Получить("настройка");
	Если Не ЗначениеЗаполнено(ИмяНастройки) Тогда
		Возврат ОтветJSON(400, Новый Структура("ошибка", "Не задана настройка"));
	КонецЕсли;

	НачалоПериода = ДатаИзТекста(Тело.Получить("начало"));
	КонецПериода = ДатаИзТекста(Тело.Получить("конец"));
	Перечитать = (Тело.Получить("перечитать") = Истина);
	Лимит = Тело.Получить("лимит");
	Если ТипЗнч(Лимит) <> Тип("Число") Тогда
		Лимит = 100;
	КонецЕсли;

	Попытка
		ЗапускОбъект = СверкаДанных.ВыполнитьСверкуПоИмени(ИмяНастройки, НачалоПериода, КонецПериода, Перечитать);
	Исключение
		Возврат ОтветJSON(404, Новый Структура("ошибка", ОписаниеОшибки()));
	КонецПопытки;

	Итог = СверкаДанных.ИтогЗапуска(ЗапускОбъект, Лимит);
	КодОтвета = ?(ЗапускОбъект.Состояние = "Выполнено", 200, 500);

	Возврат ОтветJSON(КодОтвета, Итог);

КонецФункции

Функция ДатаИзТекста(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Дата(Лев(Строка(Значение), 10));

КонецФункции
