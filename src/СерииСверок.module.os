// Серия сверок: одна, несколько или все настройки проекта за период по шагам (месяц или весь период).
// На каждую пару «настройка, период» - обычный запуск СверкаДанных.ВыполнитьСверку (документ ЗапускСверки),
// сводка - в документе СерияСверок: строка на запуск (ТЧ Строки) и итоги числовых полей (ТЧ ИтогиПолей).
// Ошибка одного запуска серию не прерывает. Серия пишется после каждого запуска и продолжается с места
// остановки: повторный ВыполнитьСерию пропускает пары, для которых строка уже есть.

Функция ШагМесяц() Экспорт
	Возврат "месяц";
КонецФункции

Функция ШагВесьПериод() Экспорт
	Возврат "весь период";
КонецФункции

// Имя регламентного задания, через очередь которого серия выполняется в фоне.
Функция ИмяФоновогоЗадания() Экспорт
	Возврат "ВыполнитьСериюФоново";
КонецФункции

// Шаг серии из текста: пусто - месяц.
Функция ШагСерии(Значение) Экспорт

	Текст = НРег(СокрЛП(НастройкиПроекта.ТекстЗначения(Значение)));
	Если Текст = "" Или Текст = ШагМесяц() Тогда
		Возврат ШагМесяц();
	ИначеЕсли Текст = ШагВесьПериод() Или Текст = "весь" Тогда
		Возврат ШагВесьПериод();
	КонецЕсли;

	ВызватьИсключение "Неизвестный шаг серии «" + Текст + "»: ожидается «" + ШагМесяц() + "» или «" + ШагВесьПериод() + "»";

КонецФункции

// Имена настроек из массива (JSON) или из текста: по одной в строке или через «;».
Функция РазобратьИменаНастроек(Значение) Экспорт

	Имена = Новый Массив;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Части = Значение;
	Иначе
		Части = СтрРазделить(СтрЗаменить(НастройкиПроекта.ТекстЗначения(Значение), ";", Символы.ПС), Символы.ПС);
	КонецЕсли;
	Для Каждого Часть Из Части Цикл
		Имя = СокрЛП(НастройкиПроекта.ТекстЗначения(Часть));
		Если ЗначениеЗаполнено(Имя) И ТипЗнч(Имена.Найти(Имя)) <> Тип("Число") Тогда
			Имена.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Имена;

КонецФункции

// Конец периода серии: дата без времени включается целиком, до 23:59:59.
Функция КонецПериодаСерии(КонецПериода) Экспорт

	Если Час(КонецПериода) = 0 И Минута(КонецПериода) = 0 И Секунда(КонецПериода) = 0 Тогда
		Возврат КонецДня(КонецПериода);
	КонецЕсли;

	Возврат КонецПериода;

КонецФункции

// Создает и записывает серию. Настройки проверяются сразу, чтобы ошибка в имени не уходила в фон.
// ИменаНастроек пусто - все настройки проекта (тогда проект обязателен).
Функция СоздатьСерию(ИмяПроекта, ИменаНастроек, НачалоПериода, КонецПериода, Шаг, Перечитать) Экспорт

	Проект = НастройкиПроекта.НайтиПроект(НастройкиПроекта.ТекстЗначения(ИмяПроекта));
	Имена = РазобратьИменаНастроек(ИменаНастроек);
	Если Имена.Количество() = 0 И Не ЗначениеЗаполнено(Проект) Тогда
		ВызватьИсключение "Не заданы ни настройки, ни проект: для серии по всем настройкам нужен проект";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(НачалоПериода) Или Не ЗначениеЗаполнено(КонецПериода) Тогда
		ВызватьИсключение "Не задано начало или конец периода серии";
	КонецЕсли;
	Если НачалоПериода > КонецПериода Тогда
		ВызватьИсключение "Начало периода серии позже конца";
	КонецЕсли;

	СерияОбъект = Документы.СерияСверок.Создать();
	СерияОбъект.Дата = ТекущаяДатаВремя();
	СерияОбъект.Проект = Проект;
	СерияОбъект.Настройки = СтрСоединить(Имена, Символы.ПС);
	СерияОбъект.НачалоПериода = НачалоДня(НачалоПериода);
	СерияОбъект.КонецПериода = КонецПериодаСерии(КонецПериода);
	СерияОбъект.Шаг = ШагСерии(Шаг);
	СерияОбъект.Перечитать = (Перечитать = Истина);
	СерияОбъект.Состояние = "Новая";

	Если НастройкиСерии(СерияОбъект).Количество() = 0 Тогда
		ВызватьИсключение "В проекте " + НастройкиПроекта.ПредставлениеПроекта(Проект) + " нет настроек сверки";
	КонецЕсли;

	СерияОбъект.Записать();

	Возврат СерияОбъект;

КонецФункции

// Настройки серии: массив структур Ссылка, Имя. Без списка имен - все настройки проекта по алфавиту.
Функция НастройкиСерии(СерияОбъект) Экспорт

	ИмяПроекта = НастройкиПроекта.НаименованиеПроекта(СерияОбъект.Проект);
	Имена = РазобратьИменаНастроек(СерияОбъект.Настройки);
	Если Имена.Количество() = 0 Тогда
		Имена = НастройкиПроекта.НаименованияОбъектов(НастройкиПроекта.ВидНастройка(), СерияОбъект.Проект);
	КонецЕсли;

	Настройки = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Настройка = Новый Структура;
		Настройка.Вставить("Ссылка", НастройкиПроекта.НайтиНастройкуДляЗапуска(Имя, ИмяПроекта));
		Настройка.Вставить("Имя", Имя);
		Настройки.Добавить(Настройка);
	КонецЦикла;

	Возврат Настройки;

КонецФункции

// Периоды серии: массив структур Начало, Конец. Шаг «месяц» режет период по календарным месяцам,
// крайние месяцы обрезаются границами серии; «весь период» - один период.
Функция ПериодыСерии(НачалоПериода, КонецПериода, Шаг) Экспорт

	Периоды = Новый Массив;
	Если ШагСерии(Шаг) = ШагВесьПериод() Тогда
		Периоды.Добавить(Новый Структура("Начало, Конец", НачалоПериода, КонецПериода));
		Возврат Периоды;
	КонецЕсли;

	НачалоШага = НачалоПериода;
	Пока НачалоШага <= КонецПериода Цикл
		КонецШага = КонецМесяца(НачалоШага);
		Если КонецШага > КонецПериода Тогда
			КонецШага = КонецПериода;
		КонецЕсли;
		Периоды.Добавить(Новый Структура("Начало, Конец", НачалоШага, КонецШага));
		НачалоШага = ДобавитьМесяц(НачалоМесяца(НачалоШага), 1);
	КонецЦикла;

	Возврат Периоды;

КонецФункции

// Выполняет недостающие запуски серии и записывает ее после каждого запуска.
Функция ВыполнитьСерию(СерияОбъект) Экспорт

	НачалоСерии = ТекущаяДатаВремя();
	СекундРанее = НастройкиПроекта.ЧислоЗначения(СерияОбъект.Секунд);
	СерияОбъект.Состояние = "Выполняется";
	СерияОбъект.ТекстОшибки = "";
	СерияОбъект.Записать();

	Попытка
		Настройки = НастройкиСерии(СерияОбъект);
		Периоды = ПериодыСерии(СерияОбъект.НачалоПериода, СерияОбъект.КонецПериода, СерияОбъект.Шаг);
	Исключение
		СерияОбъект.Состояние = "Ошибка";
		СерияОбъект.ТекстОшибки = ОписаниеОшибки();
		ОбновитьСводку(СерияОбъект);
		СерияОбъект.Записать();
		Возврат СерияОбъект;
	КонецПопытки;

	Для Каждого Настройка Из Настройки Цикл
		Для Каждого Период Из Периоды Цикл
			Если ЕстьСтрокаСерии(СерияОбъект, Настройка.Имя, Период.Начало) Тогда
				Продолжить;
			КонецЕсли;
			ВыполнитьЗапускСерии(СерияОбъект, Настройка, Период);
			СерияОбъект.Секунд = Окр(СекундРанее + (ТекущаяДатаВремя() - НачалоСерии), 1);
			ОбновитьСводку(СерияОбъект);
			СерияОбъект.Записать();
		КонецЦикла;
	КонецЦикла;

	СерияОбъект.Секунд = Окр(СекундРанее + (ТекущаяДатаВремя() - НачалоСерии), 1);
	ОбновитьСводку(СерияОбъект);
	СерияОбъект.Состояние = ?(СерияОбъект.ЗапусковСОшибкой > 0, "Выполнено с ошибками", "Выполнено");
	СерияОбъект.ТекстСводки = ТекстСводки(СерияОбъект);
	СерияОбъект.Записать();

	Возврат СерияОбъект;

КонецФункции

Функция ЕстьСтрокаСерии(СерияОбъект, ИмяНастройки, НачалоПериода)

	КлючПериода = ТекстДаты(НачалоПериода);
	Для Каждого СтрокаСерии Из СерияОбъект.Строки Цикл
		Если СтрокаСерии.ИмяНастройки = ИмяНастройки И ТекстДаты(СтрокаСерии.НачалоПериода) = КлючПериода Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Один запуск серии: обычный ЗапускСверки; его счетчики и итоги полей переносятся в серию.
Процедура ВыполнитьЗапускСерии(СерияОбъект, Настройка, Период)

	СтрокаСерии = СерияОбъект.Строки.Добавить();
	СтрокаСерии.Настройка = Настройка.Ссылка;
	СтрокаСерии.ИмяНастройки = Настройка.Имя;
	СтрокаСерии.НачалоПериода = Период.Начало;
	СтрокаСерии.КонецПериода = Период.Конец;
	НачалоЗапуска = ТекущаяДатаВремя();

	Попытка
		ЗапускОбъект = СверкаДанных.ВыполнитьСверку(Настройка.Ссылка, Период.Начало, Период.Конец, СерияОбъект.Перечитать);
		СтрокаСерии.Запуск = Документы.ЗапускСверки.НайтиПоНомеру(ЗапускОбъект.Номер);
		СтрокаСерии.Состояние = ЗапускОбъект.Состояние;
		СтрокаСерии.КлючейА = ЗапускОбъект.КлючейА;
		СтрокаСерии.КлючейБ = ЗапускОбъект.КлючейБ;
		СтрокаСерии.Совпало = ЗапускОбъект.КлючейСовпало;
		СтрокаСерии.Расходится = ЗапускОбъект.КлючейРасходится;
		СтрокаСерии.НетВА = ЗапускОбъект.КлючейНетВА;
		СтрокаСерии.НетВБ = ЗапускОбъект.КлючейНетВБ;
		СтрокаСерии.Исключено = ЗапускОбъект.КлючейПомечено;
		СтрокаСерии.Ошибка = Лев(НастройкиПроекта.ТекстЗначения(ЗапускОбъект.ТекстОшибки), 1000);
		Для Каждого ИтогЗапуска Из ЗапускОбъект.ИтогиПолей Цикл
			СтрокаИтога = СерияОбъект.ИтогиПолей.Добавить();
			СтрокаИтога.ИмяНастройки = Настройка.Имя;
			СтрокаИтога.НачалоПериода = Период.Начало;
			СтрокаИтога.Поле = ИтогЗапуска.Поле;
			СтрокаИтога.СуммаА = ИтогЗапуска.СуммаА;
			СтрокаИтога.СуммаБ = ИтогЗапуска.СуммаБ;
			СтрокаИтога.Разница = ИтогЗапуска.Разница;
			СтрокаИтога.РасхождениеПоМодулю = ИтогЗапуска.РасхождениеПоМодулю;
		КонецЦикла;
	Исключение
		СтрокаСерии.Состояние = "Ошибка";
		СтрокаСерии.Ошибка = Лев(ОписаниеОшибки(), 1000);
	КонецПопытки;

	СтрокаСерии.Секунд = Окр(ТекущаяДатаВремя() - НачалоЗапуска, 1);

КонецПроцедуры

// Счетчики шапки и текст сводки по строкам серии.
Процедура ОбновитьСводку(СерияОбъект) Экспорт

	ЗапусковСОшибкой = 0;
	ЗапусковСРасхождениями = 0;
	Для Каждого СтрокаСерии Из СерияОбъект.Строки Цикл
		Если СтрокаСерии.Состояние <> "Выполнено" Тогда
			ЗапусковСОшибкой = ЗапусковСОшибкой + 1;
		ИначеЕсли ЕстьРасхождения(СтрокаСерии) Тогда
			ЗапусковСРасхождениями = ЗапусковСРасхождениями + 1;
		КонецЕсли;
	КонецЦикла;
	СерияОбъект.ЗапусковВсего = СерияОбъект.Строки.Количество();
	СерияОбъект.ЗапусковСОшибкой = ЗапусковСОшибкой;
	СерияОбъект.ЗапусковСРасхождениями = ЗапусковСРасхождениями;
	СерияОбъект.ТекстСводки = ТекстСводки(СерияОбъект);

КонецПроцедуры

// Ключи, исключенные из сверки (колонка Помечен), расхождением не считаются.
Функция ЕстьРасхождения(СтрокаСерии)

	Возврат НастройкиПроекта.ЧислоЗначения(СтрокаСерии.Расходится) + НастройкиПроекта.ЧислоЗначения(СтрокаСерии.НетВА)
		+ НастройкиПроекта.ЧислоЗначения(СтрокаСерии.НетВБ) > 0;

КонецФункции

// --- Вывод ---

// Сводка серии текстом: шапка, затем по настройкам - строка на период и итоги числовых полей.
Функция ТекстСводки(СерияОбъект) Экспорт

	СтрокиТекста = Новый Массив;
	СтрокиТекста.Добавить("Серия " + НастройкиПроекта.ТекстЗначения(СерияОбъект.Номер) + ": проект "
		+ НастройкиПроекта.ПредставлениеПроекта(СерияОбъект.Проект) + ", " + ТекстДаты(СерияОбъект.НачалоПериода)
		+ " - " + ТекстДаты(СерияОбъект.КонецПериода) + ", шаг " + ШагСерии(СерияОбъект.Шаг)
		+ ?(СерияОбъект.Перечитать = Истина, ", без кэша", "") + "; " + НРег(СерияОбъект.Состояние));
	ЗапусковВсего = НастройкиПроекта.ЧислоЗначения(СерияОбъект.ЗапусковВсего);
	ЗапусковСОшибкой = НастройкиПроекта.ЧислоЗначения(СерияОбъект.ЗапусковСОшибкой);
	ЗапусковСРасхождениями = НастройкиПроекта.ЧислоЗначения(СерияОбъект.ЗапусковСРасхождениями);
	СтрокиТекста.Добавить("Запусков " + ЧислоТекстом(ЗапусковВсего, 0) + ": без расхождений "
		+ ЧислоТекстом(ЗапусковВсего - ЗапусковСОшибкой - ЗапусковСРасхождениями, 0)
		+ ", с расхождениями " + ЧислоТекстом(ЗапусковСРасхождениями, 0)
		+ ", с ошибкой " + ЧислоТекстом(ЗапусковСОшибкой, 0)
		+ "; " + ЧислоТекстом(СерияОбъект.Секунд, 1) + " с");
	Если ЗначениеЗаполнено(СерияОбъект.ТекстОшибки) Тогда
		СтрокиТекста.Добавить("Ошибка серии: " + СерияОбъект.ТекстОшибки);
	КонецЕсли;

	ТекущаяНастройка = Неопределено;
	Для Каждого СтрокаСерии Из СерияОбъект.Строки Цикл
		Если ТекущаяНастройка <> СтрокаСерии.ИмяНастройки Тогда
			ТекущаяНастройка = СтрокаСерии.ИмяНастройки;
			СтрокиТекста.Добавить("");
			СтрокиТекста.Добавить(ТекущаяНастройка);
		КонецЕсли;
		СтрокиТекста.Добавить("  " + ТекстПериода(СерияОбъект, СтрокаСерии) + "  " + ТекстСтроки(СтрокаСерии));
		Для Каждого СтрокаИтога Из ИтогиСтроки(СерияОбъект, СтрокаСерии) Цикл
			СтрокиТекста.Добавить("      " + СтрокаИтога.Поле + ": А " + ЧислоТекстом(СтрокаИтога.СуммаА, 2)
				+ ", Б " + ЧислоТекстом(СтрокаИтога.СуммаБ, 2) + ", разница " + ЧислоТекстом(СтрокаИтога.Разница, 2)
				+ ", расхождение по модулю " + ЧислоТекстом(СтрокаИтога.РасхождениеПоМодулю, 2));
		КонецЦикла;
	КонецЦикла;

	Возврат СтрСоединить(СтрокиТекста, Символы.ПС);

КонецФункции

Функция ТекстСтроки(СтрокаСерии)

	НомерЗапуска = "";
	Если ЗначениеЗаполнено(СтрокаСерии.Запуск) Тогда
		НомерЗапуска = Строка(СтрокаСерии.Запуск) + "  ";
	КонецЕсли;
	Если СтрокаСерии.Состояние <> "Выполнено" Тогда
		Возврат НомерЗапуска + "ОШИБКА: " + СтрЗаменить(НастройкиПроекта.ТекстЗначения(СтрокаСерии.Ошибка), Символы.ПС, " ");
	КонецЕсли;

	Возврат НомерЗапуска + "ключей А " + ЧислоТекстом(СтрокаСерии.КлючейА, 0) + " / Б " + ЧислоТекстом(СтрокаСерии.КлючейБ, 0)
		+ ", совпало " + ЧислоТекстом(СтрокаСерии.Совпало, 0) + ", расходится " + ЧислоТекстом(СтрокаСерии.Расходится, 0)
		+ ", нет в А " + ЧислоТекстом(СтрокаСерии.НетВА, 0) + ", нет в Б " + ЧислоТекстом(СтрокаСерии.НетВБ, 0)
		+ ", исключено " + ЧислоТекстом(СтрокаСерии.Исключено, 0) + "; " + ЧислоТекстом(СтрокаСерии.Секунд, 1) + " с";

КонецФункции

// Период строки: при шаге «месяц» - ГГГГ-ММ, иначе даты начала и конца.
Функция ТекстПериода(СерияОбъект, СтрокаСерии)

	Если ШагСерии(СерияОбъект.Шаг) = ШагМесяц() Тогда
		Возврат Формат(СтрокаСерии.НачалоПериода, "ДФ=yyyy-MM");
	КонецЕсли;

	Возврат ТекстДаты(СтрокаСерии.НачалоПериода) + " - " + ТекстДаты(СтрокаСерии.КонецПериода);

КонецФункции

// Строки ТЧ ИтогиПолей, относящиеся к строке серии.
Функция ИтогиСтроки(СерияОбъект, СтрокаСерии)

	Итоги = Новый Массив;
	КлючПериода = ТекстДаты(СтрокаСерии.НачалоПериода);
	Для Каждого СтрокаИтога Из СерияОбъект.ИтогиПолей Цикл
		Если СтрокаИтога.ИмяНастройки = СтрокаСерии.ИмяНастройки И ТекстДаты(СтрокаИтога.НачалоПериода) = КлючПериода Тогда
			Итоги.Добавить(СтрокаИтога);
		КонецЕсли;
	КонецЦикла;

	Возврат Итоги;

КонецФункции

// Сводка серии для JSON (Соответствие: ЗаписатьJSON переводит ключи структуры в нижний регистр).
Функция ИтогСерии(СерияОбъект) Экспорт

	Итог = Новый Соответствие;
	Итог.Вставить("номер", СерияОбъект.Номер);
	Итог.Вставить("проект", НастройкиПроекта.НаименованиеПроекта(СерияОбъект.Проект));
	Итог.Вставить("настройки", РазобратьИменаНастроек(СерияОбъект.Настройки));
	Итог.Вставить("начало", ТекстДаты(СерияОбъект.НачалоПериода));
	Итог.Вставить("конец", ТекстДаты(СерияОбъект.КонецПериода));
	Итог.Вставить("шаг", ШагСерии(СерияОбъект.Шаг));
	Итог.Вставить("перечитать", СерияОбъект.Перечитать = Истина);
	Итог.Вставить("состояние", СерияОбъект.Состояние);
	Итог.Вставить("ошибка", НастройкиПроекта.ТекстЗначения(СерияОбъект.ТекстОшибки));
	Итог.Вставить("задача", НастройкиПроекта.ТекстЗначения(СерияОбъект.ИдЗадачи));
	Итог.Вставить("запусков", НастройкиПроекта.ЧислоЗначения(СерияОбъект.ЗапусковВсего));
	Итог.Вставить("запусковСРасхождениями", НастройкиПроекта.ЧислоЗначения(СерияОбъект.ЗапусковСРасхождениями));
	Итог.Вставить("запусковСОшибкой", НастройкиПроекта.ЧислоЗначения(СерияОбъект.ЗапусковСОшибкой));
	Итог.Вставить("секунд", НастройкиПроекта.ЧислоЗначения(СерияОбъект.Секунд));

	Строки = Новый Массив;
	Для Каждого СтрокаСерии Из СерияОбъект.Строки Цикл
		Элемент = Новый Соответствие;
		Элемент.Вставить("настройка", СтрокаСерии.ИмяНастройки);
		Элемент.Вставить("начало", ТекстДаты(СтрокаСерии.НачалоПериода));
		Элемент.Вставить("конец", ТекстДаты(СтрокаСерии.КонецПериода));
		Элемент.Вставить("запуск", ?(ЗначениеЗаполнено(СтрокаСерии.Запуск), Строка(СтрокаСерии.Запуск), ""));
		Элемент.Вставить("состояние", СтрокаСерии.Состояние);
		Элемент.Вставить("ключейА", НастройкиПроекта.ЧислоЗначения(СтрокаСерии.КлючейА));
		Элемент.Вставить("ключейБ", НастройкиПроекта.ЧислоЗначения(СтрокаСерии.КлючейБ));
		Элемент.Вставить("совпало", НастройкиПроекта.ЧислоЗначения(СтрокаСерии.Совпало));
		Элемент.Вставить("расходится", НастройкиПроекта.ЧислоЗначения(СтрокаСерии.Расходится));
		Элемент.Вставить("нетВА", НастройкиПроекта.ЧислоЗначения(СтрокаСерии.НетВА));
		Элемент.Вставить("нетВБ", НастройкиПроекта.ЧислоЗначения(СтрокаСерии.НетВБ));
		Элемент.Вставить("исключено", НастройкиПроекта.ЧислоЗначения(СтрокаСерии.Исключено));
		Элемент.Вставить("секунд", НастройкиПроекта.ЧислоЗначения(СтрокаСерии.Секунд));
		Элемент.Вставить("ошибка", НастройкиПроекта.ТекстЗначения(СтрокаСерии.Ошибка));
		Итоги = Новый Массив;
		Для Каждого СтрокаИтога Из ИтогиСтроки(СерияОбъект, СтрокаСерии) Цикл
			Итоги.Добавить(ЭлементИтога(СтрокаИтога.Поле, СтрокаИтога.СуммаА, СтрокаИтога.СуммаБ,
				СтрокаИтога.РасхождениеПоМодулю));
		КонецЦикла;
		Элемент.Вставить("итогиПолей", Итоги);
		Строки.Добавить(Элемент);
	КонецЦикла;
	Итог.Вставить("строки", Строки);
	Итог.Вставить("итогиПоНастройкам", ИтогиПоНастройкам(СерияОбъект));

	Возврат Итог;

КонецФункции

Функция ЭлементИтога(ИмяПоля, СуммаА, СуммаБ, РасхождениеПоМодулю)

	Элемент = Новый Соответствие;
	Элемент.Вставить("поле", ИмяПоля);
	Элемент.Вставить("суммаА", НастройкиПроекта.ЧислоЗначения(СуммаА));
	Элемент.Вставить("суммаБ", НастройкиПроекта.ЧислоЗначения(СуммаБ));
	Элемент.Вставить("разница", НастройкиПроекта.ЧислоЗначения(СуммаА) - НастройкиПроекта.ЧислоЗначения(СуммаБ));
	Элемент.Вставить("расхождениеПоМодулю", НастройкиПроекта.ЧислоЗначения(РасхождениеПоМодулю));

	Возврат Элемент;

КонецФункции

// Итоги полей за всю серию по каждой настройке: массив {настройка, поле, суммаА, суммаБ, разница,
// расхождениеПоМодулю}. Суммы по периодам складываются - это осмысленно для оборотов, для остатков нет.
Функция ИтогиПоНастройкам(СерияОбъект)

	Ключи = Новый Массив;
	Накопления = Новый Соответствие;
	Для Каждого СтрокаИтога Из СерияОбъект.ИтогиПолей Цикл
		Ключ = СтрокаИтога.ИмяНастройки + Символы.Таб + СтрокаИтога.Поле;
		Накоплено = Накопления.Получить(Ключ);
		Если Накоплено = Неопределено Тогда
			Ключи.Добавить(Ключ);
			Накоплено = Новый Структура("Настройка, Поле, СуммаА, СуммаБ, РасхождениеПоМодулю",
				СтрокаИтога.ИмяНастройки, СтрокаИтога.Поле, 0, 0, 0);
			Накопления.Вставить(Ключ, Накоплено);
		КонецЕсли;
		Накоплено.СуммаА = Накоплено.СуммаА + НастройкиПроекта.ЧислоЗначения(СтрокаИтога.СуммаА);
		Накоплено.СуммаБ = Накоплено.СуммаБ + НастройкиПроекта.ЧислоЗначения(СтрокаИтога.СуммаБ);
		Накоплено.РасхождениеПоМодулю = Накоплено.РасхождениеПоМодулю
			+ НастройкиПроекта.ЧислоЗначения(СтрокаИтога.РасхождениеПоМодулю);
	КонецЦикла;

	Итоги = Новый Массив;
	Для Каждого Ключ Из Ключи Цикл
		Накоплено = Накопления.Получить(Ключ);
		Элемент = ЭлементИтога(Накоплено.Поле, Накоплено.СуммаА, Накоплено.СуммаБ, Накоплено.РасхождениеПоМодулю);
		Элемент.Вставить("настройка", Накоплено.Настройка);
		Итоги.Добавить(Элемент);
	КонецЦикла;

	Возврат Итоги;

КонецФункции

Функция ТекстДаты(Значение) Экспорт

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Формат(Значение, "ДФ=yyyy-MM-dd");

КонецФункции

Функция ЧислоТекстом(Значение, ЗнаковПослеЗапятой)

	Возврат Формат(НастройкиПроекта.ЧислоЗначения(Значение), "ЧДЦ=" + Строка(ЗнаковПослеЗапятой) + "; ЧН=0");

КонецФункции

// --- Поиск и фоновый режим ---

// Серия по номеру или Неопределено.
Функция НайтиСерию(НомерСерии) Экспорт

	Если Не ЗначениеЗаполнено(НомерСерии) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Серия = Документы.СерияСверок.НайтиПоНомеру(НомерСерии);
	Если Серия = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Серия.ПолучитьОбъект();

КонецФункции

// Ставит серию в очередь фоновых заданий (работает только на запущенном сервере базы, не в procrun).
// Ключ идемпотентности - номер серии: пока задача жива, повторная постановка вернет ее же.
Функция ПоставитьВОчередь(СерияОбъект) Экспорт

	ИдЗадачи = ФоновыеЗадания.Поставить(ИмяФоновогоЗадания(), Новый Структура("НомерСерии", СерияОбъект.Номер),
		"серия-" + СерияОбъект.Номер);
	СерияОбъект.ИдЗадачи = ИдЗадачи;
	СерияОбъект.Состояние = "В очереди";
	ОбновитьСводку(СерияОбъект);
	СерияОбъект.Записать();

	Возврат ИдЗадачи;

КонецФункции
