// Построение страницы «Сверка на дату» (pages/Сверка.yaml; обработчик страницы только вызывает этот модуль:
// в модуле страницы доступны лишь процедуры ПриФормировании и действия, своих функций он не видит).
// Страница «Сверка на дату»: выбрать настройку и дату, сверить, посмотреть ключи с эталоном и пояснением
// и провалиться в расшифровку ключа. Параметры строки запроса: проект, настройка, дата (ГГГГ-ММ-ДД),
// ключ (отбор расшифровки по первой части ключа), все (1 - показать и совпавшие ключи расшифровки).
// Сверка на дату - период с начала месяца даты по конец дня даты; кнопка «Сверить» запускает настройку
// и ее расшифровку заново, без кэша, и страница показывает последний выполненный запуск.

Процедура Сформировать(Страница, Параметры) Экспорт

	ИмяНастройки = ПараметрСтраницы(Параметры, "настройка");
	Если Не ЗначениеЗаполнено(ИмяНастройки) Тогда
		ПоказатьНастройки(Страница);
		Возврат;
	КонецЕсли;

	ИмяПроекта = ПараметрСтраницы(Параметры, "проект");
	Настройка = НастройкиПроекта.НайтиНастройкуДляЗапуска(ИмяНастройки, ИмяПроекта);
	НастройкаОбъект = Настройка.ПолучитьОбъект();
	ДатаСверки = ДатаПараметра(Параметры);
	ОтборКлюча = ПараметрСтраницы(Параметры, "ключ");

	Страница.Заголовок(ИмяНастройки + ?(ЗначениеЗаполнено(ОтборКлюча), ": " + ОтборКлюча, ""));
	ИмяА = Строка(НастройкаОбъект.ИсточникА);
	ИмяБ = Строка(НастройкаОбъект.ИсточникБ);
	Страница.Абзац("А - " + ИмяА + ", Б - " + ИмяБ + ". Разница = А - Б.");
	Если ЗначениеЗаполнено(ОтборКлюча) Тогда
		Страница.Кнопка("К общей сверке", АдресСтраницы(ИмяПроекта, ИмяНастройкиВерхнего(Настройка, ИмяПроекта), ДатаСверки, "", ""));
	КонецЕсли;

	ПоказатьДаты(Страница, ИмяПроекта, ИмяНастройки, ДатаСверки, ОтборКлюча);
	Если Не ЗначениеЗаполнено(ДатаСверки) Тогда
		Возврат;
	КонецЕсли;

	Запуск = ПоследнийЗапуск(Настройка, ДатаСверки);
	Страница.Разделитель();
	Если Запуск = Неопределено Тогда
		Страница.Абзац("На " + ТекстДаты(ДатаСверки) + " сверки еще не было.");
		Страница.КнопкаДействие("Сверить", "Сверить");
		Возврат;
	КонецЕсли;

	ЗапускОбъект = Запуск.ПолучитьОбъект();
	Страница.Абзац("Запуск " + ЗапускОбъект.Номер + " от " + ТекстДатыВремени(ЗапускОбъект.Дата)
		+ ", состояние: " + ЗапускОбъект.Состояние + ".");
	Страница.КнопкаДействие("Сверить заново", "Сверить");
	Если ЗапускОбъект.Состояние <> "Выполнено" Тогда
		Страница.Абзац("Ошибка: " + ЗапускОбъект.ТекстОшибки);
		Возврат;
	КонецЕсли;

	ВсеКлючи = (ПараметрСтраницы(Параметры, "все") = "1") Или Не ЗначениеЗаполнено(ОтборКлюча);
	ПоказатьКлючи(Страница, НастройкаОбъект, ЗапускОбъект, ИмяПроекта, ДатаСверки, ОтборКлюча, ВсеКлючи, ИмяА, ИмяБ);

	Если ЗначениеЗаполнено(ОтборКлюча) Тогда
		Если ВсеКлючи Тогда
			Страница.Кнопка("Только расхождения", АдресСтраницы(ИмяПроекта, ИмяНастройки, ДатаСверки, ОтборКлюча, ""));
		Иначе
			Страница.Кнопка("Показать и совпавшие", АдресСтраницы(ИмяПроекта, ИмяНастройки, ДатаСверки, ОтборКлюча, "1"));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Кнопка «Сверить»: настройка страницы и ее расшифровка (если задана) на дату, без кэша.
Процедура Сверить(Страница, Параметры) Экспорт

	ИмяПроекта = ПараметрСтраницы(Параметры, "проект");
	Настройка = НастройкиПроекта.НайтиНастройкуДляЗапуска(ПараметрСтраницы(Параметры, "настройка"), ИмяПроекта);
	ДатаСверки = ДатаПараметра(Параметры);
	Если Не ЗначениеЗаполнено(ДатаСверки) Тогда
		ВызватьИсключение "Не выбрана дата сверки";
	КонецЕсли;

	Сверки = Новый Массив;
	Сверки.Добавить(Настройка);
	ИмяРасшифровки = НастройкиПроекта.ТекстЗначения(Настройка.ПолучитьОбъект().НастройкаРасшифровки);
	Если ЗначениеЗаполнено(ИмяРасшифровки) Тогда
		Сверки.Добавить(НастройкиПроекта.НайтиНастройкуДляЗапуска(ИмяРасшифровки, ИмяПроекта));
	КонецЕсли;

	Для Каждого НастройкаСверки Из Сверки Цикл
		ЗапускОбъект = СверкаДанных.ВыполнитьСверку(НастройкаСверки, НачалоМесяца(ДатаСверки), КонецДня(ДатаСверки), Истина);
		Сообщить(Строка(НастройкаСверки) + ": " + ЗапускОбъект.Состояние + ", совпало " + ЧислоТекстом(ЗапускОбъект.КлючейСовпало, 0)
			+ ", расходится " + ЧислоТекстом(ЗапускОбъект.КлючейРасходится, 0) + ", нет в А " + ЧислоТекстом(ЗапускОбъект.КлючейНетВА, 0)
			+ ", нет в Б " + ЧислоТекстом(ЗапускОбъект.КлючейНетВБ, 0));
	КонецЦикла;

КонецПроцедуры

Процедура ПоказатьНастройки(Страница)

	Страница.Заголовок("Сверка на дату");
	Страница.Абзац("Выберите настройку. Настройки с расшифровкой открывают сверку по ключам с переходом в аналитику.");
	Таблица = Страница.Таблица("Настройки");
	Таблица.Колонки("Проект", "Настройка", "Расшифровка", "Последний запуск");
	ЗапросНастроек = Новый Запрос;
	ЗапросНастроек.Текст = "ВЫБРАТЬ Наименование, Проект.Наименование КАК ИмяПроекта, НастройкаРасшифровки
		|ИЗ Справочник.НастройкиСверки
		|УПОРЯДОЧИТЬ ПО Проект.Наименование, Наименование";
	Для Каждого Запись Из ЗапросНастроек.Выполнить() Цикл
		ИмяПроекта = НастройкиПроекта.ТекстЗначения(Запись.ИмяПроекта);
		СтрокаТаблицы = Таблица.ДобавитьСтроку();
		СтрокаТаблицы.Установить("Проект", ИмяПроекта);
		СтрокаТаблицы.Установить("Настройка", Запись.Наименование);
		СтрокаТаблицы.Ссылка("Настройка", АдресСтраницы(ИмяПроекта, Запись.Наименование, Неопределено, "", ""));
		СтрокаТаблицы.Установить("Расшифровка", НастройкиПроекта.ТекстЗначения(Запись.НастройкаРасшифровки));
		Настройка = НастройкиПроекта.НайтиОбъект(НастройкиПроекта.ВидНастройка(), Запись.Наименование,
			НастройкиПроекта.НайтиПроект(ИмяПроекта));
		СтрокаТаблицы.Установить("Последний запуск", ТекстПоследнегоЗапуска(Настройка));
	КонецЦикла;

КонецПроцедуры

// Ссылки на концы последних двенадцати месяцев и на сегодня; выбранная дата - отдельной строкой.
Процедура ПоказатьДаты(Страница, ИмяПроекта, ИмяНастройки, ДатаСверки, ОтборКлюча)

	Если ЗначениеЗаполнено(ДатаСверки) Тогда
		Страница.Абзац("Дата сверки: " + ТекстДаты(ДатаСверки) + " (остатки - на конец дня).");
	КонецЕсли;
	Даты = Страница.Список(?(ЗначениеЗаполнено(ДатаСверки), "Другая дата", "Выберите дату"));
	Сегодня = НачалоДня(ТекущаяДата());
	Даты.Пункт("сегодня, " + ТекстДаты(Сегодня), АдресСтраницы(ИмяПроекта, ИмяНастройки, Сегодня, ОтборКлюча, ""));
	КонецМесяцаДаты = КонецМесяца(ДобавитьМесяц(Сегодня, -1));
	Для НомерМесяца = 1 По 12 Цикл
		Даты.Пункт(ТекстДаты(КонецМесяцаДаты), АдресСтраницы(ИмяПроекта, ИмяНастройки, НачалоДня(КонецМесяцаДаты), ОтборКлюча, ""));
		КонецМесяцаДаты = КонецМесяца(ДобавитьМесяц(НачалоМесяца(КонецМесяцаДаты), -1));
	КонецЦикла;

КонецПроцедуры

Процедура ПоказатьКлючи(Страница, НастройкаОбъект, ЗапускОбъект, ИмяПроекта, ДатаСверки, ОтборКлюча, ВсеКлючи, ИмяА, ИмяБ)

	Пояснения = СверкаДанных.РазобратьПояснения(НастройкаОбъект.Пояснения);
	ИмяРасшифровки = НастройкиПроекта.ТекстЗначения(НастройкаОбъект.НастройкаРасшифровки);
	КлючиРасшифровки = Новый Соответствие;
	Если ЗначениеЗаполнено(ИмяРасшифровки) Тогда
		КлючиРасшифровки = ПервыеЧастиКлючей(НастройкиПроекта.НайтиНастройкуДляЗапуска(ИмяРасшифровки, ИмяПроекта), ДатаСверки);
	КонецЕсли;

	Строки = СтрокиЗапуска(ЗапускОбъект);
	Допуск = НастройкиПроекта.ЧислоЗначения(НастройкаОбъект.Погрешность);
	ПоказыватьПоле = СверкаДанных.РазобратьСписокПолей(НастройкаОбъект.ПоляЗначений).Количество() > 1;
	Таблица = Страница.Таблица(?(ВсеКлючи, "Все ключи", "Расхождения"));
	Если ПоказыватьПоле Тогда
		Таблица.Колонки("Ключ", "Поле", ИмяА, ИмяБ, "Разница", "Эталон", "Пояснение");
	Иначе
		Таблица.Колонки("Ключ", ИмяА, ИмяБ, "Разница", "Эталон", "Пояснение");
	КонецЕсли;
	Показано = 0;
	Расходится = 0;
	Пояснено = 0;
	ИтогА = 0;
	ИтогБ = 0;
	Для Каждого СтрокаКлюча Из Строки Цикл
		Если ЗначениеЗаполнено(ОтборКлюча) И Не СтрНачинаетсяС(СтрокаКлюча.Ключ, ОтборКлюча + "|") Тогда
			Продолжить;
		КонецЕсли;
		// Ключ только на одной стороне с нулем в пределах погрешности - не расхождение.
		ЕстьРазница = Абс(СтрокаКлюча.Разница) > Допуск;
		Пояснение = Пояснения.Получить(СтрокаКлюча.Ключ);
		Если ЕстьРазница Тогда
			Расходится = Расходится + 1;
			Если Пояснение <> Неопределено И ЗначениеЗаполнено(Пояснение.Причина) Тогда
				Пояснено = Пояснено + 1;
			КонецЕсли;
		КонецЕсли;
		ИтогА = ИтогА + СтрокаКлюча.ЗначениеА;
		ИтогБ = ИтогБ + СтрокаКлюча.ЗначениеБ;
		Если Не ВсеКлючи И Не ЕстьРазница Тогда
			Продолжить;
		КонецЕсли;
		Показано = Показано + 1;
		СтрокаТаблицы = Таблица.ДобавитьСтроку();
		СтрокаТаблицы.Установить("Ключ", ПредставлениеСтроки(СтрокаКлюча, ОтборКлюча));
		Если КлючиРасшифровки.Получить(СтрокаКлюча.Ключ) = Истина Тогда
			СтрокаТаблицы.Ссылка("Ключ", АдресСтраницы(ИмяПроекта, ИмяРасшифровки, ДатаСверки, СтрокаКлюча.Ключ, ""));
		КонецЕсли;
		Если ПоказыватьПоле Тогда
			СтрокаТаблицы.Установить("Поле", СтрокаКлюча.Поле);
		КонецЕсли;
		СтрокаТаблицы.Установить(ИмяА, ?(СтрокаКлюча.НетВА, "нет", ЧислоТекстом(СтрокаКлюча.ЗначениеА, 2)));
		СтрокаТаблицы.Установить(ИмяБ, ?(СтрокаКлюча.НетВБ, "нет", ЧислоТекстом(СтрокаКлюча.ЗначениеБ, 2)));
		СтрокаТаблицы.Установить("Разница", ?(ЕстьРазница, ЧислоТекстом(СтрокаКлюча.Разница, 2), ""));
		Если Пояснение <> Неопределено Тогда
			СтрокаТаблицы.Установить("Эталон", Пояснение.Эталон);
			СтрокаТаблицы.Установить("Пояснение", Пояснение.Причина);
		ИначеЕсли ЕстьРазница Тогда
			СтрокаТаблицы.Установить("Пояснение", "нет пояснения");
		КонецЕсли;
	КонецЦикла;

	СтрокаИтога = Таблица.ДобавитьСтроку();
	СтрокаИтога.Установить("Ключ", "Итого");
	СтрокаИтога.Установить(ИмяА, ЧислоТекстом(ИтогА, 2));
	СтрокаИтога.Установить(ИмяБ, ЧислоТекстом(ИтогБ, 2));
	СтрокаИтога.Установить("Разница", ЧислоТекстом(ИтогА - ИтогБ, 2));

	Страница.Показатель("Расходится ключей", Расходится, "number");
	Страница.Показатель("Из них с пояснением", Пояснено, "number");
	Страница.Показатель("Без пояснения", Расходится - Пояснено, "number");
	Если Показано = 0 Тогда
		Страница.Абзац(?(ВсеКлючи, "Ключей нет.", "Расхождений нет."));
	КонецЕсли;

КонецПроцедуры

// Строки для таблицы: табличная часть Ключи, а у запуска без нее (настройка без признака «все ключи») -
// числовые расхождения. Колонки: Ключ, ПредставлениеКлюча, Поле, ЗначениеА, ЗначениеБ, Разница, НетВА, НетВБ.
Функция СтрокиЗапуска(ЗапускОбъект)

	Строки = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить("Ключ,ПредставлениеКлюча,Поле,ЗначениеА,ЗначениеБ,Разница,НетВА,НетВБ", ",") Цикл
		Строки.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;
	Источник = ?(ЗапускОбъект.Ключи.Количество() > 0, ЗапускОбъект.Ключи, ЗапускОбъект.Расхождения);
	Для Каждого СтрокаИсточника Из Источник Цикл
		НоваяСтрока = Строки.Добавить();
		НоваяСтрока.Ключ = СтрокаИсточника.Ключ;
		НоваяСтрока.ПредставлениеКлюча = НастройкиПроекта.ТекстЗначения(СтрокаИсточника.ПредставлениеКлюча);
		НоваяСтрока.Поле = НастройкиПроекта.ТекстЗначения(СтрокаИсточника.Поле);
		НоваяСтрока.ЗначениеА = НастройкиПроекта.ЧислоЗначения(СтрокаИсточника.ЗначениеА);
		НоваяСтрока.ЗначениеБ = НастройкиПроекта.ЧислоЗначения(СтрокаИсточника.ЗначениеБ);
		НоваяСтрока.Разница = НастройкиПроекта.ЧислоЗначения(СтрокаИсточника.Разница);
		НоваяСтрока.НетВА = НастройкиПроекта.ЗначениеПризнака(СтрокаИсточника.НетВА);
		НоваяСтрока.НетВБ = НастройкиПроекта.ЗначениеПризнака(СтрокаИсточника.НетВБ);
	КонецЦикла;
	Строки.Сортировать("Ключ, Поле");

	Возврат Строки;

КонецФункции

// Первые части ключей (до «|») последнего запуска расшифровки на дату: по ним видно, у каких ключей
// общей сверки есть расшифровка.
Функция ПервыеЧастиКлючей(НастройкаРасшифровки, ДатаСверки)

	Части = Новый Соответствие;
	Запуск = ПоследнийЗапуск(НастройкаРасшифровки, ДатаСверки);
	Если Запуск = Неопределено Тогда
		Возврат Части;
	КонецЕсли;
	ЗапускОбъект = Запуск.ПолучитьОбъект();
	Источник = ?(ЗапускОбъект.Ключи.Количество() > 0, ЗапускОбъект.Ключи, ЗапускОбъект.Расхождения);
	Для Каждого СтрокаИсточника Из Источник Цикл
		Части.Вставить(СтрРазделить(СтрокаИсточника.Ключ, "|").Получить(0), Истина);
	КонецЦикла;

	Возврат Части;

КонецФункции

// Последний выполненный запуск настройки за период с начала месяца даты по конец дня даты.
Функция ПоследнийЗапуск(Настройка, ДатаСверки)

	ЗапросЗапуска = Новый Запрос;
	ЗапросЗапуска.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Номер
		|ИЗ Документ.ЗапускСверки
		|ГДЕ Настройка = &Настройка И НачалоПериода = &НачалоПериода И КонецПериода = &КонецПериода
		|УПОРЯДОЧИТЬ ПО Дата УБЫВ";
	ЗапросЗапуска.УстановитьПараметр("Настройка", Настройка);
	ЗапросЗапуска.УстановитьПараметр("НачалоПериода", НачалоМесяца(ДатаСверки));
	ЗапросЗапуска.УстановитьПараметр("КонецПериода", КонецДня(ДатаСверки));
	Для Каждого Запись Из ЗапросЗапуска.Выполнить() Цикл
		Возврат Документы.ЗапускСверки.НайтиПоНомеру(Запись.Номер);
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ТекстПоследнегоЗапуска(Настройка)

	ЗапросЗапуска = Новый Запрос;
	ЗапросЗапуска.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Дата, КонецПериода, Состояние
		|ИЗ Документ.ЗапускСверки
		|ГДЕ Настройка = &Настройка
		|УПОРЯДОЧИТЬ ПО Дата УБЫВ";
	ЗапросЗапуска.УстановитьПараметр("Настройка", Настройка);
	Для Каждого Запись Из ЗапросЗапуска.Выполнить() Цикл
		Возврат "на " + ТекстДаты(Запись.КонецПериода) + ", " + НастройкиПроекта.ТекстЗначения(Запись.Состояние);
	КонецЦикла;

	Возврат "";

КонецФункции

// Имя настройки, у которой эта настройка - расшифровка (для кнопки «К общей сверке»); иначе своя.
Функция ИмяНастройкиВерхнего(Настройка, ИмяПроекта)

	ЗапросВерхнего = Новый Запрос;
	ЗапросВерхнего.Текст = "ВЫБРАТЬ Наименование, Проект.Наименование КАК ИмяПроекта ИЗ Справочник.НастройкиСверки
		|ГДЕ НастройкаРасшифровки = &ИмяРасшифровки";
	ЗапросВерхнего.УстановитьПараметр("ИмяРасшифровки", Настройка.ПолучитьОбъект().Наименование);
	Для Каждого Запись Из ЗапросВерхнего.Выполнить() Цикл
		Если НастройкиПроекта.ТекстЗначения(Запись.ИмяПроекта) = ИмяПроекта Тогда
			Возврат Запись.Наименование;
		КонецЕсли;
	КонецЦикла;

	Возврат Настройка.ПолучитьОбъект().Наименование;

КонецФункции

// Представление ключа: в расшифровке без повторения отобранной части.
Функция ПредставлениеСтроки(СтрокаКлюча, ОтборКлюча)

	Представление = ?(ЗначениеЗаполнено(СтрокаКлюча.ПредставлениеКлюча), СтрокаКлюча.ПредставлениеКлюча, СтрокаКлюча.Ключ);
	Если ЗначениеЗаполнено(ОтборКлюча) И СтрНачинаетсяС(Представление, ОтборКлюча + " | ") Тогда
		Представление = Сред(Представление, СтрДлина(ОтборКлюча) + 4);
	КонецЕсли;

	Возврат Представление;

КонецФункции

Функция АдресСтраницы(ИмяПроекта, ИмяНастройки, ДатаСверки, ОтборКлюча, Все)

	Части = Новый Массив;
	Если ЗначениеЗаполнено(ИмяПроекта) Тогда
		Части.Добавить("проект=" + КодироватьСтроку(ИмяПроекта));
	КонецЕсли;
	Части.Добавить("настройка=" + КодироватьСтроку(ИмяНастройки));
	Если ЗначениеЗаполнено(ДатаСверки) Тогда
		Части.Добавить("дата=" + Формат(ДатаСверки, "ДФ=yyyy-MM-dd"));
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтборКлюча) Тогда
		Части.Добавить("ключ=" + КодироватьСтроку(ОтборКлюча));
	КонецЕсли;
	Если ЗначениеЗаполнено(Все) Тогда
		Части.Добавить("все=" + Все);
	КонецЕсли;

	Возврат "/ui/page/Сверка?" + СтрСоединить(Части, "&");

КонецФункции

Функция ПараметрСтраницы(Параметры, Имя)

	Значение = Параметры.Получить(Имя);
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Значение = ?(Значение.Количество() > 0, Значение.Получить(0), "");
	КонецЕсли;

	Возврат СокрЛП(НастройкиПроекта.ТекстЗначения(Значение));

КонецФункции

Функция ДатаПараметра(Параметры)

	Текст = ПараметрСтраницы(Параметры, "дата");
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат НачалоДня(СверкаДанных.ДатаИзТекста(Текст));

КонецФункции

Функция ТекстДаты(Значение)
	Возврат Формат(Значение, "ДФ=dd.MM.yyyy");
КонецФункции

Функция ТекстДатыВремени(Значение)
	Возврат ТекстДаты(Значение) + " " + Прав("0" + Строка(Час(Значение)), 2) + ":" + Прав("0" + Строка(Минута(Значение)), 2);
КонецФункции

Функция ЧислоТекстом(Значение, ЗнаковПослеЗапятой)
	Возврат Формат(НастройкиПроекта.ЧислоЗначения(Значение), "ЧДЦ=" + Строка(ЗнаковПослеЗапятой) + "; ЧН=0");
КонецФункции
