// Серия сверок на синтетических выборках: выборки кладутся в кэш закрытых периодов, поэтому источники
// не опрашиваются. Месяц без выборки в кэше идет в источник без секрета и падает - так проверяется,
// что ошибка одного запуска не прерывает серию. Сеть не нужна.
Процедура Выполнить()

	ПроверитьПериоды();
	ПроверитьОшибкиПараметров();
	ПроверитьСериюПоМесяцам();
	ПроверитьСериюЗаВесьПериод();

КонецПроцедуры

Процедура ПроверитьПериоды()

	Периоды = СерииСверок.ПериодыСерии(Дата(2024, 1, 15), КонецДня(Дата(2024, 3, 10)), "месяц");
	Утверждать.Равно(Периоды.Количество(), 3, "15.01-10.03 по месяцам - три периода");
	Утверждать.Равно(Периоды.Получить(0).Начало, Дата(2024, 1, 15), "первый период - с начала серии");
	Утверждать.Равно(Периоды.Получить(0).Конец, КонецМесяца(Дата(2024, 1, 1)), "первый период - до конца января");
	Утверждать.Равно(Периоды.Получить(1).Начало, Дата(2024, 2, 1), "второй период - с 1 февраля");
	Утверждать.Равно(Периоды.Получить(1).Конец, КонецМесяца(Дата(2024, 2, 1)), "второй период - до 29 февраля");
	Утверждать.Равно(Периоды.Получить(2).Конец, КонецДня(Дата(2024, 3, 10)), "последний период - до конца серии");

	Периоды = СерииСверок.ПериодыСерии(Дата(2024, 1, 15), КонецДня(Дата(2024, 3, 10)), "весь период");
	Утверждать.Равно(Периоды.Количество(), 1, "весь период - один период");

	Утверждать.Равно(СерииСверок.КонецПериодаСерии(Дата(2024, 3, 31)), КонецДня(Дата(2024, 3, 31)),
		"конец серии без времени включается целиком");
	Утверждать.Равно(СерииСверок.РазобратьИменаНастроек("Первая; Вторая" + Символы.ПС + " Первая ").Количество(), 2,
		"имена настроек через ; и перевод строки, без повторов");

КонецПроцедуры

Функция ТекстОшибкиСоздания(ИмяПроекта, ИменаНастроек, Шаг)

	Попытка
		СерииСверок.СоздатьСерию(ИмяПроекта, ИменаНастроек, Дата(2024, 1, 1), Дата(2024, 3, 31), Шаг, Ложь);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;

	Возврат "";

КонецФункции

Процедура ПроверитьОшибкиПараметров()

	ЗаполнитьПроект();
	Утверждать.Истина(СтрНайти(ТекстОшибкиСоздания("", "", "месяц"), "нужен проект") > 0,
		"без проекта и без настроек серия не создается");
	Утверждать.Истина(СтрНайти(ТекстОшибкиСоздания("Тест серии", "", "неделя"), "Неизвестный шаг") > 0,
		"неизвестный шаг - ошибка");
	Утверждать.Истина(СтрНайти(ТекстОшибкиСоздания("Тест серии", "Нет такой", "месяц"), "Не найдена настройка") > 0,
		"неизвестная настройка - ошибка до создания серии");

КонецПроцедуры

// Проект, два источника и две настройки: числовая (обороты по счетам) и текстовая (карточки).
Процедура ЗаполнитьПроект()

	Если Справочники.ПроектыСверки.НайтиПоНаименованию("Тест серии") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПроектОбъект = Справочники.ПроектыСверки.Создать();
	ПроектОбъект.Наименование = "Тест серии";
	ПроектОбъект.Записать();
	Проект = Справочники.ПроектыСверки.НайтиПоНаименованию("Тест серии");

	Для Каждого ИмяИсточника Из СтрРазделить("синтетика А,синтетика Б", ",") Цикл
		ОписаниеИсточника = Новый Соответствие;
		ОписаниеИсточника.Вставить("наименование", ИмяИсточника);
		ОписаниеИсточника.Вставить("тип", "Fastex1С8");
		ОписаниеИсточника.Вставить("адрес", "http://host.example/base");
		ОписаниеИсточника.Вставить("пользователь", "robot");
		ОписаниеИсточника.Вставить("секрет", "");
		НастройкиПроекта.ЗаписатьИсточник(ОписаниеИсточника, Проект);
	КонецЦикла;

	ЗаписатьНастройку(Проект, "Обороты по счетам", "Счет", "Сумма");
	ЗаписатьНастройку(Проект, "Карточки", "Код", "Наименование");

КонецПроцедуры

Процедура ЗаписатьНастройку(Проект, Наименование, КлючевоеПоле, ПолеЗначения)

	ОписаниеНастройки = Новый Соответствие;
	ОписаниеНастройки.Вставить("наименование", Наименование);
	ОписаниеНастройки.Вставить("источникА", "синтетика А");
	ОписаниеНастройки.Вставить("источникБ", "синтетика Б");
	ОписаниеНастройки.Вставить("запросА", ТекстЗапроса(Наименование, "А"));
	ОписаниеНастройки.Вставить("запросБ", ТекстЗапроса(Наименование, "Б"));
	ОписаниеНастройки.Вставить("ключевыеПоля", КлючевоеПоле);
	ОписаниеНастройки.Вставить("поляЗначений", ПолеЗначения);
	ОписаниеНастройки.Вставить("погрешность", 0.01);
	НастройкиПроекта.ЗаписатьНастройку(ОписаниеНастройки, Проект);

КонецПроцедуры

Функция ТекстЗапроса(ИмяНастройки, Сторона)
	Возврат "ВЫБРАТЬ * ИЗ Синтетика КАК Сторона" + Сторона + " // " + ИмяНастройки + Символы.ПС
		+ "ГДЕ Период МЕЖДУ &НачалоПериода И &КонецПериода";
КонецФункции

Функция СтрокаСчета(Счет, Сумма)
	СтрокаВыборки = Новый Соответствие;
	СтрокаВыборки.Вставить("Счет", Счет);
	СтрокаВыборки.Вставить("Сумма", Сумма);
	Возврат СтрокаВыборки;
КонецФункции

Функция СтрокаКарточки(Код, Наименование, Помечен)
	СтрокаВыборки = Новый Соответствие;
	СтрокаВыборки.Вставить("Код", Код);
	СтрокаВыборки.Вставить("Наименование", Наименование);
	СтрокаВыборки.Вставить("Помечен", Помечен);
	Возврат СтрокаВыборки;
КонецФункции

Функция Строки(Первая = Неопределено, Вторая = Неопределено)
	Результат = Новый Массив;
	Если Первая <> Неопределено Тогда
		Результат.Добавить(Первая);
	КонецЕсли;
	Если Вторая <> Неопределено Тогда
		Результат.Добавить(Вторая);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Кладет выборки обеих сторон настройки за период в кэш (период закрыт - кэш берется без источника).
Процедура ЗаписатьВыборки(ИмяНастройки, Период, СтрокиА, СтрокиБ)

	Проект = Справочники.ПроектыСверки.НайтиПоНаименованию("Тест серии");
	Настройка = НастройкиПроекта.НайтиОбъект("настройка", ИмяНастройки, Проект).ПолучитьОбъект();
	СверкаДанных.ЗаписатьВыборкуВКэш(Настройка.ИсточникА, Настройка.ЗапросА, Период.Начало, Период.Конец,
		Новый Массив, СтрокиА);
	СверкаДанных.ЗаписатьВыборкуВКэш(Настройка.ИсточникБ, Настройка.ЗапросБ, Период.Начало, Период.Конец,
		Новый Массив, СтрокиБ);

КонецПроцедуры

Функция ЧислоЗапусков()
	ЗапросЗапусков = Новый Запрос;
	ЗапросЗапусков.Текст = "ВЫБРАТЬ Номер ИЗ Документ.ЗапускСверки";
	Возврат ЗапросЗапусков.Выполнить().Количество();
КонецФункции

Процедура ПроверитьСериюПоМесяцам()

	ЗаполнитьПроект();
	Периоды = СерииСверок.ПериодыСерии(Дата(2024, 1, 1), СерииСверок.КонецПериодаСерии(Дата(2024, 3, 31)), "месяц");
	Январь = Периоды.Получить(0);
	Февраль = Периоды.Получить(1);
	Март = Периоды.Получить(2);

	// Обороты: январь - по 60 расходится на 10; февраль - 51 дважды в А (свертка), 62 только в Б;
	// март в кэш не кладется - запуск падает на источнике без секрета.
	ЗаписатьВыборки("Обороты по счетам", Январь, Строки(СтрокаСчета("51", 100), СтрокаСчета("60", 200)),
		Строки(СтрокаСчета("51", 100), СтрокаСчета("60", 190)));
	ЗаписатьВыборки("Обороты по счетам", Февраль, Строки(СтрокаСчета("51", 50), СтрокаСчета("51", 50)),
		Строки(СтрокаСчета("51", 100), СтрокаСчета("62", -5)));
	// Карточки: январь - код 2 расходится, но помечен (исключено); февраль - код 1 только в А; март пуст.
	ЗаписатьВыборки("Карточки", Январь, Строки(СтрокаКарточки("1", "Альфа", Ложь), СтрокаКарточки("2", "Бета", Истина)),
		Строки(СтрокаКарточки("1", "Альфа", Ложь), СтрокаКарточки("2", "Бета2", Ложь)));
	ЗаписатьВыборки("Карточки", Февраль, Строки(СтрокаКарточки("1", "Альфа", Ложь)), Строки());
	ЗаписатьВыборки("Карточки", Март, Строки(), Строки());

	ЗапусковДо = ЧислоЗапусков();
	СерияОбъект = СерииСверок.СоздатьСерию("Тест серии", "", Дата(2024, 1, 1), Дата(2024, 3, 31), "", Ложь);
	СерииСверок.ВыполнитьСерию(СерияОбъект);

	Утверждать.Равно(СерияОбъект.Состояние, "Выполнено с ошибками", "серия дошла до конца, несмотря на ошибку марта");
	Утверждать.Равно(СерияОбъект.Строки.Количество(), 6, "две настройки проекта на три месяца");
	Утверждать.Равно(ЧислоЗапусков() - ЗапусковДо, 6, "на каждую строку - обычный запуск сверки");
	Утверждать.Равно(СерияОбъект.ЗапусковВсего, 6, "запусков в шапке");
	Утверждать.Равно(СерияОбъект.ЗапусковСОшибкой, 1, "с ошибкой - один (обороты за март)");
	Утверждать.Равно(СерияОбъект.ЗапусковСРасхождениями, 3, "с расхождениями - три; исключенный ключ не в счет");

	// Порядок строк: настройки по алфавиту, внутри - месяцы.
	КарточкиЯнварь = СерияОбъект.Строки.Получить(0);
	Утверждать.Равно(КарточкиЯнварь.ИмяНастройки, "Карточки", "первая настройка - по алфавиту");
	Утверждать.Равно(КарточкиЯнварь.Совпало, 1, "карточки январь: совпало");
	Утверждать.Равно(КарточкиЯнварь.Исключено, 1, "карточки январь: исключено");
	Утверждать.Равно(КарточкиЯнварь.Расходится, 0, "карточки январь: исключенный ключ не расходится");
	Утверждать.Равно(СерияОбъект.Строки.Получить(1).НетВБ, 1, "карточки февраль: нет в Б");
	Утверждать.Равно(СерияОбъект.Строки.Получить(2).КлючейА, 0, "карточки март: пустые выборки");

	ОборотыЯнварь = СерияОбъект.Строки.Получить(3);
	Утверждать.Равно(ОборотыЯнварь.ИмяНастройки, "Обороты по счетам", "вторая настройка");
	Утверждать.Равно(ОборотыЯнварь.Ошибка, "", "обороты январь без ошибки");
	Утверждать.Равно(ОборотыЯнварь.Состояние, "Выполнено", "обороты январь выполнены");
	Утверждать.Равно(ОборотыЯнварь.КлючейА, 2, "обороты январь: ключей А");
	Утверждать.Равно(ОборотыЯнварь.КлючейБ, 2, "обороты январь: ключей Б");
	Утверждать.Равно(ОборотыЯнварь.Совпало, 1, "обороты январь: совпало");
	Утверждать.Равно(ОборотыЯнварь.Расходится, 1, "обороты январь: расходится");
	Утверждать.Истина(ЗначениеЗаполнено(ОборотыЯнварь.Запуск), "у строки есть ссылка на запуск");
	ОборотыФевраль = СерияОбъект.Строки.Получить(4);
	Утверждать.Равно(ОборотыФевраль.КлючейА, 1, "обороты февраль: две строки А свернуты в один ключ");
	Утверждать.Равно(ОборотыФевраль.Совпало, 1, "обороты февраль: 51 совпал после свертки");
	Утверждать.Равно(ОборотыФевраль.НетВА, 1, "обороты февраль: 62 нет в А");
	ОборотыМарт = СерияОбъект.Строки.Получить(5);
	Утверждать.Равно(ОборотыМарт.Состояние, "Ошибка", "обороты март: ошибка источника");
	Утверждать.Истина(ЗначениеЗаполнено(ОборотыМарт.Ошибка), "обороты март: текст ошибки");

	// Итоги числовых полей: только у оборотов, по месяцу.
	Утверждать.Равно(СерияОбъект.ИтогиПолей.Количество(), 2, "итоги полей - январь и февраль оборотов");
	ИтогЯнваря = СерияОбъект.ИтогиПолей.Получить(0);
	Утверждать.Равно(ИтогЯнваря.Поле, "Сумма", "итог по полю Сумма");
	Утверждать.Равно(ИтогЯнваря.СуммаА, 300, "январь: сумма А");
	Утверждать.Равно(ИтогЯнваря.СуммаБ, 290, "январь: сумма Б");
	Утверждать.Равно(ИтогЯнваря.Разница, 10, "январь: разница");
	Утверждать.Равно(ИтогЯнваря.РасхождениеПоМодулю, 10, "январь: расхождение по модулю");
	ИтогФевраля = СерияОбъект.ИтогиПолей.Получить(1);
	Утверждать.Равно(ИтогФевраля.СуммаА, 100, "февраль: сумма А");
	Утверждать.Равно(ИтогФевраля.СуммаБ, 95, "февраль: сумма Б");
	Утверждать.Равно(ИтогФевраля.РасхождениеПоМодулю, 5, "февраль: расхождение по модулю (нет в А)");

	// Текст и JSON.
	ТекстСводки = СерияОбъект.ТекстСводки;
	Утверждать.Истина(СтрНайти(ТекстСводки, "Запусков 6: без расхождений 2, с расхождениями 3, с ошибкой 1") > 0,
		"текст: итог запусков");
	Утверждать.Истина(СтрНайти(ТекстСводки, "Сумма: А 300.00, Б 290.00, разница 10.00, расхождение по модулю 10.00") > 0,
		"текст: суммы января");
	Утверждать.Истина(СтрНайти(ТекстСводки, "ОШИБКА: ") > 0, "текст: ошибка марта");
	Утверждать.Истина(СтрНайти(ТекстСводки, "шаг месяц; выполнено с ошибками") > 0, "текст: итоговое состояние в шапке");
	ИтогJSON = ПрочитатьJSON(ЗаписатьJSON(СерииСверок.ИтогСерии(СерияОбъект)));
	Утверждать.Равно(ИтогJSON.Получить("строки").Количество(), 6, "JSON: шесть строк");
	Утверждать.Равно(ИтогJSON.Получить("запусковСОшибкой"), 1, "JSON: запусков с ошибкой");
	ИтогиПоНастройкам = ИтогJSON.Получить("итогиПоНастройкам");
	Утверждать.Равно(ИтогиПоНастройкам.Количество(), 1, "JSON: итоги за серию - одна настройка с числами");
	Утверждать.Равно(ИтогиПоНастройкам.Получить(0).Получить("разница"), 15, "JSON: разница за серию");
	Утверждать.Равно(ИтогиПоНастройкам.Получить(0).Получить("расхождениеПоМодулю"), 15, "JSON: по модулю за серию");
	Утверждать.Равно(ИтогJSON.Получить("строки").Получить(3).Получить("итогиПолей").Получить(0).Получить("суммаА"), 300,
		"JSON: итоги полей в строке");

	// Повторный запуск продолжает серию: готовые строки (и строка с ошибкой) не перезапускаются.
	СерияПовторно = СерииСверок.НайтиСерию(СерияОбъект.Номер);
	Утверждать.Равно(СерияПовторно.Строки.Количество(), 6, "серия прочитана из базы со всеми строками");
	СерииСверок.ВыполнитьСерию(СерияПовторно);
	Утверждать.Равно(СерияПовторно.Строки.Количество(), 6, "повтор: строк столько же");
	Утверждать.Равно(ЧислоЗапусков() - ЗапусковДо, 6, "повтор: новых запусков нет");

КонецПроцедуры

Процедура ПроверитьСериюЗаВесьПериод()

	ЗаполнитьПроект();
	ВесьПериод = СерииСверок.ПериодыСерии(Дата(2024, 1, 1), СерииСверок.КонецПериодаСерии(Дата(2024, 2, 29)),
		"весь период").Получить(0);
	ЗаписатьВыборки("Обороты по счетам", ВесьПериод, Строки(СтрокаСчета("51", 150), СтрокаСчета("60", 200)),
		Строки(СтрокаСчета("51", 150), СтрокаСчета("60", 200)));

	СерияОбъект = СерииСверок.СоздатьСерию("", "Обороты по счетам", Дата(2024, 1, 1), Дата(2024, 2, 29),
		"весь период", Ложь);
	СерииСверок.ВыполнитьСерию(СерияОбъект);
	Утверждать.Равно(СерияОбъект.Состояние, "Выполнено", "серия за весь период выполнена");
	Утверждать.Равно(СерияОбъект.Строки.Количество(), 1, "одна настройка по имени без проекта - одна строка");
	Утверждать.Равно(СерияОбъект.Строки.Получить(0).Совпало, 2, "за весь период все совпало");
	Утверждать.Равно(СерияОбъект.ЗапусковСРасхождениями, 0, "без расхождений");
	Утверждать.Равно(СерияОбъект.ИтогиПолей.Получить(0).Разница, 0, "разница за весь период - ноль");

КонецПроцедуры
