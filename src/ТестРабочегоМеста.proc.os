// Таблица результата рабочего места постранично: в форме только текущая страница (данные формы уходят на сервер
// целиком, платформа принимает не больше 1 МБ), отбор, поиск и подсчет - по всем строкам запуска.
// Объект формы заменен структурой с теми же реквизитами.
Процедура Выполнить()

	ПроверитьСтраницы();
	ПроверитьОтборыПоВсемСтрокам();

КонецПроцедуры

// Ключ строки с ведущими нулями (000042): строки запуска сортируются по ключу как по строке.
Функция КлючНомера(НомерСтроки)
	ЦифрыНомера = СтрЗаменить(СтрЗаменить(Строка(НомерСтроки), " ", ""), Символ(160), "");
	Возврат Прав("000000" + ЦифрыНомера, 6);
КонецФункции

// Запуск с ЧислоСтрок ключами, из них ЧислоОтличий с разницей 5.
Функция СоздатьЗапуск(ЧислоСтрок, ЧислоОтличий)

	ЗапускОбъект = Документы.ЗапускСверки.Создать();
	ЗапускОбъект.Дата = ТекущаяДата();
	ЗапускОбъект.Состояние = "Выполнено";
	ЗапускОбъект.КлючейА = ЧислоСтрок;
	ЗапускОбъект.КлючейБ = ЧислоСтрок;
	Для НомерСтроки = 1 По ЧислоСтрок Цикл
		СтрокаКлюча = ЗапускОбъект.Ключи.Добавить();
		СтрокаКлюча.Ключ = КлючНомера(НомерСтроки);
		СтрокаКлюча.Поле = "Сумма";
		СтрокаКлюча.ЗначениеА = 100;
		СтрокаКлюча.ЗначениеБ = ?(НомерСтроки <= ЧислоОтличий, 95, 100);
		СтрокаКлюча.Разница = СтрокаКлюча.ЗначениеА - СтрокаКлюча.ЗначениеБ;
	КонецЦикла;
	ЗапускОбъект.Записать();

	Возврат ЗапускОбъект.Ссылка;

КонецФункции

Функция ОбъектФормы(Запуск, ТолькоОтличия)

	Результат = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить("Ключ,Представление,Поле,ЗначениеА,ЗначениеБ,Разница,Эталон,Пояснение,Расходится,НетВА,НетВБ", ",") Цикл
		Результат.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;

	Возврат Новый Структура("Запуск, Результат, Итог, НПояснения, Погрешность, ОтборКлюча, ТолькоОтличия, Поиск, Страница, Страницы",
		Запуск, Результат, "", "", 0.005, "", ТолькоОтличия, "", 1, "");

КонецФункции

Процедура ПроверитьСтраницы()

	Размер = РабочееМестоСверкиСервер.РазмерСтраницы();
	Объект = ОбъектФормы(СоздатьЗапуск(Размер * 5 + 7, 30), Ложь);
	РабочееМестоСверкиСервер.ЗаполнитьРезультатСНачала(Объект);
	Утверждать.Равно(Объект.Результат.Количество(), Размер, "первая страница полная");
	Утверждать.Равно(Объект.Результат.Получить(0).Ключ, "000001", "первая страница начинается с первого ключа");
	Утверждать.Истина(СтрНайти(Объект.Страницы, "стр. 1 из 6") > 0, "страниц 6: " + Объект.Страницы);

	РабочееМестоСверкиСервер.ЛистатьРезультат(Объект, 1);
	Утверждать.Равно(Объект.Страница, 2, "вперед - вторая страница");
	Утверждать.Равно(Объект.Результат.Получить(0).Ключ, КлючНомера(Размер + 1), "вторая страница - со строки после первой");

	Объект.Страница = 6;
	РабочееМестоСверкиСервер.ЗаполнитьРезультат(Объект);
	Утверждать.Равно(Объект.Результат.Количество(), 7, "последняя страница - остаток");
	РабочееМестоСверкиСервер.ЛистатьРезультат(Объект, 1);
	Утверждать.Равно(Объект.Страница, 6, "вперед с последней - остается последней");
	Объект.Страница = 1;
	РабочееМестоСверкиСервер.ЛистатьРезультат(Объект, -1);
	Утверждать.Равно(Объект.Страница, 1, "назад с первой - остается первой");

	Объект.Страница = 4;
	РабочееМестоСверкиСервер.ЗаполнитьРезультат(Объект);
	Утверждать.Равно(Объект.Страница, 4, "перезаполнение (запись пояснения) не сбрасывает страницу");

КонецПроцедуры

Процедура ПроверитьОтборыПоВсемСтрокам()

	Размер = РабочееМестоСверкиСервер.РазмерСтраницы();
	Объект = ОбъектФормы(СоздатьЗапуск(Размер * 5 + 7, 30), Ложь);
	Объект.Страница = 3;
	Объект.ТолькоОтличия = Истина;
	РабочееМестоСверкиСервер.ЗаполнитьРезультатСНачала(Объект);
	Утверждать.Равно(Объект.Страница, 1, "смена отбора - с первой страницы");
	Утверждать.Равно(Объект.Результат.Количество(), 30, "только отличия - все 30 со всех страниц");
	Утверждать.Истина(СтрНайти(Объект.Итог, "расходится 30") > 0, "расхождения считаются по всему запуску: " + Объект.Итог);

	Объект.ТолькоОтличия = Ложь;
	Объект.Поиск = "001007";
	РабочееМестоСверкиСервер.ЗаполнитьРезультатСНачала(Объект);
	Утверждать.Равно(Объект.Результат.Количество(), 1, "поиск находит ключ с последней страницы");
	Утверждать.Равно(Объект.Результат.Получить(0).Ключ, "001007", "найден нужный ключ");

КонецПроцедуры
