// Таблица результата рабочего места на большом запуске: строк больше предела формы - включается «только отличия»,
// отличий больше предела - показываются первые строки. Объект формы заменен структурой с теми же реквизитами.
Процедура Выполнить()

	ПроверитьВключениеТолькоОтличий();
	ПроверитьОбрезкуОтличий();

КонецПроцедуры

// Запуск с ЧислоСтрок ключами, из них ЧислоОтличий с разницей 5.
Функция СоздатьЗапуск(ЧислоСтрок, ЧислоОтличий)

	ЗапускОбъект = Документы.ЗапускСверки.Создать();
	ЗапускОбъект.Дата = ТекущаяДата();
	ЗапускОбъект.Состояние = "Выполнено";
	ЗапускОбъект.КлючейА = ЧислоСтрок;
	ЗапускОбъект.КлючейБ = ЧислоСтрок;
	Для НомерСтроки = 1 По ЧислоСтрок Цикл
		СтрокаКлюча = ЗапускОбъект.Ключи.Добавить();
		СтрокаКлюча.Ключ = Формат(НомерСтроки, "ЧЦ=6; ЧВН=; ЧГ=0");
		СтрокаКлюча.Поле = "Сумма";
		СтрокаКлюча.ЗначениеА = 100;
		СтрокаКлюча.ЗначениеБ = ?(НомерСтроки <= ЧислоОтличий, 95, 100);
		СтрокаКлюча.Разница = СтрокаКлюча.ЗначениеА - СтрокаКлюча.ЗначениеБ;
	КонецЦикла;
	ЗапускОбъект.Записать();

	Возврат ЗапускОбъект.Ссылка;

КонецФункции

Функция ОбъектФормы(Запуск, ТолькоОтличия)

	Результат = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить("Ключ,Представление,Поле,ЗначениеА,ЗначениеБ,Разница,Эталон,Пояснение,Расходится,НетВА,НетВБ", ",") Цикл
		Результат.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;

	Возврат Новый Структура("Запуск, Результат, Итог, НПояснения, Погрешность, ОтборКлюча, ТолькоОтличия",
		Запуск, Результат, "", "", 0.005, "", ТолькоОтличия);

КонецФункции

Процедура ПроверитьВключениеТолькоОтличий()

	Объект = ОбъектФормы(СоздатьЗапуск(1200, 30), Ложь);
	РабочееМестоСверкиСервер.ЗаполнитьРезультат(Объект);
	Утверждать.Равно(Объект.ТолькоОтличия, Истина, "1200 строк больше предела - включено «только отличия»");
	Утверждать.Равно(Объект.Результат.Количество(), 30, "в таблице только 30 отличий");
	Утверждать.Истина(СтрНайти(Объект.Итог, "Всех строк 1200") > 0, "итог объясняет, почему таблица сокращена: " + Объект.Итог);

	Объект = ОбъектФормы(СоздатьЗапуск(200, 30), Ложь);
	РабочееМестоСверкиСервер.ЗаполнитьРезультат(Объект);
	Утверждать.Равно(Объект.ТолькоОтличия, Ложь, "200 строк в пределе - флажок не трогается");
	Утверждать.Равно(Объект.Результат.Количество(), 200, "в пределе показаны все строки");

КонецПроцедуры

Процедура ПроверитьОбрезкуОтличий()

	Объект = ОбъектФормы(СоздатьЗапуск(900, 700), Истина);
	РабочееМестоСверкиСервер.ЗаполнитьРезультат(Объект);
	Утверждать.Равно(Объект.Результат.Количество(), 500, "700 отличий - показаны первые 500");
	Утверждать.Истина(СтрНайти(Объект.Итог, "Показаны первые 500 из 700") > 0, "итог говорит об обрезке: " + Объект.Итог);

КонецПроцедуры
