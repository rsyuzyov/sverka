// Формат файлов настроек (выгрузил -> загрузил -> совпало), поиск по имени в пределах проекта,
// разбор адреса репозитория и решения синхронизации о конфликтах. Сеть не нужна.
Процедура Выполнить()

	ПроверитьТудаОбратно();
	ПроверитьСтарыйФорматСнимка();
	ПроверитьИменаФайлов();
	ПроверитьАдресРепозитория();
	ПроверитьРешенияОтправки();
	ПроверитьРешенияПолучения();

КонецПроцедуры

Функция СоздатьПроект(Наименование)

	ПроектОбъект = Справочники.ПроектыСверки.Создать();
	ПроектОбъект.Наименование = Наименование;
	ПроектОбъект.Записать();

	Возврат Справочники.ПроектыСверки.НайтиПоНаименованию(Наименование);

КонецФункции

Функция ТрудныйЗапрос()

	Возврат "ВЫБРАТЬ" + Символы.ПС
		+ Символы.Таб + "Т.Счет КАК Счет, ""кавычки"" КАК Текст, ""C:\путь\"" КАК Путь" + Символы.ВК + Символы.ПС
		+ "ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&КонецПериода) КАК Т" + Символы.ПС
		+ "ГДЕ Т.СуммаОстаток <> 0 И Т.Счет.Код < ""52"" & ↔ ё" + Символы.ПС;

КонецФункции

Процедура ПроверитьТудаОбратно()

	ПроектА = СоздатьПроект("Тест формата А");
	ПроектБ = СоздатьПроект("Тест формата Б");

	ОписаниеИсточника = Новый Соответствие;
	ОписаниеИсточника.Вставить("наименование", "база ↔ 7.7 (тест)");
	ОписаниеИсточника.Вставить("тип", "Fastex77ЧерезБазу1С8");
	ОписаниеИсточника.Вставить("адрес", "http://host.example/base");
	ОписаниеИсточника.Вставить("пользователь", "robot");
	ОписаниеИсточника.Вставить("секрет", "file:/etc/sverka/secrets/test.secret");
	ОписаниеИсточника.Вставить("пользователь77", "Сверка");
	ОписаниеИсточника.Вставить("секрет77", "file:/etc/sverka/secrets/test77.secret");
	НастройкиПроекта.ЗаписатьИсточник(ОписаниеИсточника, ПроектА);

	ОписаниеНастройки = Новый Соответствие;
	ОписаниеНастройки.Вставить("наименование", "Поставщик*** 51 ↔ 7.7");
	ОписаниеНастройки.Вставить("источникА", "база ↔ 7.7 (тест)");
	ОписаниеНастройки.Вставить("источникБ", "база ↔ 7.7 (тест)");
	ОписаниеНастройки.Вставить("запросА", ТрудныйЗапрос());
	ОписаниеНастройки.Вставить("запросБ", "Счет = 51" + Символы.ПС + "ВидСубконто = Контрагенты");
	ОписаниеНастройки.Вставить("ключевыеПоля", "Счет");
	ОписаниеНастройки.Вставить("поляЗначений", "Сумма");
	ОписаниеНастройки.Вставить("погрешность", 0.01);
	НастройкиПроекта.ЗаписатьНастройку(ОписаниеНастройки, ПроектА);

	ТекстИсточника = НастройкиПроекта.ТекстФайлаОбъекта("источник", "база ↔ 7.7 (тест)", ПроектА);
	ТекстНастройки = НастройкиПроекта.ТекстФайлаОбъекта("настройка", "Поставщик*** 51 ↔ 7.7", ПроектА);

	Утверждать.Истина(СтрНайти(ТекстНастройки, "<> 0") > 0, "знаки <> в файле как есть, без экранирования");
	Утверждать.Истина(СтрНайти(ТекстНастройки, "  ""запросА"": [") > 0, "многострочный запрос - массивом строк");
	Утверждать.Истина(СтрНайти(ТекстНастройки, "  ""погрешность"": 0.01,") > 0, "погрешность числом");
	Утверждать.Истина(СтрНачинаетсяС(ТекстНастройки, "{" + Символы.ПС + "  ""наименование"": ""Поставщик*** 51 ↔ 7.7"","),
		"наименование - первым ключом");
	Утверждать.Истина(СтрЗаканчиваетсяНа(ТекстНастройки, "}" + Символы.ПС), "перевод строки в конце файла");
	Утверждать.Ложь(СтрНайти(ТекстНастройки, Символы.ВК) > 0, "возврат каретки в файл не попадает");

	// Загрузка в другой проект: имена те же, объекты - другие.
	НастройкиПроекта.ЗаписатьОбъект("источник", ПрочитатьJSON(ТекстИсточника), ПроектБ);
	НастройкиПроекта.ЗаписатьОбъект("настройка", ПрочитатьJSON(ТекстНастройки), ПроектБ);
	Утверждать.Равно(НастройкиПроекта.ТекстФайлаОбъекта("источник", "база ↔ 7.7 (тест)", ПроектБ), ТекстИсточника,
		"источник: выгрузил -> загрузил в другой проект -> выгрузил то же");
	Утверждать.Равно(НастройкиПроекта.ТекстФайлаОбъекта("настройка", "Поставщик*** 51 ↔ 7.7", ПроектБ), ТекстНастройки,
		"настройка: выгрузил -> загрузил в другой проект -> выгрузил то же");

	НастройкаБ = НастройкиПроекта.НайтиОбъект("настройка", "Поставщик*** 51 ↔ 7.7", ПроектБ);
	НастройкаОбъект = НастройкаБ.ПолучитьОбъект();
	Утверждать.Равно(НастройкаОбъект.ЗапросА, СтрЗаменить(ТрудныйЗапрос(), Символы.ВК, ""),
		"текст запроса после загрузки равен исходному (без возврата каретки)");
	Утверждать.Равно(НастройкаОбъект.Погрешность, 0.01, "погрешность после загрузки");
	Утверждать.Равно(НастройкиПроекта.ИдСсылки(НастройкаОбъект.ИсточникА),
		НастройкиПроекта.ИдСсылки(НастройкиПроекта.НайтиОбъект("источник", "база ↔ 7.7 (тест)", ПроектБ)),
		"источник настройки - из своего проекта");

	// Повторная загрузка того же текста не плодит объекты.
	НастройкиПроекта.ЗаписатьОбъект("настройка", ПрочитатьJSON(ТекстНастройки), ПроектБ);
	Утверждать.Равно(НастройкиПроекта.НайтиОбъекты("настройка", "Поставщик*** 51 ↔ 7.7", ПроектБ).Количество(), 1,
		"повторная загрузка обновляет, а не создает");

	// Одно имя в двух проектах: без проекта запуск не угадывает.
	ОшибкаПоиска = "";
	Попытка
		НастройкиПроекта.НайтиНастройкуДляЗапуска("Поставщик*** 51 ↔ 7.7", "");
	Исключение
		ОшибкаПоиска = ОписаниеОшибки();
	КонецПопытки;
	Утверждать.Истина(СтрНайти(ОшибкаПоиска, "нескольких проектах") > 0, "одно имя в двух проектах - просьба указать проект");
	Утверждать.Равно(НастройкиПроекта.ИдСсылки(НастройкиПроекта.НайтиНастройкуДляЗапуска("Поставщик*** 51 ↔ 7.7", "Тест формата Б")),
		НастройкиПроекта.ИдСсылки(НастройкаБ), "с проектом находится настройка своего проекта");

	// Источник SQL и настройка с новыми полями: признаки «да», имя расшифровки, пояснения массивом строк.
	ОписаниеSQL = Новый Соответствие;
	ОписаниеSQL.Вставить("наименование", "СУБД 7.7 (тест)");
	ОписаниеSQL.Вставить("тип", "SQLЧерезБазу1С8");
	ОписаниеSQL.Вставить("адрес", "http://host.example/base");
	ОписаниеSQL.Вставить("пользователь", "robot");
	ОписаниеSQL.Вставить("секрет", "file:/etc/sverka/secrets/test.secret");
	ОписаниеSQL.Вставить("строкаСоединенияСУБД", "Provider=SQLOLEDB;Data Source=db.example;Initial Catalog=base77;User ID=reader");
	ОписаниеSQL.Вставить("секретСУБД", "file:/etc/sverka/secrets/test-sql.secret");
	НастройкиПроекта.ЗаписатьИсточник(ОписаниеSQL, ПроектА);
	ОписаниеБаланса = Новый Соответствие;
	ОписаниеБаланса.Вставить("наименование", "Баланс (тест)");
	ОписаниеБаланса.Вставить("источникА", "база ↔ 7.7 (тест)");
	ОписаниеБаланса.Вставить("источникБ", "СУБД 7.7 (тест)");
	ОписаниеБаланса.Вставить("запросА", "ВЫБРАТЬ 1 КАК Счет, 2 КАК Сумма");
	ОписаниеБаланса.Вставить("запросБ", "SELECT '41.1' AS Счет, -- комментарий" + Символы.ПС + "  2 AS Сумма");
	ОписаниеБаланса.Вставить("ключевыеПоля", "Счет");
	ОписаниеБаланса.Вставить("поляЗначений", "Сумма");
	ОписаниеБаланса.Вставить("соответствиеНаА", "да");
	ОписаниеБаланса.Вставить("всеКлючи", Истина);
	ОписаниеБаланса.Вставить("расшифровка", "Баланс по аналитике (тест)");
	ОписаниеБаланса.Вставить("пояснения", "41.01 :: trade :: дрейф" + Символы.ПС + "66.03 :: 7.7 :: документ ПТ-0001");
	НастройкиПроекта.ЗаписатьНастройку(ОписаниеБаланса, ПроектА);
	ТекстSQL = НастройкиПроекта.ТекстФайлаОбъекта("источник", "СУБД 7.7 (тест)", ПроектА);
	ТекстБаланса = НастройкиПроекта.ТекстФайлаОбъекта("настройка", "Баланс (тест)", ПроектА);
	Утверждать.Истина(СтрНайти(ТекстSQL, """тип"": ""SQLЧерезБазу1С8""") > 0, "тип SQL в файле источника");
	Утверждать.Истина(СтрНайти(ТекстSQL, """секретСУБД"": ""file:/etc/sverka/secrets/test-sql.secret""") > 0, "секрет СУБД - ссылкой");
	Утверждать.Истина(СтрНайти(ТекстБаланса, """соответствиеНаА"": ""да""") > 0, "признак соответствия на А - «да»");
	Утверждать.Истина(СтрНайти(ТекстБаланса, """всеКлючи"": ""да""") > 0, "признак всех ключей из Булево - «да»");
	Утверждать.Истина(СтрНайти(ТекстБаланса, """пояснения"": [") > 0, "пояснения - массивом строк");
	НастройкиПроекта.ЗаписатьОбъект("источник", ПрочитатьJSON(ТекстSQL), ПроектБ);
	НастройкиПроекта.ЗаписатьОбъект("настройка", ПрочитатьJSON(ТекстБаланса), ПроектБ);
	Утверждать.Равно(НастройкиПроекта.ТекстФайлаОбъекта("настройка", "Баланс (тест)", ПроектБ), ТекстБаланса,
		"настройка с новыми полями: туда и обратно без потерь");
	БалансОбъект = НастройкиПроекта.НайтиОбъект("настройка", "Баланс (тест)", ПроектБ).ПолучитьОбъект();
	Утверждать.Истина(НастройкиПроекта.ЗначениеПризнака(БалансОбъект.СоответствиеНаИсточникеА), "признак соответствия на А загружен");
	Утверждать.Равно(БалансОбъект.НастройкаРасшифровки, "Баланс по аналитике (тест)", "имя расшифровки загружено");
	ОписаниеSQL.Вставить("наименование", "СУБД с паролем");
	ОписаниеSQL.Вставить("секретСУБД", "ПарольСУБД123");
	НастройкиПроекта.ЗаписатьИсточник(ОписаниеSQL, ПроектА);
	ОшибкаВыгрузкиSQL = "";
	Попытка
		НастройкиПроекта.ТекстФайлаОбъекта("источник", "СУБД с паролем", ПроектА);
	Исключение
		ОшибкаВыгрузкиSQL = ОписаниеОшибки();
	КонецПопытки;
	Утверждать.Истина(СтрНайти(ОшибкаВыгрузкиSQL, "не ссылка file:") > 0, "секрет СУБД не file: - выгрузка отказывает");

	// Пароль вместо ссылки на секрет в файл не выгружается.
	ОписаниеИсточника.Вставить("наименование", "с паролем");
	ОписаниеИсточника.Вставить("секрет", "Пароль123");
	НастройкиПроекта.ЗаписатьИсточник(ОписаниеИсточника, ПроектА);
	ОшибкаВыгрузки = "";
	Попытка
		НастройкиПроекта.ТекстФайлаОбъекта("источник", "с паролем", ПроектА);
	Исключение
		ОшибкаВыгрузки = ОписаниеОшибки();
	КонецПопытки;
	Утверждать.Истина(СтрНайти(ОшибкаВыгрузки, "не ссылка file:") > 0, "секрет не file: - выгрузка отказывает");
	Утверждать.Ложь(СтрНайти(ОшибкаВыгрузки, "Пароль123") > 0, "текст ошибки без пароля");

КонецПроцедуры

Процедура ПроверитьСтарыйФорматСнимка()

	Снимок = "{""источники"": [{""наименование"": ""снимок-источник"", ""тип"": ""Fastex1С8"", ""адрес"": ""http://h.example/b"","
		+ " ""пользователь"": ""u"", ""секрет"": ""file:/x.secret""}],"
		+ " ""настройки"": [{""наименование"": ""снимок-настройка"", ""источникА"": ""снимок-источник"","
		+ " ""источникБ"": ""снимок-источник"", ""запросА"": ""ВЫБРАТЬ 1"", ""запросБ"": ""ВЫБРАТЬ 2"","
		+ " ""ключевыеПоля"": ""К"", ""поляЗначений"": ""С"", ""погрешность"": 0}]}";
	ПутьКФайлу = ПолучитьИмяВременногоФайла("json");
	ЗаписьФайла = Новый ЗаписьТекста(ПутьКФайлу);
	ЗаписьФайла.Открыть();
	ЗаписьФайла.Записать(Снимок);
	ЗаписьФайла.Закрыть();

	Проект = СоздатьПроект("Тест снимка");
	Утверждать.Равно(НастройкиПроекта.ЗагрузитьФайл(ПутьКФайлу, Проект), 2, "снимок старого формата: источник и настройка");
	УдалитьФайлы(ПутьКФайлу);
	ТекстНастройки = НастройкиПроекта.ТекстФайлаОбъекта("настройка", "снимок-настройка", Проект);
	Утверждать.Истина(СтрНайти(ТекстНастройки, """запросА"": ""ВЫБРАТЬ 1"",") > 0, "однострочный запрос - строкой");
	Утверждать.Истина(СтрНайти(ТекстНастройки, """порцииЗапроса"": """",") > 0, "отсутствующий ключ - пустой строкой");

КонецПроцедуры

Процедура ПроверитьИменаФайлов()

	Утверждать.Равно(НастройкиПроекта.ИмяФайла("ПТУ строки Поставщик*** (проба)"), "ПТУ строки Поставщик___ (проба).json",
		"звездочки в имени файла заменяются");
	Утверждать.Равно(НастройкиПроекта.ИмяФайла("51 ↔ ДенежныеСредства"), "51 ↔ ДенежныеСредства.json",
		"стрелка остается");
	Утверждать.Равно(НастройкиПроекта.ИмяФайла("a/b:c?"), "a_b_c_.json", "разделители пути заменяются");

КонецПроцедуры

Процедура ПроверитьАдресРепозитория()

	Адрес = РепозиторийНастроек.РазобратьАдресРепозитория("https://git.example.org/team/sverka-settings.git");
	Утверждать.Равно(Адрес.Хост, "git.example.org", "хост");
	Утверждать.Равно(Адрес.Порт, 443, "порт https по умолчанию");
	Утверждать.Истина(Адрес.Защищенное, "https");
	Утверждать.Равно(Адрес.ПутьAPI, "/api/v1/repos/team/sverka-settings", "путь API без .git");

	Адрес = РепозиторийНастроек.РазобратьАдресРепозитория("http://git.example.org:3000/forgejo/team/repo/");
	Утверждать.Равно(Адрес.Порт, 3000, "явный порт");
	Утверждать.Ложь(Адрес.Защищенное, "http");
	Утверждать.Равно(Адрес.ПутьAPI, "/forgejo/api/v1/repos/team/repo", "префикс публикации сохраняется");

	ОшибкаАдреса = "";
	Попытка
		РепозиторийНастроек.РазобратьАдресРепозитория("ssh://git@git.example.org:2222/team/repo.git");
	Исключение
		ОшибкаАдреса = ОписаниеОшибки();
	КонецПопытки;
	Утверждать.Заполнено(ОшибкаАдреса, "адрес ssh для API отклоняется");

КонецПроцедуры

Процедура ПроверитьРешенияОтправки()

	Состояние = Новый Структура("Sha, Содержимое", "sha1", "текст");
	Утверждать.Равно(РепозиторийНастроек.ДействиеОтправки(Неопределено, Неопределено, "текст"), "создать",
		"нового файла нет и не было - создать");
	Утверждать.Равно(РепозиторийНастроек.ДействиеОтправки(Состояние, "sha1", "текст"), "без изменений",
		"ничего не менялось");
	Утверждать.Равно(РепозиторийНастроек.ДействиеОтправки(Состояние, "sha1", "правка"), "обновить",
		"правка в базе, в репозитории без изменений - обновить");
	Утверждать.Истина(СтрНачинаетсяС(РепозиторийНастроек.ДействиеОтправки(Состояние, "sha2", "правка"), "конфликт"),
		"правка в базе и в репозитории - конфликт, не перезаписывать");
	Утверждать.Истина(СтрНачинаетсяС(РепозиторийНастроек.ДействиеОтправки(Состояние, "sha2", "текст"), "конфликт"),
		"в репозитории новее - не перезаписывать");
	Утверждать.Истина(СтрНачинаетсяС(РепозиторийНастроек.ДействиеОтправки(Неопределено, "sha1", "текст"), "конфликт"),
		"файл в репозитории есть, получения не было - конфликт");
	Утверждать.Равно(РепозиторийНастроек.ДействиеОтправки(Состояние, Неопределено, "текст"), "удален в репозитории",
		"файл удалили в репозитории - не восстанавливать");

КонецПроцедуры

Процедура ПроверитьРешенияПолучения()

	Состояние = Новый Структура("Sha, Содержимое", "sha1", "текст");
	Утверждать.Равно(РепозиторийНастроек.ДействиеПолучения(Неопределено, Неопределено, "новый", Ложь), "создать",
		"объекта в базе нет - создать");
	Утверждать.Равно(РепозиторийНастроек.ДействиеПолучения(Состояние, "текст", "новый", Ложь), "обновить",
		"в базе без правок - обновить");
	Утверждать.Равно(РепозиторийНастроек.ДействиеПолучения(Состояние, "новый", "новый", Ложь), "совпадает",
		"одинаковая правка с обеих сторон - не конфликт");
	Утверждать.Истина(СтрНачинаетсяС(РепозиторийНастроек.ДействиеПолучения(Состояние, "правка", "новый", Ложь), "конфликт"),
		"правка в базе и в репозитории - конфликт, базу не затирать");
	Утверждать.Равно(РепозиторийНастроек.ДействиеПолучения(Состояние, "правка", "новый", Истина), "заменить",
		"с заменой локальных - заменить");
	Утверждать.Истина(СтрНачинаетсяС(РепозиторийНастроек.ДействиеПолучения(Неопределено, "свое", "новый", Ложь), "конфликт"),
		"объект есть в базе, синхронизации не было, тексты разные - конфликт");

КонецПроцедуры
