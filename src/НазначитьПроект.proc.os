// Переносит источники и настройки, у которых проект не указан (заведенные до появления проектов),
// в проект с указанным наименованием; проект создается, если его нет. Объекты с проектом не трогает.
// Наименования в проекте должны быть уникальны: совпадение с объектом проекта - ошибка до переноса.
Процедура Выполнить() Экспорт

	ИмяПроекта = СокрЛП(Параметры.ИмяПроекта);
	Если Не ЗначениеЗаполнено(ИмяПроекта) Тогда
		ВызватьИсключение "Не задан проект сверки";
	КонецЕсли;
	Проект = Справочники.ПроектыСверки.НайтиПоНаименованию(ИмяПроекта);
	Если Проект = Неопределено Тогда
		ПроектОбъект = Справочники.ПроектыСверки.Создать();
		ПроектОбъект.Наименование = ИмяПроекта;
		ПроектОбъект.Ветка = "main";
		ПроектОбъект.Записать();
		Проект = Справочники.ПроектыСверки.НайтиПоНаименованию(ИмяПроекта);
		Сообщить("Создан проект " + ИмяПроекта);
	КонецЕсли;

	Для Каждого Вид Из СтрРазделить(НастройкиПроекта.ВидИсточник() + "," + НастройкиПроекта.ВидНастройка(), ",") Цикл
		Для Каждого Наименование Из НастройкиПроекта.НаименованияОбъектов(Вид, Неопределено) Цикл
			Если НастройкиПроекта.НайтиОбъект(Вид, Наименование, Проект) <> Неопределено Тогда
				ВызватьИсключение "В проекте " + ИмяПроекта + " уже есть " + Вид + " «" + Наименование + "»";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ЧислоОбъектов = 0;
	Для Каждого Вид Из СтрРазделить(НастройкиПроекта.ВидИсточник() + "," + НастройкиПроекта.ВидНастройка(), ",") Цикл
		Для Каждого Наименование Из НастройкиПроекта.НаименованияОбъектов(Вид, Неопределено) Цикл
			Объект = НастройкиПроекта.НайтиОбъект(Вид, Наименование, Неопределено).ПолучитьОбъект();
			Объект.Проект = Проект;
			Объект.Записать();
			ЧислоОбъектов = ЧислоОбъектов + 1;
		КонецЦикла;
	КонецЦикла;
	Сообщить("Перенесено в проект " + ИмяПроекта + ": " + Строка(ЧислоОбъектов));

КонецПроцедуры
