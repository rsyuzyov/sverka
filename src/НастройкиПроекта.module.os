// Проекты сверки: поиск источников и настроек по имени в пределах проекта, запись из описаний
// и формат файлов настроек в репозитории.
//
// Формат файла: один JSON-объект на источник (sources/<имя>.json) или настройку (settings/<имя>.json).
// Ключи - те же, что у элементов массивов «источники» и «настройки» снимков для обработки
// ЗагрузитьНастройки, всегда все и всегда в одном порядке; отступ два пробела; многострочные
// тексты (запросы, порции) - массивом строк, чтобы дифф показывал измененную строку запроса.
// Пароли в файл не попадают: у источника хранится только ссылка на секрет file:<путь>.

Функция КаталогИсточников() Экспорт
	Возврат "sources";
КонецФункции

Функция КаталогНастроек() Экспорт
	Возврат "settings";
КонецФункции

Функция ВидИсточник() Экспорт
	Возврат "источник";
КонецФункции

Функция ВидНастройка() Экспорт
	Возврат "настройка";
КонецФункции

// Ключи файла источника в порядке записи.
Функция КлючиИсточника() Экспорт
	Возврат СтрРазделить("наименование,тип,адрес,пользователь,секрет,пользователь77,секрет77,строкаСоединенияСУБД,секретСУБД", ",");
КонецФункции

// Ключи файла настройки в порядке записи: короткие поля сверху, тексты запросов снизу.
Функция КлючиНастройки() Экспорт
	Возврат СтрРазделить("наименование,источникА,источникБ,ключевыеПоля,поляЗначений,погрешность,"
		+ "поляБезУчетаФормата,соответствиеНаА,всеКлючи,расшифровка,порцииЗапроса,запросА,запросБ,запросСоответствияБ,"
		+ "пояснения", ",");
КонецФункции

Функция КлючиВида(Вид) Экспорт
	Если Вид = ВидИсточник() Тогда
		Возврат КлючиИсточника();
	КонецЕсли;
	Возврат КлючиНастройки();
КонецФункции

Функция ЭтоМногострочныйКлюч(Ключ)
	Возврат Ключ = "порцииЗапроса" Или Ключ = "запросА" Или Ключ = "запросБ" Или Ключ = "запросСоответствияБ"
		Или Ключ = "пояснения";
КонецФункции

Функция ЭтоСекретныйКлюч(Ключ)
	Возврат Ключ = "секрет" Или Ключ = "секрет77" Или Ключ = "секретСУБД";
КонецФункции

// --- Проекты ---

// Проект по наименованию. Пустое имя - Неопределено (объекты без проекта).
Функция НайтиПроект(ИмяПроекта) Экспорт

	Если Не ЗначениеЗаполнено(ИмяПроекта) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Проект = Справочники.ПроектыСверки.НайтиПоНаименованию(ИмяПроекта);
	Если Проект = Неопределено Тогда
		ВызватьИсключение "Не найден проект сверки " + ИмяПроекта;
	КонецЕсли;

	Возврат Проект;

КонецФункции

// Идентификатор ссылки строкой или пустая строка для пустой ссылки: так сравниваются проекты,
// полученные разными путями (Строка() у ссылок из разных источников дает разное).
Функция ИдСсылки(Ссылка) Экспорт

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Ссылка) = Тип("Строка") Тогда
		Возврат Ссылка;
	КонецЕсли;

	Возврат Ссылка.УникальныйИдентификатор();

КонецФункции

// --- Поиск объектов в пределах проекта ---

Функция ИмяСправочникаВида(Вид)
	Если Вид = ВидИсточник() Тогда
		Возврат "Источники";
	КонецЕсли;
	Возврат "НастройкиСверки";
КонецФункции

// Ссылки объектов вида с наименованием в проекте (Проект Неопределено - объекты без проекта).
Функция НайтиОбъекты(Вид, Наименование, Проект) Экспорт

	ЗапросОбъектов = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ Ссылка ИЗ Справочник." + ИмяСправочникаВида(Вид) + " ГДЕ Наименование = &Наименование";
	Если ЗначениеЗаполнено(Проект) Тогда
		ТекстЗапроса = ТекстЗапроса + " И Проект = &Проект";
		ЗапросОбъектов.УстановитьПараметр("Проект", Проект);
	Иначе
		ТекстЗапроса = ТекстЗапроса + " И Проект ЕСТЬ NULL";
	КонецЕсли;
	ЗапросОбъектов.Текст = ТекстЗапроса;
	ЗапросОбъектов.УстановитьПараметр("Наименование", Наименование);

	Найденные = Новый Массив;
	Для Каждого Запись Из ЗапросОбъектов.Выполнить() Цикл
		Найденные.Добавить(Строка(Запись.Ссылка));
	КонецЦикла;

	Возврат Найденные;

КонецФункции

// Ссылка на объект вида по наименованию в проекте или Неопределено.
Функция НайтиОбъект(Вид, Наименование, Проект) Экспорт

	Найденные = НайтиОбъекты(Вид, Наименование, Проект);
	Если Найденные.Количество() = 0 Тогда
		Возврат Неопределено;
	ИначеЕсли Найденные.Количество() > 1 Тогда
		ВызватьИсключение "В проекте " + ПредставлениеПроекта(Проект) + " несколько объектов вида «" + Вид
			+ "» с наименованием " + Наименование;
	КонецЕсли;

	Если Вид = ВидИсточник() Тогда
		Возврат Справочники.Источники.НайтиПоИдентификатору(Найденные.Получить(0));
	КонецЕсли;

	Возврат Справочники.НастройкиСверки.НайтиПоИдентификатору(Найденные.Получить(0));

КонецФункции

Функция ПредставлениеПроекта(Проект) Экспорт
	Если Не ЗначениеЗаполнено(Проект) Тогда
		Возврат "«без проекта»";
	КонецЕсли;
	Возврат "«" + НаименованиеПроекта(Проект) + "»";
КонецФункции

Функция НаименованиеПроекта(Проект) Экспорт

	Если Не ЗначениеЗаполнено(Проект) Тогда
		Возврат "";
	КонецЕсли;
	ЗапросПроекта = Новый Запрос;
	ЗапросПроекта.Текст = "ВЫБРАТЬ Наименование ИЗ Справочник.ПроектыСверки ГДЕ Ссылка = &Проект";
	ЗапросПроекта.УстановитьПараметр("Проект", Проект);
	Для Каждого Запись Из ЗапросПроекта.Выполнить() Цикл
		Возврат Запись.Наименование;
	КонецЦикла;

	Возврат "";

КонецФункции

// Настройка сверки по наименованию. Без проекта ищется во всех проектах: одна - она,
// несколько - ошибка с просьбой указать проект.
Функция НайтиНастройкуДляЗапуска(ИмяНастройки, ИмяПроекта) Экспорт

	Если ЗначениеЗаполнено(ИмяПроекта) Тогда
		Настройка = НайтиОбъект(ВидНастройка(), ИмяНастройки, НайтиПроект(ИмяПроекта));
		Если Настройка = Неопределено Тогда
			ВызватьИсключение "Не найдена настройка сверки " + ИмяНастройки + " в проекте " + ИмяПроекта;
		КонецЕсли;
		Возврат Настройка;
	КонецЕсли;

	ЗапросНастроек = Новый Запрос;
	ЗапросНастроек.Текст = "ВЫБРАТЬ Ссылка ИЗ Справочник.НастройкиСверки ГДЕ Наименование = &Наименование";
	ЗапросНастроек.УстановитьПараметр("Наименование", ИмяНастройки);
	Найденные = Новый Массив;
	Для Каждого Запись Из ЗапросНастроек.Выполнить() Цикл
		Найденные.Добавить(Строка(Запись.Ссылка));
	КонецЦикла;
	Если Найденные.Количество() = 0 Тогда
		ВызватьИсключение "Не найдена настройка сверки " + ИмяНастройки;
	ИначеЕсли Найденные.Количество() > 1 Тогда
		ВызватьИсключение "Настройка " + ИмяНастройки + " есть в нескольких проектах - укажите проект";
	КонецЕсли;

	Возврат Справочники.НастройкиСверки.НайтиПоИдентификатору(Найденные.Получить(0));

КонецФункции

// Наименования объектов вида в проекте, по алфавиту.
Функция НаименованияОбъектов(Вид, Проект) Экспорт

	ЗапросОбъектов = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ Наименование ИЗ Справочник." + ИмяСправочникаВида(Вид);
	Если ЗначениеЗаполнено(Проект) Тогда
		ТекстЗапроса = ТекстЗапроса + " ГДЕ Проект = &Проект";
		ЗапросОбъектов.УстановитьПараметр("Проект", Проект);
	Иначе
		ТекстЗапроса = ТекстЗапроса + " ГДЕ Проект ЕСТЬ NULL";
	КонецЕсли;
	ЗапросОбъектов.Текст = ТекстЗапроса + " УПОРЯДОЧИТЬ ПО Наименование";

	Наименования = Новый Массив;
	Для Каждого Запись Из ЗапросОбъектов.Выполнить() Цикл
		Наименования.Добавить(Запись.Наименование);
	КонецЦикла;

	Возврат Наименования;

КонецФункции

// --- Описание объекта базы (для выгрузки) ---

// Описание объекта вида по наименованию в проекте: упорядоченное Соответствие ключей файла.
Функция ОписаниеОбъекта(Вид, Наименование, Проект) Экспорт

	ЗапросОбъекта = Новый Запрос;
	Если Вид = ВидИсточник() Тогда
		ТекстЗапроса = "ВЫБРАТЬ Наименование, Тип, АдресПубликации, Пользователь, СекретПароля,
			|	Пользователь77, СекретПароля77, СтрокаСоединенияСУБД, СекретПароляСУБД
			|ИЗ Справочник.Источники
			|ГДЕ Наименование = &Наименование";
	Иначе
		ТекстЗапроса = "ВЫБРАТЬ Наименование, ИсточникА.Наименование КАК ИмяИсточникаА,
			|	ИсточникБ.Наименование КАК ИмяИсточникаБ, КлючевыеПоля, ПоляЗначений, Погрешность,
			|	ПоляБезУчетаФормата, ПорцииЗапроса, ЗапросА, ЗапросБ, ЗапросСоответствияБ,
			|	СоответствиеНаИсточникеА, ВсеКлючиВРезультате, НастройкаРасшифровки, Пояснения
			|ИЗ Справочник.НастройкиСверки
			|ГДЕ Наименование = &Наименование";
	КонецЕсли;
	Если ЗначениеЗаполнено(Проект) Тогда
		ТекстЗапроса = ТекстЗапроса + " И Проект = &Проект";
		ЗапросОбъекта.УстановитьПараметр("Проект", Проект);
	Иначе
		ТекстЗапроса = ТекстЗапроса + " И Проект ЕСТЬ NULL";
	КонецЕсли;
	ЗапросОбъекта.Текст = ТекстЗапроса;
	ЗапросОбъекта.УстановитьПараметр("Наименование", Наименование);
	Выборка = ЗапросОбъекта.Выполнить();
	Если Выборка.Количество() <> 1 Тогда
		ВызватьИсключение "В проекте " + ПредставлениеПроекта(Проект) + " объектов вида «" + Вид + "» с наименованием "
			+ Наименование + ": " + Строка(Выборка.Количество()) + " (ожидался один)";
	КонецЕсли;
	Запись = Выборка.Получить(0);

	Значения = Новый Соответствие;
	Если Вид = ВидИсточник() Тогда
		Значения.Вставить("наименование", Запись.Наименование);
		Значения.Вставить("тип", Запись.Тип);
		Значения.Вставить("адрес", Запись.АдресПубликации);
		Значения.Вставить("пользователь", Запись.Пользователь);
		Значения.Вставить("секрет", Запись.СекретПароля);
		Значения.Вставить("пользователь77", Запись.Пользователь77);
		Значения.Вставить("секрет77", Запись.СекретПароля77);
		Значения.Вставить("строкаСоединенияСУБД", Запись.СтрокаСоединенияСУБД);
		Значения.Вставить("секретСУБД", Запись.СекретПароляСУБД);
	Иначе
		Значения.Вставить("наименование", Запись.Наименование);
		Значения.Вставить("источникА", Запись.ИмяИсточникаА);
		Значения.Вставить("источникБ", Запись.ИмяИсточникаБ);
		Значения.Вставить("ключевыеПоля", Запись.КлючевыеПоля);
		Значения.Вставить("поляЗначений", Запись.ПоляЗначений);
		Значения.Вставить("погрешность", Запись.Погрешность);
		Значения.Вставить("поляБезУчетаФормата", Запись.ПоляБезУчетаФормата);
		Значения.Вставить("соответствиеНаА", ТекстПризнака(Запись.СоответствиеНаИсточникеА));
		Значения.Вставить("всеКлючи", ТекстПризнака(Запись.ВсеКлючиВРезультате));
		Значения.Вставить("расшифровка", Запись.НастройкаРасшифровки);
		Значения.Вставить("пояснения", Запись.Пояснения);
		Значения.Вставить("порцииЗапроса", Запись.ПорцииЗапроса);
		Значения.Вставить("запросА", Запись.ЗапросА);
		Значения.Вставить("запросБ", Запись.ЗапросБ);
		Значения.Вставить("запросСоответствияБ", Запись.ЗапросСоответствияБ);
	КонецЕсли;

	Возврат КаноническоеОписание(Значения, Вид);

КонецФункции

// --- Канонический вид описания и текст файла ---

// Приводит описание (из базы или прочитанное из JSON) к каноническому виду: все ключи вида
// в фиксированном порядке, пустое - пустая строка, погрешность - число, многострочный текст -
// массив строк без символов возврата каретки. Секрет - только ссылка file:, иначе ошибка.
Функция КаноническоеОписание(Описание, Вид) Экспорт

	Результат = Новый Соответствие;
	Для Каждого Ключ Из КлючиВида(Вид) Цикл
		Значение = Описание.Получить(Ключ);
		Если Ключ = "погрешность" Тогда
			Результат.Вставить(Ключ, ЧислоЗначения(Значение));
			Продолжить;
		КонецЕсли;

		Текст = ТекстЗначения(Значение);
		Если ЭтоСекретныйКлюч(Ключ) И ЗначениеЗаполнено(Текст) И Не СтрНачинаетсяС(СокрЛП(Текст), "file:") Тогда
			ВызватьИсключение "Поле «" + Ключ + "» у «" + ТекстЗначения(Описание.Получить("наименование"))
				+ "» не ссылка file:<путь> - в файл настроек не выгружается";
		КонецЕсли;

		Если ЭтоМногострочныйКлюч(Ключ) Тогда
			Текст = СтрЗаменить(Текст, Символы.ВК, "");
			Если СтрНайти(Текст, Символы.ПС) > 0 Тогда
				Результат.Вставить(Ключ, СтрРазделить(Текст, Символы.ПС));
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Результат.Вставить(Ключ, Текст);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Строковое значение поля описания: массив строк склеивается переводами строки.
Функция ТекстЗначения(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Части = Новый Массив;
		Для Каждого Часть Из Значение Цикл
			Части.Добавить(ТекстЗначения(Часть));
		КонецЦикла;
		Возврат СтрСоединить(Части, Символы.ПС);
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

// Число из значения описания: число как есть, числовая строка - числом, пустое - ноль.
// Признак в файле настроек - строка «да» или пустая строка: файл остается плоским словарем строк.
Функция ТекстПризнака(Значение) Экспорт
	Возврат ?(ЗначениеПризнака(Значение), "да", "");
КонецФункции

// Булево из признака: Булево как есть; число - не ноль (поле type: bool, прочитанное из SQLite объектом,
// приходит числом 1); строка - «да».
Функция ЗначениеПризнака(Значение) Экспорт
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	КонецЕсли;
	Возврат НРег(СокрЛП(ТекстЗначения(Значение))) = "да";
КонецФункции

Функция ЧислоЗначения(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(СокрЛП(Значение)) Тогда
		Возврат Число(СтрЗаменить(СокрЛП(Значение), ",", "."));
	КонецЕсли;

	Возврат 0;

КонецФункции

// Текст файла настроек из канонического описания: JSON с отступом два пробела, ключи в порядке
// описания, в конце перевод строки.
Функция ТекстФайла(Описание) Экспорт

	СтрокиФайла = Новый Массив;
	СтрокиФайла.Добавить("{");
	ЧислоКлючей = Описание.Количество();
	НомерКлюча = 0;
	Для Каждого Элемент Из Описание Цикл
		НомерКлюча = НомерКлюча + 1;
		Запятая = ?(НомерКлюча < ЧислоКлючей, ",", "");
		Начало = "  " + ЛитералJSON(Элемент.Ключ) + ": ";
		Значение = Элемент.Значение;
		Если ТипЗнч(Значение) = Тип("Массив") Тогда
			СтрокиФайла.Добавить(Начало + "[");
			ПоследнийНомер = Значение.Количество();
			НомерСтроки = 0;
			Для Каждого СтрокаТекста Из Значение Цикл
				НомерСтроки = НомерСтроки + 1;
				СтрокиФайла.Добавить("    " + ЛитералJSON(СтрокаТекста) + ?(НомерСтроки < ПоследнийНомер, ",", ""));
			КонецЦикла;
			СтрокиФайла.Добавить("  ]" + Запятая);
		ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
			СтрокиФайла.Добавить(Начало + XMLСтрока(Значение) + Запятая);
		ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
			СтрокиФайла.Добавить(Начало + ?(Значение, "true", "false") + Запятая);
		Иначе
			СтрокиФайла.Добавить(Начало + ЛитералJSON(ТекстЗначения(Значение)) + Запятая);
		КонецЕсли;
	КонецЦикла;
	СтрокиФайла.Добавить("}");

	Возврат СтрСоединить(СтрокиФайла, Символы.ПС) + Символы.ПС;

КонецФункции

// Строковый литерал JSON без экранирования <, > и & (ЗаписатьJSON их экранирует, и запросы
// с «<>» в диффе читались бы плохо). Только встроенные замены: посимвольный цикл в DSL медленный.
Функция ЛитералJSON(Текст) Экспорт

	Результат = СтрЗаменить(Текст, "\", "\\");
	Результат = СтрЗаменить(Результат, """", "\""");
	Для КодЗнака = 0 По 31 Цикл
		Знак = Символ(КодЗнака);
		Если СтрНайти(Результат, Знак) > 0 Тогда
			Результат = СтрЗаменить(Результат, Знак, ЭкранУправляющегоСимвола(КодЗнака));
		КонецЕсли;
	КонецЦикла;

	Возврат """" + Результат + """";

КонецФункции

Функция ЭкранУправляющегоСимвола(КодЗнака)

	Если КодЗнака = 10 Тогда
		Возврат "\n";
	ИначеЕсли КодЗнака = 13 Тогда
		Возврат "\r";
	ИначеЕсли КодЗнака = 9 Тогда
		Возврат "\t";
	КонецЕсли;
	ЦифрыHex = "0123456789abcdef";
	СтаршаяЦифра = Цел(КодЗнака / 16);
	МладшаяЦифра = КодЗнака - СтаршаяЦифра * 16;

	Возврат "\u00" + Сред(ЦифрыHex, СтаршаяЦифра + 1, 1) + Сред(ЦифрыHex, МладшаяЦифра + 1, 1);

КонецФункции

// Текст файла объекта базы.
Функция ТекстФайлаОбъекта(Вид, Наименование, Проект) Экспорт
	Возврат ТекстФайла(ОписаниеОбъекта(Вид, Наименование, Проект));
КонецФункции

// --- Имена файлов ---

// Имя файла по наименованию: символы, недопустимые в именах файлов Windows и в адресе API,
// заменяются подчеркиванием; настоящее наименование хранится внутри файла.
Функция ИмяФайла(Наименование) Экспорт

	Имя = СокрЛП(Наименование);
	Для Каждого Запрещенный Из СтрРазделить("\,/,:,*,?,"",<,>,|,#,%", ",") Цикл
		Имя = СтрЗаменить(Имя, Запрещенный, "_");
	КонецЦикла;
	Для КодЗнака = 0 По 31 Цикл
		Имя = СтрЗаменить(Имя, Символ(КодЗнака), "_");
	КонецЦикла;
	Пока СтрЗаканчиваетсяНа(Имя, ".") Цикл
		Имя = Лев(Имя, СтрДлина(Имя) - 1) + "_";
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Имя) Тогда
		ВызватьИсключение "Пустое наименование объекта - имя файла не построить";
	КонецЕсли;

	Возврат Имя + ".json";

КонецФункции

// Вид объекта по каталогу файла (sources или settings) или Неопределено.
Функция ВидПоКаталогу(ИмяКаталога) Экспорт

	Если ИмяКаталога = КаталогИсточников() Тогда
		Возврат ВидИсточник();
	ИначеЕсли ИмяКаталога = КаталогНастроек() Тогда
		Возврат ВидНастройка();
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция КаталогВида(Вид) Экспорт
	Если Вид = ВидИсточник() Тогда
		Возврат КаталогИсточников();
	КонецЕсли;
	Возврат КаталогНастроек();
КонецФункции

// Вид объекта по ключам описания: у настройки есть источникА, у источника - тип или адрес.
Функция ВидПоКлючам(Описание) Экспорт

	Если Описание.Получить("источникА") <> Неопределено Или Описание.Получить("запросА") <> Неопределено Тогда
		Возврат ВидНастройка();
	ИначеЕсли Описание.Получить("тип") <> Неопределено Или Описание.Получить("адрес") <> Неопределено Тогда
		Возврат ВидИсточник();
	КонецЕсли;

	ВызватьИсключение "Не удалось определить, источник это или настройка: " + ТекстЗначения(Описание.Получить("наименование"));

КонецФункции

// --- Запись объектов из описаний ---

// Заводит или обновляет объект вида по описанию в проекте. Возвращает ссылку.
Функция ЗаписатьОбъект(Вид, Описание, Проект) Экспорт

	Если Вид = ВидИсточник() Тогда
		Возврат ЗаписатьИсточник(Описание, Проект);
	КонецЕсли;

	Возврат ЗаписатьНастройку(Описание, Проект);

КонецФункции

Функция ЗаписатьИсточник(Описание, Проект) Экспорт

	Наименование = ТекстЗначения(Описание.Получить("наименование"));
	Ссылка = НайтиОбъект(ВидИсточник(), Наименование, Проект);
	Если Ссылка = Неопределено Тогда
		Объект = Справочники.Источники.Создать();
	Иначе
		Объект = Ссылка.ПолучитьОбъект();
	КонецЕсли;

	Объект.Наименование = Наименование;
	Если ЗначениеЗаполнено(Проект) Тогда
		Объект.Проект = Проект;
	КонецЕсли;
	Если ТекстЗначения(Описание.Получить("тип")) = "Fastex77ЧерезБазу1С8" Тогда
		Объект.Тип = Перечисления.ТипыИсточников.Fastex77ЧерезБазу1С8;
	ИначеЕсли ТекстЗначения(Описание.Получить("тип")) = "SQLЧерезБазу1С8" Тогда
		Объект.Тип = Перечисления.ТипыИсточников.SQLЧерезБазу1С8;
	Иначе
		Объект.Тип = Перечисления.ТипыИсточников.Fastex1С8;
	КонецЕсли;
	Объект.АдресПубликации = ТекстЗначения(Описание.Получить("адрес"));
	Объект.Пользователь = ТекстЗначения(Описание.Получить("пользователь"));
	Объект.СекретПароля = ТекстЗначения(Описание.Получить("секрет"));
	Объект.Пользователь77 = ТекстЗначения(Описание.Получить("пользователь77"));
	Объект.СекретПароля77 = ТекстЗначения(Описание.Получить("секрет77"));
	Объект.СтрокаСоединенияСУБД = ТекстЗначения(Описание.Получить("строкаСоединенияСУБД"));
	Объект.СекретПароляСУБД = ТекстЗначения(Описание.Получить("секретСУБД"));
	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

Функция ЗаписатьНастройку(Описание, Проект) Экспорт

	Наименование = ТекстЗначения(Описание.Получить("наименование"));
	Ссылка = НайтиОбъект(ВидНастройка(), Наименование, Проект);
	Если Ссылка = Неопределено Тогда
		Объект = Справочники.НастройкиСверки.Создать();
	Иначе
		Объект = Ссылка.ПолучитьОбъект();
	КонецЕсли;

	Объект.Наименование = Наименование;
	Если ЗначениеЗаполнено(Проект) Тогда
		Объект.Проект = Проект;
	КонецЕсли;
	Объект.ИсточникА = ИсточникНастройки(Описание.Получить("источникА"), Проект, Наименование);
	Объект.ЗапросА = ТекстЗначения(Описание.Получить("запросА"));
	Объект.ИсточникБ = ИсточникНастройки(Описание.Получить("источникБ"), Проект, Наименование);
	Объект.ЗапросБ = ТекстЗначения(Описание.Получить("запросБ"));
	Объект.ЗапросСоответствияБ = ТекстЗначения(Описание.Получить("запросСоответствияБ"));
	Объект.ПорцииЗапроса = ТекстЗначения(Описание.Получить("порцииЗапроса"));
	Объект.КлючевыеПоля = ТекстЗначения(Описание.Получить("ключевыеПоля"));
	Объект.ПоляЗначений = ТекстЗначения(Описание.Получить("поляЗначений"));
	Объект.Погрешность = ЧислоЗначения(Описание.Получить("погрешность"));
	Объект.ПоляБезУчетаФормата = ТекстЗначения(Описание.Получить("поляБезУчетаФормата"));
	Объект.СоответствиеНаИсточникеА = ЗначениеПризнака(Описание.Получить("соответствиеНаА"));
	Объект.ВсеКлючиВРезультате = ЗначениеПризнака(Описание.Получить("всеКлючи"));
	Объект.НастройкаРасшифровки = ТекстЗначения(Описание.Получить("расшифровка"));
	Объект.Пояснения = ТекстЗначения(Описание.Получить("пояснения"));
	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

Функция ИсточникНастройки(ИмяИсточника, Проект, ИмяНастройки)

	Наименование = ТекстЗначения(ИмяИсточника);
	Ссылка = НайтиОбъект(ВидИсточник(), Наименование, Проект);
	Если Ссылка = Неопределено Тогда
		ВызватьИсключение "Настройка " + ИмяНастройки + ": не найден источник «" + Наименование + "» в проекте "
			+ ПредставлениеПроекта(Проект);
	КонецЕсли;

	Возврат Ссылка;

КонецФункции

// --- Загрузка из файлов (обработка ЗагрузитьНастройки) ---

Функция ПрочитатьФайл(ПутьКФайлу) Экспорт

	ЧтениеФайла = Новый ЧтениеТекста(ПутьКФайлу);
	ЧтениеФайла.Открыть();
	Текст = ЧтениеФайла.Прочитать();
	ЧтениеФайла.Закрыть();

	Возврат Текст;

КонецФункции

// Загружает файл JSON в проект. Понимает два формата:
// снимок {"источники": [...], "настройки": [...]} и файл одного объекта из репозитория
// (вид - по каталогу sources/settings в пути, иначе по ключам). Возвращает число объектов.
Функция ЗагрузитьФайл(ПутьКФайлу, Проект) Экспорт

	Данные = ПрочитатьJSON(ПрочитатьФайл(ПутьКФайлу));
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Файл " + ПутьКФайлу + " - не JSON-объект";
	КонецЕсли;

	ОписанияИсточников = Данные.Получить("источники");
	ОписанияНастроек = Данные.Получить("настройки");
	Если ОписанияИсточников = Неопределено И ОписанияНастроек = Неопределено Тогда
		Вид = ВидПоКаталогу(ИмяКаталогаФайла(ПутьКФайлу));
		Если Вид = Неопределено Тогда
			Вид = ВидПоКлючам(Данные);
		КонецЕсли;
		ЗаписатьОбъект(Вид, Данные, Проект);
		Сообщить("Записан объект (" + Вид + "): " + ТекстЗначения(Данные.Получить("наименование")));
		Возврат 1;
	КонецЕсли;

	ЧислоОбъектов = 0;
	Если ОписанияИсточников <> Неопределено Тогда
		Для Каждого Описание Из ОписанияИсточников Цикл
			ЗаписатьИсточник(Описание, Проект);
			Сообщить("Источник записан: " + ТекстЗначения(Описание.Получить("наименование")));
			ЧислоОбъектов = ЧислоОбъектов + 1;
		КонецЦикла;
	КонецЕсли;
	Если ОписанияНастроек <> Неопределено Тогда
		Для Каждого Описание Из ОписанияНастроек Цикл
			ЗаписатьНастройку(Описание, Проект);
			Сообщить("Настройка записана: " + ТекстЗначения(Описание.Получить("наименование")));
			ЧислоОбъектов = ЧислоОбъектов + 1;
		КонецЦикла;
	КонецЕсли;

	Возврат ЧислоОбъектов;

КонецФункции

// Загружает каталог рабочей копии репозитория настроек: сначала sources/*.json, потом settings/*.json.
Функция ЗагрузитьКаталог(Каталог, Проект) Экспорт

	ЧислоОбъектов = 0;
	Для Каждого ИмяПодкаталога Из СтрРазделить(КаталогИсточников() + "," + КаталогНастроек(), ",") Цикл
		Файлы = НайтиФайлы(ОбъединитьПути(Каталог, ИмяПодкаталога), "*.json");
		Для Каждого ПутьКФайлу Из Файлы Цикл
			ЧислоОбъектов = ЧислоОбъектов + ЗагрузитьФайл(ПутьКФайлу, Проект);
		КонецЦикла;
	КонецЦикла;

	Возврат ЧислоОбъектов;

КонецФункции

// Выгружает объекты проекта в каталог в формате репозитория (sources/, settings/).
Функция ВыгрузитьВКаталог(Каталог, Проект) Экспорт

	ЧислоОбъектов = 0;
	Для Каждого Вид Из СтрРазделить(ВидИсточник() + "," + ВидНастройка(), ",") Цикл
		КаталогФайлов = ОбъединитьПути(Каталог, КаталогВида(Вид));
		СоздатьКаталог(КаталогФайлов);
		Для Каждого Наименование Из НаименованияОбъектов(Вид, Проект) Цикл
			ЗаписьФайла = Новый ЗаписьТекста(ОбъединитьПути(КаталогФайлов, ИмяФайла(Наименование)));
			ЗаписьФайла.Открыть();
			ЗаписьФайла.Записать(ТекстФайлаОбъекта(Вид, Наименование, Проект));
			ЗаписьФайла.Закрыть();
			ЧислоОбъектов = ЧислоОбъектов + 1;
		КонецЦикла;
	КонецЦикла;

	Возврат ЧислоОбъектов;

КонецФункции

Функция ОбъединитьПути(Каталог, Имя) Экспорт

	Если СтрЗаканчиваетсяНа(Каталог, "/") Или СтрЗаканчиваетсяНа(Каталог, "\") Тогда
		Возврат Каталог + Имя;
	КонецЕсли;

	Возврат Каталог + "/" + Имя;

КонецФункции

// Имя каталога, в котором лежит файл: для .../settings/имя.json - settings.
Функция ИмяКаталогаФайла(ПутьКФайлу) Экспорт

	Части = СтрРазделить(СтрЗаменить(ПутьКФайлу, "\", "/"), "/");
	Если Части.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Части.Получить(Части.Количество() - 2);

КонецФункции
