// Рабочее место «Сверка данных»: проект и период, список настроек проекта (активизация строки делает настройку
// текущей), сравнение с таблицей результата (эталон и пояснение правятся в таблице и пишутся в настройку),
// расшифровка строки настройкой расшифровки, выгрузка в Excel, правка текущей настройки на вкладке «Настройка».

// @directive=&НаСервере
Процедура ПриОткрытииФормы()
	РабочееМестоСверкиСервер.ПривестиСсылки(Объект);
	Если Не ЗначениеЗаполнено(Объект.Проект) Тогда
		Объект.Проект = РабочееМестоСверкиСервер.ПроектПоУмолчанию();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.НачалоПериода) Тогда
		Объект.НачалоПериода = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(), -1));
		Объект.КонецПериода = КонецМесяца(Объект.НачалоПериода);
	КонецЕсли;
	РабочееМестоСверкиСервер.ЗаполнитьСписки(Объект);
КонецПроцедуры

// @directive=&НаСервере
Процедура ПроектПриИзменении()
	РабочееМестоСверкиСервер.ПривестиСсылки(Объект);
	Объект.Настройка = Неопределено;
	Объект.Запуск = Неопределено;
	Объект.ОтборКлюча = "";
	Объект.Результат.Очистить();
	РабочееМестоСверкиСервер.ЗаполнитьСписки(Объект);
	РабочееМестоСверкиСервер.ЗагрузитьНастройку(Объект);
КонецПроцедуры

// @directive=&НаСервере
Процедура НастройкиПриАктивизацииСтроки()
	РабочееМестоСверкиСервер.ПривестиСсылки(Объект);
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	РабочееМестоСверкиСервер.ВыбратьНастройку(Объект, РабочееМестоСверкиСервер.Ссылка(ТекущаяСтрока.Настройка, "НастройкиСверки", Ложь));
КонецПроцедуры

// @directive=&НаСервере
Процедура СравнитьНажатие()
	РабочееМестоСверкиСервер.ПривестиСсылки(Объект);
	РабочееМестоСверкиСервер.Сравнить(Объект);
КонецПроцедуры

// @directive=&НаСервере
Процедура ОтображениеПриИзменении()
	РабочееМестоСверкиСервер.ПривестиСсылки(Объект);
	РабочееМестоСверкиСервер.ЗаполнитьРезультат(Объект);
КонецПроцедуры

// @directive=&НаСервере
Процедура РезультатПриАктивизацииСтроки()
	РабочееМестоСверкиСервер.ПривестиСсылки(Объект);
	Если ТекущаяСтрока <> Неопределено Тогда
		Объект.ТекущийКлюч = ТекущаяСтрока.Ключ;
	КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура РасшифроватьНажатие()
	РабочееМестоСверкиСервер.ПривестиСсылки(Объект);
	РабочееМестоСверкиСервер.Расшифровать(Объект);
КонецПроцедуры

// @directive=&НаСервере
Процедура НазадНажатие()
	РабочееМестоСверкиСервер.ПривестиСсылки(Объект);
	РабочееМестоСверкиСервер.ВернутьсяКОбщей(Объект);
КонецПроцедуры

// @directive=&НаСервере
Процедура ПояснениеПриИзменении()
	РабочееМестоСверкиСервер.ПривестиСсылки(Объект);
	Если ТекущаяСтрока <> Неопределено Тогда
		РабочееМестоСверкиСервер.ЗаписатьПояснение(Объект, ТекущаяСтрока.Ключ, ТекущаяСтрока.Эталон, ТекущаяСтрока.Пояснение);
	КонецЕсли;
КонецПроцедуры

// @directive=&НаСервере
Процедура ВыгрузитьВExcelНажатие()
	РабочееМестоСверкиСервер.ПривестиСсылки(Объект);
	РабочееМестоСверкиСервер.ВыгрузитьРезультатВExcel(Объект);
КонецПроцедуры

// @directive=&НаСервере
Процедура ЗаписатьНастройкуНажатие()
	РабочееМестоСверкиСервер.ПривестиСсылки(Объект);
	РабочееМестоСверкиСервер.ЗаписатьНастройку(Объект);
КонецПроцедуры

// @directive=&НаСервере
Процедура НоваяНастройкаНажатие()
	РабочееМестоСверкиСервер.ПривестиСсылки(Объект);
	РабочееМестоСверкиСервер.НоваяНастройка(Объект, Ложь);
КонецПроцедуры

// @directive=&НаСервере
Процедура КопироватьНастройкуНажатие()
	РабочееМестоСверкиСервер.ПривестиСсылки(Объект);
	РабочееМестоСверкиСервер.НоваяНастройка(Объект, Истина);
КонецПроцедуры

// @directive=&НаСервере
Процедура НастройкаПриИзменении()
	РабочееМестоСверкиСервер.ПривестиСсылки(Объект);
	Выбранная = Объект.Настройка;
	Объект.Настройка = Неопределено;
	РабочееМестоСверкиСервер.ВыбратьНастройку(Объект, Выбранная);
КонецПроцедуры

// @directive=&НаСервере
Процедура ЗапускПриИзменении()
	РабочееМестоСверкиСервер.ПривестиСсылки(Объект);
	РабочееМестоСверкиСервер.ПоказатьЗапуск(Объект);
КонецПроцедуры
